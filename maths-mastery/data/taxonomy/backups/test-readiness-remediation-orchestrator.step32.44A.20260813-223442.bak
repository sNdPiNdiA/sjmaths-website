/**
 * STEP 32.44
 *
 * End-to-End Readiness Remediation Orchestrator
 * Contract Test
 */

import assert from "assert";


import {
    ReadinessRemediationOrchestrator
} from "./readiness-remediation-orchestrator.js";


import {
    ReadinessDiagnosticBridge
} from "./readiness-diagnostic-bridge.js";


/* ============================================================
   MOCK READINESS PROVIDER
   ============================================================ */

const readinessProvider = {

    ready:
        false,

    getLearningReadinessState(
        targetSkillId
    ) {

        if (
            this.ready
        ) {

            return {

                targetSkillId,

                readiness: {

                    found:
                        true,

                    ready:
                        true,

                    missing: [],

                    remediationPath: []
                },

                interventionPlan: {

                    interventionRequired:
                        false,

                    blocks: []
                }
            };
        }


        return {

            targetSkillId,

            readiness: {

                found:
                    true,

                ready:
                    false,

                missing: [

                    {

                        skillId:
                            "algebra.negative-brackets"
                    }
                ],

                remediationPath: [

                    {

                        skillId:
                            "algebra.negative-brackets"
                    }
                ]
            },

            interventionPlan: {

                interventionRequired:
                    true,

                blocks: [

                    {

                        id:
                            "block-1",

                        skillId:
                            "algebra.negative-brackets",

                        title:
                            "Negative brackets",

                        diagnostic: {

                            questionCount:
                                5
                        }
                    }
                ]
            }
        };
    }
};


/* ============================================================
   MOCK DIAGNOSTIC BRIDGE
   ============================================================ */

const mockBridge = {

    selectDiagnosticQuestions(
        intervention
    ) {

        return {

            interventionSkillId:
                intervention.skillId,

            questionCount:
                5,

            questions: [

                ...Array.from(
                    {
                        length:
                            5
                    },
                    (
                        _,
                        index
                    ) => ({

                        score:
                            100 -
                            index,

                        question: {

                            id:
                                `diag-${index + 1}`,

                            topicId:
                                "algebra",

                            conceptId:
                                "quadratic-factorisation",

                            skillIds: [
                                intervention.skillId
                            ]
                        }
                    })
                )
            ]
        };
    },


    validateDiagnosticSet(
        diagnosticSet
    ) {

        return {

            valid:
                true,

            reason:
                null
        };
    },


    evaluateDiagnosticResults(
        results
    ) {

        const correct =
            results.filter(
                result =>
                    result.result ===
                    "correct"
            ).length;


        const attempted =
            results.length;


        return {

            attempted,

            correct,

            incorrect:
                attempted -
                correct,

            skipped:
                0,

            score:
                attempted
                    ? (
                        correct /
                        attempted
                    ) *
                    100
                    : 0,

            passed:
                correct ===
                attempted
        };
    },


    async recordDiagnosticResult({
        learningPipeline,
        question,
        result
    }) {

        return await learningPipeline
            .recordQuestion({

                studentId:
                    "local",

                topicId:
                    question.topicId,

                questionId:
                    question.id,

                conceptId:
                    question.conceptId,

                skillIds:
                    question.skillIds,

                correct:
                    result ===
                    "correct"
                        ? true
                        : result ===
                            "incorrect"
                            ? false
                            : null,

                timeSpentSeconds:
                    0,

                attemptedAt:
                    null
            });
    }
};


/* ============================================================
   MOCK LEARNING PIPELINE
   ============================================================ */

const recordedAttempts = [];


const learningPipeline = {

    async recordQuestion(
        attempt
    ) {

        recordedAttempts.push(
            attempt
        );


        return {

            progress:
                {},

            mastery:
                {}
        };
    }
};


/* ============================================================
   CREATE ORCHESTRATOR
   ============================================================ */

const orchestrator =
    new ReadinessRemediationOrchestrator({

        readinessProvider,

        learningPipeline,

        diagnosticBridge:
            mockBridge,

        studentId:
            "local",

        diagnosticOptions: {

            questionCount:
                5,

            passScore:
                80,

            minimumCorrect:
                1
        }
    });


console.log("");
console.log("============================================================");
console.log(" STEP 32.44 — ORCHESTRATOR CONTRACT TEST");
console.log("============================================================");
console.log("");

console.log(
    "✓ Orchestrator created"
);


/* ============================================================
   TEST 1 — TARGET
   ============================================================ */

console.log("");
console.log(
    "TEST 1 — Target Selection"
);


let state =
    orchestrator.selectTarget(
        "quadratic.factorisation"
    );


assert.strictEqual(
    state.targetSkillId,
    "quadratic.factorisation"
);


console.log(
    "✓ Target selected"
);


/* ============================================================
   TEST 2 — READINESS
   ============================================================ */

console.log("");
console.log(
    "TEST 2 — Live Readiness"
);


state =
    await orchestrator.checkReadiness();


assert.strictEqual(
    state.state,
    "NOT_READY"
);


console.log(
    "✓ Not-ready state detected"
);


/* ============================================================
   TEST 3 — INTERVENTION
   ============================================================ */

console.log("");
console.log(
    "TEST 3 — Intervention"
);


state =
    await orchestrator.prepareIntervention();


assert.strictEqual(
    state.state,
    "INTERVENTION"
);


assert.strictEqual(
    state.currentIntervention.skillId,
    "algebra.negative-brackets"
);


console.log(
    "✓ Intervention selected"
);


/* ============================================================
   TEST 4 — DIAGNOSTIC
   ============================================================ */

console.log("");
console.log(
    "TEST 4 — Diagnostic Preparation"
);


const diagnostic =
    orchestrator.prepareDiagnostic();


assert.strictEqual(
    diagnostic.diagnosticSet.questionCount,
    5
);


assert.strictEqual(
    diagnostic.state.state,
    "DIAGNOSTIC"
);


console.log(
    "✓ Five diagnostic questions prepared"
);


/* ============================================================
   TEST 5 — RECORD ANSWER
   ============================================================ */

console.log("");
console.log(
    "TEST 5 — Diagnostic Answer"
);


const firstQuestion =
    diagnostic
        .diagnosticSet
        .questions[0]
        .question;


await orchestrator.recordDiagnosticAnswer({

    question:
        firstQuestion,

    result:
        "correct",

    timeSpentSeconds:
        20
});


assert.strictEqual(
    recordedAttempts.length,
    1
);


assert.strictEqual(
    recordedAttempts[0].skillIds[0],
    "algebra.negative-brackets"
);


console.log(
    "✓ Diagnostic answer delegated to learning pipeline"
);


/* ============================================================
   TEST 6 — FULL DIAGNOSTIC
   ============================================================ */

console.log("");
console.log(
    "TEST 6 — Full Diagnostic Session"
);


const answers =
    diagnostic
        .diagnosticSet
        .questions
        .map(
            (
                candidate
            ) => ({

                result:
                    "correct",

                timeSpentSeconds:
                    10
            })
        );


const completed =
    await orchestrator.runDiagnosticSession({

        questions:
            diagnostic
                .diagnosticSet
                .questions,

        answers
    });


assert.strictEqual(
    completed.diagnosticResult.passed,
    true
);


assert.strictEqual(
    completed.readinessState.targetSkillId,
    "quadratic.factorisation"
);


console.log(
    "✓ Full diagnostic executed"
);


/* ============================================================
   TEST 7 — REMEDIATION SUCCESS
   ============================================================ */

console.log("");
console.log(
    "TEST 7 — Return To Target"
);


/*
 * Simulate readiness becoming true after the
 * diagnostic progress has been processed.
 */

readinessProvider.ready =
    true;


const reassessed =
    await orchestrator.checkReadiness();


assert.strictEqual(
    reassessed.state,
    "TARGET_LEARNING"
);


console.log(
    "✓ Learner can return to target"
);


/* ============================================================
   TEST 8 — SNAPSHOT
   ============================================================ */

console.log("");
console.log(
    "TEST 8 — Snapshot"
);


const snapshot =
    orchestrator.snapshot();


assert.strictEqual(
    snapshot.targetSkillId,
    "quadratic.factorisation"
);


assert.ok(
    Array.isArray(
        snapshot.history
    )
);


console.log(
    `✓ Flow history retained: ${snapshot.history.length}`
);


/* ============================================================
   TEST 9 — UNKNOWN TARGET PROTECTION
   ============================================================ */

console.log("");
console.log(
    "TEST 9 — Missing Target Safety"
);


const second =
    new ReadinessRemediationOrchestrator({

        readinessProvider,

        learningPipeline,

        diagnosticBridge:
            mockBridge
    });


assert.throws(
    () => {

        second.checkReadiness();

    }
);


console.log(
    "✓ Missing target protected"
);


/* ============================================================
   SUMMARY
   ============================================================ */

console.log("");
console.log("============================================================");
console.log(" STEP 32.44 PASSED");
console.log("============================================================");
console.log("");

console.log(
    "✓ Target selection"
);

console.log(
    "✓ Live readiness"
);

console.log(
    "✓ Intervention selection"
);

console.log(
    "✓ Diagnostic preparation"
);

console.log(
    "✓ Diagnostic answer delegation"
);

console.log(
    "✓ Full diagnostic session"
);

console.log(
    "✓ Reassessment"
);

console.log(
    "✓ Return-to-target"
);

console.log(
    "✓ Snapshot/history"
);

console.log(
    "✓ Missing-target protection"
);

console.log("");
