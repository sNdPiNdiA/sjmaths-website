/**
 * STEP 32.43A
 *
 * Readiness Diagnostic Bridge Contract Test
 */

import assert from "assert";


import {
    ReadinessDiagnosticBridge
} from "./readiness-diagnostic-bridge.js";


console.log("");
console.log("============================================================");
console.log(" STEP 32.43A — READINESS DIAGNOSTIC BRIDGE TEST");
console.log("============================================================");
console.log("");


/* ============================================================
   MOCK EXISTING QUESTION SELECTOR
   ============================================================ */

const mockSelector = {

    selectQuestions(
        context,
        options
    ) {

        const skillId =
            context.weakSkills[0]
                .skillId;


        const limit =
            options.limit;


        return Array.from(
            {
                length:
                    limit
            },
            (
                _,
                index
            ) => ({

                score:
                    100 -
                    index,

                question: {

                    id:
                        `diagnostic-${index + 1}`,

                    topicId:
                        "algebra",

                    conceptId:
                        "quadratic-factorisation",

                    skillIds: [
                        skillId
                    ],

                    difficulty:
                        index === 0
                            ? "basic"
                            : "intermediate",

                    exams: [
                        "ssc"
                    ]
                }
            })
        );
    },


    selectNextQuestion(
        context
    ) {

        const skillId =
            context.weakSkills[0]
                .skillId;


        return {

            score:
                100,

            reasons: [
                "weak skill"
            ],

            question: {

                id:
                    "diagnostic-next-001",

                topicId:
                    "algebra",

                conceptId:
                    "quadratic-factorisation",

                skillIds: [
                    skillId
                ],

                difficulty:
                    "basic",

                exams: [
                    "ssc"
                ]
            }
        };
    }
};


const bridge =
    new ReadinessDiagnosticBridge({

        questionSelector:
            mockSelector,

        questionCount:
            5
    });


console.log(
    "✓ Bridge created"
);


/* ============================================================
   TEST 1
   ============================================================ */

console.log("");
console.log(
    "TEST 1 — Selection Context"
);


const intervention = {

    skillId:
        "algebra.negative-brackets"
};


const context =
    bridge.buildSelectionContext(
        intervention,
        {
            currentTopicId:
                "algebra",

            examId:
                "ssc",

            currentScore:
                35,

            attemptedQuestionIds: [
                "old-001"
            ]
        }
    );


assert.strictEqual(
    context.currentTopicId,
    "algebra"
);


assert.strictEqual(
    context.examId,
    "ssc"
);


assert.strictEqual(
    context.weakSkills[0].skillId,
    "algebra.negative-brackets"
);


console.log(
    "✓ Selection context verified"
);


/* ============================================================
   TEST 2
   ============================================================ */

console.log("");
console.log(
    "TEST 2 — Targeted Diagnostic Questions"
);


const diagnosticSet =
    bridge.selectDiagnosticQuestions(
        intervention,
        {
            currentTopicId:
                "algebra",

            examId:
                "ssc",

            currentScore:
                30,

            questionCount:
                5
        }
    );


assert.strictEqual(
    diagnosticSet.questionCount,
    5
);


assert.strictEqual(
    diagnosticSet.questions.length,
    5
);


assert.ok(
    diagnosticSet.questions.every(
        candidate =>
            candidate.question &&
            Array.isArray(
                candidate.question.skillIds
            )
    )
);


console.log(
    "✓ Five native selector candidates returned"
);


/* ============================================================
   TEST 3 — TARGET VALIDATION
   ============================================================ */

console.log("");
console.log(
    "TEST 3 — Skill Target Validation"
);


const validation =
    bridge.validateDiagnosticSet(
        diagnosticSet
    );


assert.strictEqual(
    validation.valid,
    true
);


console.log(
    "✓ All candidates target intervention skill"
);


/* ============================================================
   TEST 4 — INVALID QUESTION DETECTED
   ============================================================ */

console.log("");
console.log(
    "TEST 4 — Invalid Diagnostic Set"
);


const invalidSet = {

    interventionSkillId:
        "algebra.negative-brackets",

    questions: [

        {

            score:
                100,

            question: {

                id:
                    "wrong-skill",

                skillIds: [
                    "algebra.common-factor"
                ]
            }
        }
    ]
};


const invalidResult =
    bridge.validateDiagnosticSet(
        invalidSet
    );


assert.strictEqual(
    invalidResult.valid,
    false
);


assert.ok(
    invalidResult.invalidQuestionIds.includes(
        "wrong-skill"
    )
);


console.log(
    "✓ Wrong-skill diagnostic question rejected"
);


/* ============================================================
   TEST 5 — NEXT QUESTION
   ============================================================ */

console.log("");
console.log(
    "TEST 5 — Next Question"
);


const next =
    bridge.selectNextDiagnosticQuestion(
        intervention,
        {
            currentTopicId:
                "algebra",

            examId:
                "ssc"
        }
    );


assert.ok(
    next
);


assert.strictEqual(
    next.question.skillIds.includes(
        "algebra.negative-brackets"
    ),
    true
);


console.log(
    "✓ Next diagnostic question selected"
);


/* ============================================================
   TEST 6 — RESULT EVALUATION
   ============================================================ */

console.log("");
console.log(
    "TEST 6 — Passing Diagnostic"
);


const passing =
    bridge.evaluateDiagnosticResults(

        [
            {
                result:
                    "correct"
            },

            {
                result:
                    "correct"
            },

            {
                result:
                    "correct"
            },

            {
                result:
                    "incorrect"
            },

            {
                result:
                    "correct"
            }
        ],

        {
            passScore:
                80,

            minimumCorrect:
                4
        }
    );


assert.strictEqual(
    passing.attempted,
    5
);


assert.strictEqual(
    passing.correct,
    4
);


assert.strictEqual(
    passing.incorrect,
    1
);


assert.strictEqual(
    passing.score,
    80
);


assert.strictEqual(
    passing.passed,
    true
);


console.log(
    "✓ Passing diagnostic evaluated"
);


/* ============================================================
   TEST 7 — FAILING DIAGNOSTIC
   ============================================================ */

console.log("");
console.log(
    "TEST 7 — Failing Diagnostic"
);


const failing =
    bridge.evaluateDiagnosticResults(

        [
            {
                result:
                    "correct"
            },

            {
                result:
                    "incorrect"
            },

            {
                result:
                    "incorrect"
            },

            {
                result:
                    "incorrect"
            },

            {
                result:
                    "correct"
            }
        ],

        {
            passScore:
                80,

            minimumCorrect:
                4
        }
    );


assert.strictEqual(
    failing.score,
    40
);


assert.strictEqual(
    failing.passed,
    false
);


console.log(
    "✓ Failing diagnostic evaluated"
);


/* ============================================================
   TEST 8 — PROGRESS CONTRACT
   ============================================================ */

console.log("");
console.log(
    "TEST 8 — Existing Progress Contract"
);


const question = {

    id:
        "diagnostic-001",

    topicId:
        "algebra",

    conceptId:
        "quadratic-factorisation",

    skillIds: [
        "algebra.negative-brackets"
    ]
};


const attempt =
    bridge.buildProgressAttempt(
        question,
        "correct",
        {
            studentId:
                "student-1",

            timeSpentSeconds:
                31
        }
    );


assert.strictEqual(
    attempt.studentId,
    "student-1"
);


assert.strictEqual(
    attempt.topicId,
    "algebra"
);


assert.strictEqual(
    attempt.questionId,
    "diagnostic-001"
);


assert.strictEqual(
    attempt.conceptId,
    "quadratic-factorisation"
);


assert.deepStrictEqual(
    attempt.skillIds,
    [
        "algebra.negative-brackets"
    ]
);


assert.strictEqual(
    attempt.correct,
    true
);


assert.strictEqual(
    attempt.timeSpentSeconds,
    31
);


console.log(
    "✓ Existing progress contract preserved"
);


/* ============================================================
   TEST 9 — PIPELINE DELEGATION
   ============================================================ */

console.log("");
console.log(
    "TEST 9 — Existing Learning Pipeline"
);


let received =
    null;


const mockPipeline = {

    async recordQuestion(
        attempt
    ) {

        received =
            attempt;


        return {

            accepted:
                true
        };
    }
};


const pipelineResult =
    await bridge.recordDiagnosticResult({

        learningPipeline:
            mockPipeline,

        question,

        result:
            "correct",

        studentId:
            "student-1",

        timeSpentSeconds:
            20
    });


assert.strictEqual(
    pipelineResult.accepted,
    true
);


assert.ok(
    received
);


assert.strictEqual(
    received.questionId,
    "diagnostic-001"
);


console.log(
    "✓ Progress mutation delegated to existing pipeline"
);


/* ============================================================
   TEST 10 — IMMUTABILITY
   ============================================================ */

console.log("");
console.log(
    "TEST 10 — Input Immutability"
);


const selectorContext = {

    currentTopicId:
        "algebra",

    examId:
        "ssc",

    weakSkills: [
        "algebra.negative-brackets"
    ],

    masteryStatus:
        "learning",

    attemptedQuestionIds: []
};


const before =
    JSON.stringify(
        selectorContext
    );


bridge.selectDiagnosticQuestions(
    intervention,
    selectorContext
);


const after =
    JSON.stringify(
        selectorContext
    );


assert.strictEqual(
    before,
    after
);


console.log(
    "✓ Selection context remains unchanged"
);


/* ============================================================
   SUMMARY
   ============================================================ */

console.log("");
console.log("============================================================");
console.log(" STEP 32.43A PASSED");
console.log("============================================================");
console.log("");

console.log(
    "✓ Native question-candidate shape supported"
);

console.log(
    "✓ Skill-target validation corrected"
);

console.log(
    "✓ Wrong-skill candidates rejected"
);

console.log(
    "✓ Targeted question selection verified"
);

console.log(
    "✓ Diagnostic scoring verified"
);

console.log(
    "✓ Existing progress contract preserved"
);

console.log(
    "✓ Existing pipeline delegation verified"
);

console.log(
    "✓ Input immutability verified"
);

console.log("");
