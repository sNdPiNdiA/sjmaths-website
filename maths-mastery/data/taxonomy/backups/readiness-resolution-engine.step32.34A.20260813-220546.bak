/**
 * SJMaths Maths Mastery
 *
 * STEP 32.34
 * Readiness Resolution Engine
 *
 * Purpose:
 *   Determine which foundational readiness skills are missing
 *   before a learner attempts a canonical target skill.
 *
 * Read-only.
 */

import fs from "fs";
import path from "path";


function safeArray(value) {

    return Array.isArray(value)
        ? value
        : [];
}


export class ReadinessResolutionEngine {

    constructor({
        readinessTaxonomy,
        readinessGraph,
        readinessTargets
    } = {}) {

        if (!readinessTaxonomy) {

            throw new Error(
                "ReadinessResolutionEngine: readinessTaxonomy is required."
            );
        }


        if (!readinessGraph) {

            throw new Error(
                "ReadinessResolutionEngine: readinessGraph is required."
            );
        }


        if (!readinessTargets) {

            throw new Error(
                "ReadinessResolutionEngine: readinessTargets is required."
            );
        }


        this.taxonomy =
            readinessTaxonomy;

        this.graph =
            readinessGraph;

        this.targets =
            readinessTargets;


        this.skillById =
            new Map(
                safeArray(
                    this.taxonomy.skills
                ).map(
                    skill => [
                        skill.id,
                        skill
                    ]
                )
            );


        this.targetById =
            new Map(
                safeArray(
                    this.targets.targets
                ).map(
                    target => [
                        target.targetSkillId,
                        target
                    ]
                )
            );


        this.adjacency =
            this.buildAdjacency(
                this.graph.edges
            );
    }


    buildAdjacency(edges) {

        const adjacency =
            new Map();


        for (
            const edge
            of safeArray(edges)
        ) {

            if (
                !adjacency.has(
                    edge.to
                )
            ) {

                adjacency.set(
                    edge.to,
                    []
                );
            }


            adjacency
                .get(edge.to)
                .push(edge);
        }


        return adjacency;
    }


    getTarget(
        targetSkillId
    ) {

        return (
            this.targetById.get(
                targetSkillId
            ) ||
            null
        );
    }


    getDirectRequirements(
        targetSkillId
    ) {

        const target =
            this.getTarget(
                targetSkillId
            );


        if (!target) {

            return [];
        }


        return safeArray(
            target.readiness
        );
    }


    getPrerequisiteAncestors(
        readinessSkillId
    ) {

        const result = [];
        const visited = new Set();


        const visit = (
            skillId,
            depth
        ) => {

            if (
                visited.has(
                    skillId
                )
            ) {

                return;
            }


            visited.add(
                skillId
            );


            result.push({
                skillId,
                depth
            });


            const incoming =
                this.adjacency.get(
                    skillId
                ) ||
                [];


            for (
                const edge
                of incoming
            ) {

                if (
                    edge.relation !==
                    "required-before"
                ) {

                    continue;
                }


                visit(
                    edge.from,
                    depth + 1
                );
            }
        };


        const incoming =
            this.adjacency.get(
                readinessSkillId
            ) ||
            [];


        for (
            const edge
            of incoming
        ) {

            if (
                edge.relation !==
                "required-before"
            ) {

                continue;
            }


            visit(
                edge.from,
                1
            );
        }


        return result;
    }


    buildRequirementSet(
        targetSkillId
    ) {

        const target =
            this.getTarget(
                targetSkillId
            );


        if (!target) {

            return {
                targetSkillId,
                found: false,
                requirements: []
            };
        }


        const requirementMap =
            new Map();


        for (
            const requirement
            of safeArray(
                target.readiness
            )
        ) {

            const id =
                requirement.skillId;


            if (
                !this.skillById.has(
                    id
                )
            ) {

                throw new Error(
                    `Unknown readiness skill: ${id}`
                );
            }


            if (
                !requirementMap.has(
                    id
                )
            ) {

                requirementMap.set(
                    id,
                    {
                        skillId: id,
                        requirement:
                            requirement.requirement,
                        direct: true,
                        depth: 0
                    }
                );
            }


            const ancestors =
                this.getPrerequisiteAncestors(
                    id
                );


            for (
                const ancestor
                of ancestors
            ) {

                if (
                    !this.skillById.has(
                        ancestor.skillId
                    )
                ) {

                    throw new Error(
                        `Unknown readiness skill: ${ancestor.skillId}`
                    );
                }


                const existing =
                    requirementMap.get(
                        ancestor.skillId
                    );


                if (
                    !existing ||
                    ancestor.depth >
                        existing.depth
                ) {

                    requirementMap.set(
                        ancestor.skillId,
                        {
                            skillId:
                                ancestor.skillId,
                            requirement:
                                "prerequisite",
                            direct: false,
                            depth:
                                ancestor.depth
                        }
                    );
                }
            }
        }


        return {
            targetSkillId,
            found: true,
            requirements:
                Array.from(
                    requirementMap.values()
                )
        };
    }


    resolve(
        targetSkillId,
        learnerEvidence = {}
    ) {

        const requirementSet =
            this.buildRequirementSet(
                targetSkillId
            );


        if (!requirementSet.found) {

            return {

                targetSkillId,

                found: false,

                ready: false,

                missing: [],

                remediationPath: [],

                explanation:
                    "No readiness target mapping exists."
            };
        }


        const missing = [];


        for (
            const requirement
            of requirementSet.requirements
        ) {

            const evidence =
                learnerEvidence[
                    requirement.skillId
                ] ||
                {};


            const status =
                this.normalizeEvidenceStatus(
                    evidence
                );


            if (
                !this.isSatisfied(
                    status
                )
            ) {

                const skill =
                    this.skillById.get(
                        requirement.skillId
                    );


                missing.push({

                    skillId:
                        requirement.skillId,

                    name:
                        skill?.name ||
                        requirement.skillId,

                    level:
                        skill?.level ||
                        null,

                    requirement:
                        requirement.requirement,

                    direct:
                        requirement.direct,

                    depth:
                        requirement.depth,

                    evidence:
                        status
                });
            }
        }


        const remediationPath =
            this.buildRemediationPath(
                missing
            );


        return {

            targetSkillId,

            found: true,

            ready:
                missing.length === 0,

            missing,

            remediationPath,

            explanation:
                missing.length === 0
                    ? "Learner has sufficient readiness evidence."
                    : "Learner has one or more unresolved readiness gaps."
        };
    }


    normalizeEvidenceStatus(
        evidence = {}
    ) {

        if (
            evidence.mastered === true
        ) {

            return {
                mastered: true,
                score:
                    Number(
                        evidence.score ??
                        100
                    ),
                attempts:
                    Number(
                        evidence.attempts ??
                        0
                    )
            };
        }


        if (
            typeof evidence.score ===
            "number"
        ) {

            return {

                mastered:
                    evidence.score >=
                    80,

                score:
                    evidence.score,

                attempts:
                    Number(
                        evidence.attempts ??
                        0
                    )
            };
        }


        return {

            mastered: false,

            score:
                Number(
                    evidence.score ??
                    0
                ),

            attempts:
                Number(
                    evidence.attempts ??
                    0
                )
        };
    }


    isSatisfied(
        status
    ) {

        return (
            status.mastered === true
        );
    }


    buildRemediationPath(
        missing
    ) {

        const sorted =
            [...missing].sort(
                (
                    a,
                    b
                ) => {

                    /*
                     * Deeper prerequisites first.
                     * Then direct requirements.
                     * Then name for deterministic ordering.
                     */

                    if (
                        a.depth !==
                        b.depth
                    ) {

                        return (
                            b.depth -
                            a.depth
                        );
                    }


                    if (
                        a.direct !==
                        b.direct
                    ) {

                        return a.direct
                            ? 1
                            : -1;
                    }


                    return String(
                        a.name
                    ).localeCompare(
                        String(
                            b.name
                        )
                    );
                }
            );


        /*
         * Remove duplicates while retaining deterministic order.
         */

        const seen =
            new Set();


        const path = [];


        for (
            const item
            of sorted
        ) {

            if (
                seen.has(
                    item.skillId
                )
            ) {

                continue;
            }


            seen.add(
                item.skillId
            );


            path.push({

                step:
                    path.length + 1,

                skillId:
                    item.skillId,

                name:
                    item.name,

                level:
                    item.level,

                requirement:
                    item.requirement,

                direct:
                    item.direct,

                depth:
                    item.depth
            });
        }


        return path;
    }


    explain(
        targetSkillId,
        learnerEvidence = {}
    ) {

        const result =
            this.resolve(
                targetSkillId,
                learnerEvidence
            );


        if (
            !result.found
        ) {

            return [
                "No readiness mapping found."
            ];
        }


        if (
            result.ready
        ) {

            return [
                "Learner is ready for the target skill."
            ];
        }


        return [
            `Target: ${targetSkillId}`,
            `Missing readiness skills: ${result.missing.length}`,
            ...result.remediationPath.map(
                item =>
                    `${item.step}. ${item.name}`
            )
        ];
    }

}


/**
 * Load readiness files directly from the Maths Mastery
 * project structure.
 */
export function loadReadinessResolutionEngine(
    rootDir
) {

    const root =
        rootDir ||
        path.resolve(
            process.cwd(),
            "maths-mastery"
        );


    const taxonomy =
        JSON.parse(
            fs.readFileSync(
                path.join(
                    root,
                    "data",
                    "taxonomy",
                    "readiness-taxonomy.json"
                ),
                "utf8"
            )
        );


    const graph =
        JSON.parse(
            fs.readFileSync(
                path.join(
                    root,
                    "data",
                    "taxonomy",
                    "readiness-graph.json"
                ),
                "utf8"
            )
        );


    const targets =
        JSON.parse(
            fs.readFileSync(
                path.join(
                    root,
                    "data",
                    "taxonomy",
                    "readiness-targets.json"
                ),
                "utf8"
            )
        );


    return new ReadinessResolutionEngine({
        readinessTaxonomy:
            taxonomy,

        readinessGraph:
            graph,

        readinessTargets:
            targets
    });
}
