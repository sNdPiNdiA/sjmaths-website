/**
 * STEP 32.49
 *
 * Real Readiness Question Bank Integration Test
 *
 * READ-ONLY
 */

import fs from "fs";


import {
    ReadinessQuestionGenerator
} from "./readiness-question-generator.js";


import {
    ReadinessDiagnosticBridge
} from "./readiness-diagnostic-bridge.js";


const bankFile =
    process.argv[2];


if (!bankFile) {

    throw new Error(
        "Bank file path is required."
    );
}


function readJson(
    file
) {

    const raw =
        fs.readFileSync(
            file,
            "utf8"
        );


    /*
     * Windows PowerShell 5.1 UTF-8 BOM safety.
     */

    return JSON.parse(
        raw.replace(
            /^\uFEFF/,
            ""
        )
    );
}


console.log("");
console.log("============================================================");
console.log(" STEP 32.49 — REAL READINESS BANK TEST");
console.log("============================================================");
console.log("");


/* ============================================================
   TEST 1 — LOAD REAL BANK
   ============================================================ */

console.log(
    "TEST 1 — Real Generated Bank"
);


const bank =
    readJson(
        bankFile
    );


assertBankShape(bank);


function assertBankShape(
    payload
) {

    if (
        !payload ||
        typeof payload !==
        "object"
    ) {

        throw new Error(
            "Bank root must be an object."
        );
    }


    if (
        typeof payload.readinessSkillId !==
        "string"
    ) {

        throw new Error(
            "readinessSkillId is missing."
        );
    }


    if (
        !Array.isArray(
            payload.questions
        )
    ) {

        throw new Error(
            "questions must be an array."
        );
    }
}


console.log(
    `✓ Bank loaded: ${bank.readinessSkillId}`
);


console.log(
    `✓ Questions: ${bank.questions.length}`
);


/* ============================================================
   TEST 2 — REAL GENERATOR VALIDATION
   ============================================================ */

console.log("");
console.log(
    "TEST 2 — Generator Validation"
);


const generator =
    new ReadinessQuestionGenerator({

        minimumPoolSize:
            10,

        recommendedPoolSize:
            15,

        diagnosticSelectionCount:
            5
    });


const poolValidation =
    generator.validatePool(
        bank.questions,
        bank.readinessSkillId
    );


if (
    !poolValidation.valid
) {

    throw new Error(
        [
            `Readiness bank invalid: ${bank.readinessSkillId}`,
            ...poolValidation.errors
        ].join(
            "\n"
        )
    );
}


assert.strictEqual(
    poolValidation.exactSkillCount,
    bank.questions.length
);


assert.strictEqual(
    poolValidation.exactSkillCount >=
    10,
    true
);


console.log(
    "✓ Real bank passes generator contract"
);


/* ============================================================
   TEST 3 — EXACT SKILL IN EVERY QUESTION
   ============================================================ */

console.log("");
console.log(
    "TEST 3 — Exact Skill Mapping"
);


for (
    const question
    of bank.questions
) {

    assert.strictEqual(
        question.readinessSkillId,
        bank.readinessSkillId
    );


    assert.ok(
        question.skillIds.includes(
            bank.readinessSkillId
        )
    );
}


console.log(
    "✓ Every real question maps to the exact readiness skill"
);


/* ============================================================
   TEST 4 — DIAGNOSTIC BRIDGE
   ============================================================ */

console.log("");
console.log(
    "TEST 4 — Diagnostic Bridge"
);


/*
 * Simulate the existing selector contract using the REAL
 * generated question records.
 *
 * The bridge still performs the exact same validation used
 * by production.
 */

const bankSelector = {

    selectQuestions(
        context,
        options = {}
    ) {

        const limit =
            Number(
                options.limit ??
                5
            );


        return bank.questions
            .slice(
                0,
                limit
            )
            .map(
                (
                    question,
                    index
                ) => ({

                    score:
                        100 -
                        index,

                    question
                })
            );
    },


    selectNextQuestion(
        context
    ) {

        const question =
            bank.questions[0];


        return {

            score:
                100,

            reasons: [
                "real readiness bank"
            ],

            question
        };
    }
};


const bridge =
    new ReadinessDiagnosticBridge({

        questionSelector:
            bankSelector,

        questionCount:
            5
    });


const intervention = {

    skillId:
        bank.readinessSkillId
};


const diagnosticSet =
    bridge.selectDiagnosticQuestions(
        intervention,
        {

            currentTopicId:
                null,

            examId:
                null,

            questionCount:
                5
        }
    );


assert.strictEqual(
    diagnosticSet.questions.length,
    5
);


console.log(
    "✓ Five real bank questions selected"
);


/* ============================================================
   TEST 5 — BRIDGE VALIDATION
   ============================================================ */

console.log("");
console.log(
    "TEST 5 — Exact Skill Bridge Validation"
);


const validation =
    bridge.validateDiagnosticSet(
        diagnosticSet
    );


assert.strictEqual(
    validation.valid,
    true
);


console.log(
    "✓ Real generated questions accepted by diagnostic bridge"
);


/* ============================================================
   TEST 6 — REAL DIAGNOSTIC RESULT
   ============================================================ */

console.log("");
console.log(
    "TEST 6 — Diagnostic Result"
);


const results = [

    {
        result:
            "correct"
    },

    {
        result:
            "correct"
    },

    {
        result:
            "correct"
    },

    {
        result:
            "incorrect"
    },

    {
        result:
            "correct"
    }
];


const diagnosticResult =
    bridge.evaluateDiagnosticResults(
        results,
        {

            passScore:
                80,

            minimumCorrect:
                1
        }
    );


assert.strictEqual(
    diagnosticResult.attempted,
    5
);


assert.strictEqual(
    diagnosticResult.correct,
    4
);


assert.strictEqual(
    diagnosticResult.incorrect,
    1
);


assert.strictEqual(
    diagnosticResult.score,
    80
);


assert.strictEqual(
    diagnosticResult.passed,
    true
);


console.log(
    "✓ Real diagnostic scoring works"
);


/* ============================================================
   TEST 7 — REAL QUESTION → PROGRESS CONTRACT
   ============================================================ */

console.log("");
console.log(
    "TEST 7 — Question → Progress Contract"
);


const realQuestion =
    bank.questions[0];


const progressAttempt =
    bridge.buildProgressAttempt(
        realQuestion,
        "correct",
        {

            studentId:
                "readonly-test",

            timeSpentSeconds:
                18
        }
    );


assert.strictEqual(
    progressAttempt.questionId,
    realQuestion.id
);


assert.strictEqual(
    progressAttempt.topicId,
    realQuestion.topicId
);


assert.strictEqual(
    progressAttempt.conceptId,
    realQuestion.conceptId
);


assert.ok(
    progressAttempt.skillIds.includes(
        bank.readinessSkillId
    )
);


assert.strictEqual(
    progressAttempt.correct,
    true
);


console.log(
    "✓ Real question matches existing progress contract"
);


/* ============================================================
   TEST 8 — WRONG SKILL PROTECTION
   ============================================================ */

console.log("");
console.log(
    "TEST 8 — Wrong Skill Protection"
);


const mutatedQuestion = {

    ...realQuestion,

    skillIds: [
        "unrelated.skill"
    ],

    readinessSkillId:
        "unrelated.skill"
};


const invalidSet = {

    interventionSkillId:
        bank.readinessSkillId,

    questions: [

        {

            question:
                mutatedQuestion
        }
    ]
};


const invalid =
    bridge.validateDiagnosticSet(
        invalidSet
    );


assert.strictEqual(
    invalid.valid,
    false
);


console.log(
    "✓ Wrong-skill substitution rejected"
);


/* ============================================================
   TEST 9 — NO QUESTION MUTATION
   ============================================================ */

console.log("");
console.log(
    "TEST 9 — Bank Immutability"
);


const before =
    JSON.stringify(
        bank
    );


bridge.selectDiagnosticQuestions(
    intervention,
    {
        questionCount:
            5
    }
);


bridge.validateDiagnosticSet(
    diagnosticSet
);


const after =
    JSON.stringify(
        bank
    );


assert.strictEqual(
    before,
    after
);


console.log(
    "✓ Generated bank remained unchanged"
);


/* ============================================================
   SUMMARY
   ============================================================ */

console.log("");
console.log("============================================================");
console.log(" STEP 32.49 PASSED");
console.log("============================================================");
console.log("");

console.log(
    `✓ Real bank: ${bank.readinessSkillId}`
);

console.log(
    `✓ Real questions: ${bank.questions.length}`
);

console.log(
    "✓ Generator contract"
);

console.log(
    "✓ Exact skill mapping"
);

console.log(
    "✓ Diagnostic bridge"
);

console.log(
    "✓ Diagnostic scoring"
);

console.log(
    "✓ Existing progress contract"
);

console.log(
    "✓ Wrong-skill protection"
);

console.log(
    "✓ Bank immutability"
);

console.log("");
