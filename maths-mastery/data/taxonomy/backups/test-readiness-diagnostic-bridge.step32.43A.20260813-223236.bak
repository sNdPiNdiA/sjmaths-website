/**
 * STEP 32.43
 * Readiness Diagnostic Bridge Contract Test
 */


import assert from "assert";


import {
    ReadinessDiagnosticBridge
} from "./readiness-diagnostic-bridge.js";


console.log("");
console.log("============================================================");
console.log(" STEP 32.43 — READINESS DIAGNOSTIC BRIDGE TEST");
console.log("============================================================");
console.log("");


/* ============================================================
   MOCK EXISTING QUESTION SELECTOR
   ============================================================ */

const mockSelector = {

    selectQuestions(
        context,
        options
    ) {

        const skillId =
            context.weakSkills[0]
                .skillId;


        const limit =
            options.limit;


        return Array.from(
            {
                length:
                    limit
            },
            (
                _,
                index
            ) => ({

                score:
                    100 -
                    index,

                question: {

                    id:
                        `diagnostic-${index + 1}`,

                    topicId:
                        "algebra",

                    conceptId:
                        "quadratic-factorisation",

                    skillIds: [
                        skillId
                    ],

                    difficulty:
                        index === 0
                            ? "basic"
                            : "intermediate",

                    exams: [
                        "ssc"
                    ]
                }
            })
        );
    },


    selectNextQuestion(
        context
    ) {

        const skillId =
            context.weakSkills[0]
                .skillId;


        return {

            score:
                100,

            reasons: [
                "weak skill"
            ],

            question: {

                id:
                    "diagnostic-next-001",

                topicId:
                    "algebra",

                conceptId:
                    "quadratic-factorisation",

                skillIds: [
                    skillId
                ],

                difficulty:
                    "basic",

                exams: [
                    "ssc"
                ]
            }
        };
    }
};


const bridge =
    new ReadinessDiagnosticBridge({

        questionSelector:
            mockSelector,

        questionCount:
            5
    });


console.log(
    "✓ Bridge created"
);


/* ============================================================
   TEST 1 — SELECTION CONTEXT
   ============================================================ */

console.log("");
console.log(
    "TEST 1 — Selection Context"
);


const intervention = {

    skillId:
        "algebra.negative-brackets"
};


const context =
    bridge.buildSelectionContext(
        intervention,
        {
            currentTopicId:
                "algebra",

            examId:
                "ssc",

            currentScore:
                35,

            attemptedQuestionIds: [
                "old-001"
            ]
        }
    );


assert.strictEqual(
    context.currentTopicId,
    "algebra"
);


assert.strictEqual(
    context.examId,
    "ssc"
);


assert.strictEqual(
    context.weakSkills[0].skillId,
    "algebra.negative-brackets"
);


assert.strictEqual(
    context.weakSkills[0].score,
    35
);


console.log(
    "✓ Intervention converted to existing selector context"
);


/* ============================================================
   TEST 2 — TARGETED QUESTIONS
   ============================================================ */

console.log("");
console.log(
    "TEST 2 — Targeted Diagnostic Questions"
);


const diagnosticSet =
    bridge.selectDiagnosticQuestions(
        intervention,
        {
            currentTopicId:
                "algebra",

            examId:
                "ssc",

            currentScore:
                30,

            questionCount:
                5
        }
    );


assert.strictEqual(
    diagnosticSet.questionCount,
    5
);


assert.strictEqual(
    diagnosticSet.questions.length,
    5
);


console.log(
    "✓ Existing selector requested 5 targeted questions"
);


/* ============================================================
   TEST 3 — DIAGNOSTIC TARGET VALIDATION
   ============================================================ */

console.log("");
console.log(
    "TEST 3 — Skill Target Validation"
);


const validation =
    bridge.validateDiagnosticSet(
        diagnosticSet
    );


assert.strictEqual(
    validation.valid,
    true
);


console.log(
    "✓ All diagnostic questions target intervention skill"
);


/* ============================================================
   TEST 4 — NEXT QUESTION
   ============================================================ */

console.log("");
console.log(
    "TEST 4 — Next Question"
);


const next =
    bridge.selectNextDiagnosticQuestion(
        intervention,
        {
            currentTopicId:
                "algebra",

            examId:
                "ssc"
        }
    );


assert.ok(
    next
);


assert.strictEqual(
    next.question.skillIds.includes(
        "algebra.negative-brackets"
    ),
    true
);


console.log(
    "✓ Next diagnostic question selected"
);


/* ============================================================
   TEST 5 — RESULT EVALUATION
   ============================================================ */

console.log("");
console.log(
    "TEST 5 — Diagnostic Result"
);


const result =
    bridge.evaluateDiagnosticResults(

        [
            {
                result:
                    "correct"
            },

            {
                result:
                    "correct"
            },

            {
                result:
                    "correct"
            },

            {
                result:
                    "incorrect"
            },

            {
                result:
                    "correct"
            }
        ],

        {
            passScore:
                80,

            minimumCorrect:
                4
        }
    );


assert.strictEqual(
    result.attempted,
    5
);


assert.strictEqual(
    result.correct,
    4
);


assert.strictEqual(
    result.incorrect,
    1
);


assert.strictEqual(
    result.score,
    80
);


assert.strictEqual(
    result.passed,
    true
);


console.log(
    "✓ Diagnostic result evaluated correctly"
);


/* ============================================================
   TEST 6 — FAILING DIAGNOSTIC
   ============================================================ */

console.log("");
console.log(
    "TEST 6 — Failing Diagnostic"
);


const failed =
    bridge.evaluateDiagnosticResults(

        [
            {
                result:
                    "correct"
            },

            {
                result:
                    "incorrect"
            },

            {
                result:
                    "incorrect"
            },

            {
                result:
                    "incorrect"
            },

            {
                result:
                    "correct"
            }
        ],

        {
            passScore:
                80,

            minimumCorrect:
                4
        }
    );


assert.strictEqual(
    failed.score,
    40
);


assert.strictEqual(
    failed.passed,
    false
);


console.log(
    "✓ Failed diagnostic remains unresolved"
);


/* ============================================================
   TEST 7 — PROGRESS ATTEMPT
   ============================================================ */

console.log("");
console.log(
    "TEST 7 — Existing Progress Contract"
);


const question = {

    id:
        "diagnostic-001",

    topicId:
        "algebra",

    conceptId:
        "quadratic-factorisation",

    skillIds: [
        "algebra.negative-brackets"
    ]
};


const attempt =
    bridge.buildProgressAttempt(
        question,
        "correct",
        {
            studentId:
                "student-1",

            timeSpentSeconds:
                31
        }
    );


assert.strictEqual(
    attempt.studentId,
    "student-1"
);


assert.strictEqual(
    attempt.topicId,
    "algebra"
);


assert.strictEqual(
    attempt.questionId,
    "diagnostic-001"
);


assert.strictEqual(
    attempt.conceptId,
    "quadratic-factorisation"
);


assert.strictEqual(
    attempt.skillIds[0],
    "algebra.negative-brackets"
);


assert.strictEqual(
    attempt.correct,
    true
);


assert.strictEqual(
    attempt.timeSpentSeconds,
    31
);


console.log(
    "✓ Existing learning-pipeline contract preserved"
);


/* ============================================================
   TEST 8 — SKIPPED
   ============================================================ */

console.log("");
console.log(
    "TEST 8 — Skipped Attempt"
);


const skipped =
    bridge.buildProgressAttempt(
        question,
        "skipped"
    );


assert.strictEqual(
    skipped.correct,
    null
);


console.log(
    "✓ Skipped attempt preserved"
);


/* ============================================================
   TEST 9 — LEARNING PIPELINE DELEGATION
   ============================================================ */

console.log("");
console.log(
    "TEST 9 — Pipeline Delegation"
);


let received =
    null;


const mockPipeline = {

    async recordQuestion(
        attempt
    ) {

        received =
            attempt;


        return {

            accepted:
                true
        };
    }
};


const pipelineResult =
    await bridge.recordDiagnosticResult({

        learningPipeline:
            mockPipeline,

        question,

        result:
            "correct",

        studentId:
            "student-1",

        timeSpentSeconds:
            20
    });


assert.strictEqual(
    pipelineResult.accepted,
    true
);


assert.ok(
    received
);


assert.strictEqual(
    received.questionId,
    "diagnostic-001"
);


assert.strictEqual(
    received.correct,
    true
);


console.log(
    "✓ Progress mutation delegated to existing pipeline"
);


/* ============================================================
   TEST 10 — READ-ONLY SELECTION
   ============================================================ */

console.log("");
console.log(
    "TEST 10 — Selection Context Immutability"
);


const selectionContext = {

    currentTopicId:
        "algebra",

    examId:
        "ssc",

    weakSkills: [
        "algebra.negative-brackets"
    ],

    masteryStatus:
        "learning",

    attemptedQuestionIds: []
};


const before =
    JSON.stringify(
        selectionContext
    );


bridge.selectDiagnosticQuestions(
    intervention,
    selectionContext
);


const after =
    JSON.stringify(
        selectionContext
    );


assert.strictEqual(
    before,
    after
);


console.log(
    "✓ Selector bridge does not mutate input context"
);


/* ============================================================
   SUMMARY
   ============================================================ */

console.log("");
console.log("============================================================");
console.log(" STEP 32.43 PASSED");
console.log("============================================================");
console.log("");

console.log(
    "✓ Intervention-to-selector context verified"
);

console.log(
    "✓ Targeted diagnostic selection verified"
);

console.log(
    "✓ Skill targeting verified"
);

console.log(
    "✓ Next-question selection verified"
);

console.log(
    "✓ Diagnostic result evaluation verified"
);

console.log(
    "✓ Pass/fail threshold verified"
);

console.log(
    "✓ Existing progress contract preserved"
);

console.log(
    "✓ Skipped result preserved"
);

console.log(
    "✓ Existing learning pipeline delegation verified"
);

console.log(
    "✓ Input immutability verified"
);

console.log("");
