{
  "entities": {
    "percentage-reverse-001": {
      "id": "percentage-reverse-001",
      "source": "percentage\\percentage-reverse-001.json",
      "data": {
        "id": "percentage-reverse-001",
        "version": "1.0.0",
        "topicId": "percentage",
        "conceptId": "reverse-percentage",
        "skillIds": [
          "reverse-percentage"
        ],
        "questionType": "mcq",
        "difficulty": "intermediate",
        "exams": [
          "ssc",
          "banking",
          "railway"
        ],
        "question": {
          "text": "A number is increased by 20% and becomes 240. What was the original number?",
          "language": "en"
        },
        "options": [
          {
            "id": "a",
            "text": "180"
          },
          {
            "id": "b",
            "text": "200"
          },
          {
            "id": "c",
            "text": "220"
          },
          {
            "id": "d",
            "text": "288"
          }
        ],
        "answer": {
          "type": "option",
          "value": "b"
        },
        "solution": {
          "steps": [
            {
              "step": 1,
              "text": "After a 20% increase, the final value is 120% of the original number."
            },
            {
              "step": 2,
              "text": "Therefore, 120% of the original number equals 240."
            },
            {
              "step": 3,
              "text": "Original number = 240 ÷ 1.20 = 200."
            }
          ],
          "finalAnswer": "200"
        },
        "hints": [
          "The final value represents 120% of the original.",
          "Divide the final value by 1.20."
        ],
        "metadata": {
          "source": "SJMaths Prototype",
          "sourceYear": null,
          "authoringStatus": "verified",
          "tags": [
            "reverse-percentage",
            "original-value",
            "percentage-increase"
          ]
        }
      }
    },
    "percentage-reverse-002": {
      "id": "percentage-reverse-002",
      "source": "percentage\\percentage-reverse-002.json",
      "data": {
        "id": "percentage-reverse-002",
        "version": "1.0.0",
        "topicId": "percentage",
        "conceptId": "reverse-percentage",
        "skillIds": [
          "reverse-percentage"
        ],
        "questionType": "mcq",
        "difficulty": "basic",
        "exams": [
          "ssc",
          "banking",
          "railway"
        ],
        "question": {
          "text": "A number is decreased by 20% and becomes 160. What was the original number?",
          "language": "en"
        },
        "options": [
          {
            "id": "a",
            "text": "180"
          },
          {
            "id": "b",
            "text": "200"
          },
          {
            "id": "c",
            "text": "220"
          },
          {
            "id": "d",
            "text": "240"
          }
        ],
        "answer": {
          "type": "option",
          "value": "b"
        },
        "solution": {
          "steps": [
            {
              "step": 1,
              "text": "After a 20% decrease, the final value is 80% of the original number."
            },
            {
              "step": 2,
              "text": "Therefore, 80% of the original number equals 160."
            },
            {
              "step": 3,
              "text": "Original number = 160 ÷ 0.80 = 200."
            }
          ],
          "finalAnswer": "200"
        },
        "hints": [
          "After a 20% decrease, 80% of the original remains.",
          "Divide the final value by 0.80."
        ],
        "metadata": {
          "source": "SJMaths Prototype",
          "sourceYear": null,
          "authoringStatus": "verified",
          "tags": [
            "reverse-percentage",
            "original-value",
            "percentage-decrease"
          ]
        }
      }
