/**
 * SJMaths Maths Mastery
 *
 * STEP 32.44
 *
 * End-to-End Readiness Remediation Orchestrator
 *
 * Coordinates already-existing components:
 *
 *   Live Readiness
 *        ↓
 *   Intervention Planner
 *        ↓
 *   Diagnostic Bridge
 *        ↓
 *   Existing Learning Pipeline
 *        ↓
 *   Live Readiness Reassessment
 *
 * This class does NOT implement:
 *
 *   - mastery calculation
 *   - question selection
 *   - progress mutation
 *   - readiness graph traversal
 *
 * Those responsibilities remain in their existing engines.
 */


import {
    ReadinessRemediationFlow
} from "./readiness-remediation-flow.js";


import {
    ReadinessDiagnosticBridge
} from "./readiness-diagnostic-bridge.js";


export class ReadinessRemediationOrchestrator {

    constructor(
        options = {}
    ) {

        if (
            !options.readinessProvider
        ) {

            throw new Error(
                "ReadinessRemediationOrchestrator: readinessProvider is required."
            );
        }


        if (
            !options.learningPipeline
        ) {

            throw new Error(
                "ReadinessRemediationOrchestrator: learningPipeline is required."
            );
        }


        this.readinessProvider =
            options.readinessProvider;


        this.learningPipeline =
            options.learningPipeline;


        this.diagnosticBridge =
            options.diagnosticBridge ||
            new ReadinessDiagnosticBridge(
                options.diagnosticOptions
            );


        this.flow =
            options.flow ||
            new ReadinessRemediationFlow(
                options.flowOptions
            );


        this.studentId =
            options.studentId ||
            "local";


        this.selectionOptions =
            options.selectionOptions || {};


        this.diagnosticOptions =
            options.diagnosticOptions || {

                questionCount:
                    5,

                passScore:
                    80,

                minimumCorrect:
                    1
            };
    }


    selectTarget(
        targetSkillId
    ) {

        return this.flow.selectTarget(
            targetSkillId
        );
    }


    async checkReadiness() {

        this.flow.beginReadinessCheck();


        const readinessState =
            await this.getCurrentReadiness();


        return this.flow.applyReadinessState(
            readinessState
        );
    }


    async getCurrentReadiness() {

        return await this.readinessProvider
            .getLearningReadinessState(
                this.flow.targetSkillId
            );
    }


    async prepareIntervention() {

        /*
         * The current readiness state already contains the
         * intervention plan generated by the existing planner.
         */

        const readinessState =
            this.readiness ||
            await this.getCurrentReadiness();


        const plan =
            readinessState.interventionPlan;


        if (
            !plan
        ) {

            return this.flow.snapshot();
        }


        return this.flow.applyInterventionPlan(
            plan
        );
    }


    prepareDiagnostic(
        intervention = null,
        options = {}
    ) {

        const selectedIntervention =
            intervention ||
            this.flow.getCurrentIntervention();


        if (
            !selectedIntervention
        ) {

            throw new Error(
                "No intervention is available for diagnostic."
            );
        }


        const mergedOptions = {

            ...this.selectionOptions,

            ...options,

            ...this.diagnosticOptions
        };


        /*
         * Caller-specific options should win.
         */

        Object.assign(
            mergedOptions,
            options
        );


        const diagnosticSet =
            this.diagnosticBridge
                .selectDiagnosticQuestions(
                    selectedIntervention,
                    mergedOptions
                );


        const validation =
            this.diagnosticBridge
                .validateDiagnosticSet(
                    diagnosticSet
                );


        if (
            !validation.valid
        ) {

            throw new Error(
                validation.reason ||
                "Diagnostic question set is invalid."
            );
        }


        return {

            targetSkillId:
                this.flow.targetSkillId,

            interventionSkillId:
                selectedIntervention.skillId,

            diagnosticSet,

            validation,

            state:
                this.flow.beginDiagnostic()
        };
    }


    async recordDiagnosticAnswer({
        question,
        result,
        timeSpentSeconds = 0,
        attemptedAt = null
    } = {}) {

        if (
            !question
        ) {

            throw new Error(
                "question is required."
            );
        }


        if (
            ![
                "correct",
                "incorrect",
                "skipped"
            ].includes(
                result
            )
        ) {

            throw new Error(
                `Invalid diagnostic result: ${result}`
            );
        }


        /*
         * IMPORTANT:
         *
         * The bridge delegates mutation to the existing
         * LearningPipeline.
         */

        const learningState =
            await this.diagnosticBridge
                .recordDiagnosticResult({

                    learningPipeline:
                        this.learningPipeline,

                    question,

                    result,

                    studentId:
                        this.studentId,

                    timeSpentSeconds,

                    attemptedAt
                });


        return {

            learningState,

            targetSkillId:
                this.flow.targetSkillId,

            questionId:
                question.id,

            result
        };
    }


    async completeDiagnostic(
        results
    ) {

        const diagnosticResult =
            this.diagnosticBridge
                .evaluateDiagnosticResults(
                    results,
                    this.diagnosticOptions
                );


        this.flow.submitDiagnosticResult(
            diagnosticResult
        );


        this.flow.beginReassessment();


        const readinessState =
            await this.getCurrentReadiness();


        const nextInterventionPlan =
            readinessState.interventionPlan;


        const nextState =
            this.flow.continueAfterReassessment(
                readinessState,
                nextInterventionPlan
            );


        return {

            diagnosticResult,

            readinessState,

            state:
                nextState
        };
    }


    async runDiagnosticSession({
        intervention = null,
        questions = null,
        answers = null,
        options = {}
    } = {}) {

        const selectedIntervention =
            intervention ||
            this.flow.getCurrentIntervention();


        if (
            !selectedIntervention
        ) {

            throw new Error(
                "No intervention available."
            );
        }


        const diagnostic =
            questions
                ? {

                    interventionSkillId:
                        selectedIntervention
                            .skillId,

                    questionCount:
                        questions.length,

                    questions
                }
                : this.prepareDiagnostic(
                    selectedIntervention,
                    options
                ).diagnosticSet;


        const validation =
            this.diagnosticBridge
                .validateDiagnosticSet(
                    diagnostic
                );


        if (
            !validation.valid
        ) {

            throw new Error(
                validation.reason
            );
        }


        /*
         * When answers are supplied, process them through the
         * existing learning pipeline.
         */

        if (
            answers
        ) {

            const answerList =
                Array.isArray(
                    answers
                )
                    ? answers
                    : [];


            const questionResults = [];


            for (
                let i = 0;
                i < answerList.length;
                i++
            ) {

                const candidate =
                    diagnostic.questions[i];


                const question =
                    candidate &&
                    candidate.question
                        ? candidate.question
                        : candidate;


                const answer =
                    answerList[i];


                if (
                    !question
                ) {

                    continue;
                }


                const result =
                    answer.result ??
                    (
                        answer.correct === true
                            ? "correct"
                            : answer.correct === false
                                ? "incorrect"
                                : "skipped"
                    );


                await this.recordDiagnosticAnswer({

                    question,

                    result,

                    timeSpentSeconds:
                        answer.timeSpentSeconds ??
                        0,

                    attemptedAt:
                        answer.attemptedAt ??
                        null
                });


                questionResults.push({

                    questionId:
                        question.id,

                    skillIds:
                        Array.isArray(
                            question.skillIds
                        )
                            ? question.skillIds
                            : [],

                    result
                });
            }


            return await this.completeDiagnostic(
                questionResults
            );
        }


        return {

            diagnostic,

            validation,

            state:
                this.flow.beginDiagnostic()
        };
    }


    snapshot() {

        return this.flow.snapshot();
    }
}


/**
 * Factory.
 */
export function createReadinessRemediationOrchestrator(
    options = {}
) {

    return new ReadinessRemediationOrchestrator(
        options
    );
}
