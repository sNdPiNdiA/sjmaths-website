/**
 * STEP 32.45B
 *
 * Application Adaptive Learning API Contract Test
 */

import assert from "assert";


import {
    MathsMasteryApplication
} from "./maths-mastery-application.js";


/* ============================================================
   MEMORY STORAGE
   ============================================================ */

class MemoryStorage {

    constructor() {

        this.store =
            new Map();
    }


    getItem(
        key
    ) {

        return this.store.has(
            key
        )
            ? this.store.get(
                key
            )
            : null;
    }


    setItem(
        key,
        value
    ) {

        this.store.set(
            key,
            String(
                value
            )
        );
    }


    removeItem(
        key
    ) {

        this.store.delete(
            key
        );
    }


    clear() {

        this.store.clear();
    }
}


/* ============================================================
   MOCK PROGRESS REPOSITORY
   ============================================================ */

const progressState = {

    topics: {}
};


const progressRepository = {

    load() {

        return structuredClone(
            progressState
        );
    },


    save(
        progress
    ) {

        return progress;
    }
};


/* ============================================================
   CREATE APPLICATION
   ============================================================ */

const app =
    new MathsMasteryApplication({

        storage:
            new MemoryStorage(),

        progressRepository
    });


console.log("");
console.log("============================================================");
console.log(" STEP 32.45B — ADAPTIVE APPLICATION API TEST");
console.log("============================================================");
console.log("");

console.log(
    "✓ MathsMasteryApplication created"
);


/* ============================================================
   TEST 1 — API EXISTS
   ============================================================ */

console.log("");
console.log(
    "TEST 1 — Adaptive API"
);


for (
    const method
    of [
        "startAdaptiveTarget",
        "getAdaptiveState",
        "checkAdaptiveReadiness",
        "prepareAdaptiveDiagnostic",
        "submitAdaptiveAnswer",
        "completeAdaptiveDiagnostic",
        "continueAdaptiveLearning",
        "resetAdaptiveLearning"
    ]
) {

    assert.strictEqual(
        typeof app[method],
        "function"
    );
}


console.log(
    "✓ Adaptive API methods exist"
);


/* ============================================================
   TEST 2 — ORCHESTRATOR CONNECTION
   ============================================================ */

console.log("");
console.log(
    "TEST 2 — Orchestrator Connection"
);


const orchestrator =
    app.getAdaptiveRemediationOrchestrator();


assert.ok(
    orchestrator
);


assert.strictEqual(
    orchestrator.readinessProvider,
    app
);


assert.ok(
    orchestrator.learningPipeline
);


assert.strictEqual(
    typeof orchestrator.learningPipeline.recordQuestion,
    "function"
);


console.log(
    "✓ Orchestrator connected through application bridge"
);


/* ============================================================
   TEST 3 — TARGET
   ============================================================ */

console.log("");
console.log(
    "TEST 3 — Adaptive Target"
);


const targetState =
    await app.startAdaptiveTarget(
        "quadratic.factorisation"
    );


assert.strictEqual(
    targetState.targetSkillId,
    "quadratic.factorisation"
);


assert.ok(
    [
        "NOT_READY",
        "TARGET_LEARNING"
    ].includes(
        targetState.state
    )
);


console.log(
    `✓ Adaptive target started: ${targetState.state}`
);


/* ============================================================
   TEST 4 — STATE
   ============================================================ */

console.log("");
console.log(
    "TEST 4 — Adaptive State"
);


const state =
    app.getAdaptiveState();


assert.strictEqual(
    state.targetSkillId,
    "quadratic.factorisation"
);


assert.ok(
    state.history.length >
    0
);


console.log(
    `✓ History entries: ${state.history.length}`
);


/* ============================================================
   TEST 5 — LIVE READINESS
   ============================================================ */

console.log("");
console.log(
    "TEST 5 — Live Readiness"
);


const readiness =
    await app.checkAdaptiveReadiness();


assert.ok(
    readiness
);


assert.strictEqual(
    typeof readiness.state,
    "string"
);


console.log(
    `✓ Readiness state: ${readiness.state}`
);


/* ============================================================
   TEST 6 — DIAGNOSTIC
   ============================================================ */

console.log("");
console.log(
    "TEST 6 — Diagnostic Preparation"
);


if (
    readiness.state ===
    "NOT_READY"
) {

    const current =
        app.getAdaptiveState();


    assert.ok(
        current.interventionPlan
    );


    await orchestrator
        .prepareIntervention();


    const diagnostic =
        await app.prepareAdaptiveDiagnostic();


    assert.ok(
        diagnostic.diagnosticSet
    );


    assert.ok(
        diagnostic.diagnosticSet
            .questions
            .length >
        0
    );


    assert.strictEqual(
        diagnostic.state.state,
        "DIAGNOSTIC"
    );


    console.log(
        `✓ Diagnostic prepared: ${diagnostic.diagnosticSet.questions.length} questions`
    );

}
else {

    console.log(
        "✓ Diagnostic not required"
    );
}


/* ============================================================
   TEST 7 — RECORD LEARNING BRIDGE
   ============================================================ */

console.log("");
console.log(
    "TEST 7 — Application Learning Bridge"
);


const bridgeResult =
    await app.recordLearningResult({

        topicId:
            "algebra",

        questionId:
            "diagnostic-test",

        conceptId:
            "quadratic-factorisation",

        skillIds: [
            "algebra.negative-brackets"
        ],

        correct:
            true,

        timeSpentSeconds:
            15,

        attemptedAt:
            null
    });


assert.ok(
    bridgeResult !== undefined
);


console.log(
    "✓ Existing recordLearningResult() remains callable"
);


/* ============================================================
   TEST 8 — RESET
   ============================================================ */

console.log("");
console.log(
    "TEST 8 — Reset"
);


const reset =
    app.resetAdaptiveLearning();


assert.strictEqual(
    reset.state,
    null
);


assert.strictEqual(
    reset.targetSkillId,
    null
);


assert.strictEqual(
    reset.history.length,
    0
);


console.log(
    "✓ Adaptive state reset"
);


/* ============================================================
   TEST 9 — EXISTING PROGRESS ARCHITECTURE
   ============================================================ */

console.log("");
console.log(
    "TEST 9 — Existing Progress Architecture"
);


assert.ok(
    app.progressRepository
);


assert.ok(
    app.masteryEngine !== undefined
);


assert.ok(
    app.diagnosticEngine !== undefined
);


assert.ok(
    app.progress !== undefined
);


assert.ok(
    app.mastery !== undefined
);


console.log(
    "✓ Existing application architecture preserved"
);


/* ============================================================
   SUMMARY
   ============================================================ */

console.log("");
console.log("============================================================");
console.log(" STEP 32.45B PASSED");
