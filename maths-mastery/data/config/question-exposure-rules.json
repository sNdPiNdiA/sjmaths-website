{
  "version": "1.0.0",

  "exposure": {

    "maxRecentAttempts": 50,

    "track": [
      "attemptCount",
      "correctCount",
      "incorrectCount",
      "skippedCount",
      "totalTimeSpentSeconds",
      "lastResult",
      "firstAttemptedAt",
      "lastAttemptedAt",
      "consecutiveCorrect",
      "consecutiveIncorrect"
    ],

    "results": [
      "correct",
      "incorrect",
      "skipped"
    ]
  }
}
