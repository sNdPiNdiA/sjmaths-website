      "answer": {
        "value": "400"
      },

      "hint": "After a 25% increase, the final value is 125% of the original.",

      "solution": [
        {
          "step": 1,
          "title": "Express the final value",
          "content": [
            {
              "type": "formula",
              "latex": "500=125\\%\\text{ of Original Value}"
            }
          ]
        },

        {
          "step": 2,
          "title": "Form the equation",
          "content": [
            {
              "type": "formula",
              "latex": "500=\\frac{125}{100}\\times x"
            }
          ]
        },

        {
          "step": 3,
          "title": "Solve",
          "content": [
            {
              "type": "formula",
              "latex": "x=500\\times\\frac{100}{125}"
            },

            {
              "type": "calculation",
              "value": "x = 400"
            },

            {
              "type": "result",
              "value": "400"
            }
          ]
        }
      ],

      "shortcut": {
        "title": "Direct Reverse Percentage",
        "explanation": "After an r% increase, divide the final value by 100 + r and multiply by 100.",
        "formula": "\\frac{500\\times100}{125}=400"
