    {
      "id": "percentage-p-005",
      "question": "A number is increased by 20% and then decreased by 10%. Find the net percentage change.",

      "type": "numerical",
      "difficulty": "advanced",

      "skills": [
        {
          "id": "successive-percentage-change",
          "role": "primary"
        },
        {
          "id": "percentage-increase",
          "role": "secondary"
        },
        {
          "id": "percentage-decrease",
          "role": "secondary"
        }
      ],

      "concepts": [
        "successive-percentage-change"
      ],

      "answer": {
        "value": "8% increase"
      },

      "hint": "Use a + b + ab/100, taking the decrease as negative.",

      "solution": [
        {
          "step": 1,
          "title": "Assign signs",
          "content": [
            {
              "type": "text",
              "value": "a = +20 and b = -10."
            }
          ]
        },

        {
          "step": 2,
          "title": "Apply the successive-change formula",
          "content": [
            {
              "type": "formula",
              "latex": "a+b+\\frac{ab}{100}"
            },

            {
              "type": "formula",
              "latex": "20-10+\\frac{20(-10)}{100}"
            }
          ]
        },

        {
          "step": 3,
          "title": "Calculate",
          "content": [
            {
              "type": "calculation",
              "value": "20 - 10 - 2 = 8%"
            },

            {
              "type": "result",
              "value": "8% increase"
            }
          ]
        }
      ],

      "shortcut": {
        "title": "Successive Change Shortcut",
        "explanation": "Use a + b + ab/100 with signs.",
        "formula": "a+b+ab/100"
      },

      "commonTrap": "Do not simply calculate 20% - 10% = 10%. The second change acts on the changed value.",

      "estimatedSeconds": 60,

      "examRelevance": {
        "ssc": 100,
        "banking": 100,
        "railway": 95,
        "defence": 95,
        "teaching": 90
      },

      "tags": [
        "successive-change",
        "advanced-percentage"
      ]
