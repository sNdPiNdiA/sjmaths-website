{
  "version": "1.0.0",
  "topicId": "percentage",

  "examples": [

    {
      "id": "percentage-ex-001",
      "title": "Finding a Percentage of a Quantity",

      "difficulty": "basic",
      "type": "direct",

      "question": "Find 20% of 250.",

      "given": [
        "Percentage = 20%",
        "Number = 250"
      ],

      "required": "Find 20% of 250.",

      "skills": [
        {
          "id": "percentage-calculation",
          "role": "primary"
        }
      ],

      "concepts": [
        "meaning-of-percentage"
      ],

      "formula": [
        {
          "title": "Percentage of a Quantity",
          "latex": "\\frac{p}{100}\\times N"
        }
      ],

      "approach": "Convert 20% into a fraction and multiply it by 250.",

      "solution": [
        {
          "step": 1,
          "title": "Write the percentage as a fraction",
          "content": [
            {
              "type": "formula",
              "latex": "20\\% = \\frac{20}{100}"
            }
          ]
        },

        {
          "step": 2,
          "title": "Multiply by the given number",
          "content": [
            {
              "type": "formula",
              "latex": "\\frac{20}{100}\\times250"
            }
          ]
        },

        {
          "step": 3,
          "title": "Calculate",
          "content": [
            {
              "type": "calculation",
              "value": "20 ÷ 100 × 250 = 50"
            },

            {
              "type": "result",
              "value": "50"
            }
          ]
        }
      ],

      "shortcut": {
        "title": "Quick Method",
        "explanation": "10% of 250 is 25, so 20% is twice 25.",
        "formula": "20\\%\\text{ of }250=50"
      },

      "verification": "20% of 250 means 20 out of every 100. Since 250 × 20/100 = 50, the result is correct.",

      "finalAnswer": "50",

      "examRelevance": {
        "ssc": 90,
        "banking": 85,
        "railway": 90,
        "defence": 85,
        "teaching": 80
      },

      "tags": [
        "basic-percentage",
        "direct-percentage"
      ]
    },


    {
      "id": "percentage-ex-002",
      "title": "Converting a Fraction into Percentage",

      "difficulty": "basic",
      "type": "direct",

      "question": "Express \\frac{3}{5} as a percentage.",

      "given": [
        "Fraction = 3/5"
      ],

      "required": "Convert the fraction into percentage.",

      "skills": [
        {
          "id": "percentage-calculation",
          "role": "primary"
        },
        {
          "id": "fraction-conversion",
          "role": "secondary"
        }
      ],

      "concepts": [
        "fraction-to-percentage"
      ],

      "formula": [
        {
          "title": "Fraction to Percentage",
          "latex": "\\frac{p}{q}\\times100\\%"
        }
      ],

      "approach": "Multiply the fraction by 100%.",

      "solution": [
        {
          "step": 1,
          "title": "Write the conversion",
          "content": [
            {
              "type": "formula",
              "latex": "\\frac{3}{5}\\times100\\%"
            }
          ]
        },

        {
          "step": 2,
          "title": "Simplify",
          "content": [
            {
              "type": "calculation",
              "value": "3 × 20% = 60%"
            }
          ]
        },

        {
          "step": 3,
          "title": "State the answer",
          "content": [
            {
              "type": "result",
              "value": "60%"
            }
          ]
        }
      ],

      "shortcut": {
        "title": "Denominator Method",
        "explanation": "Since 5 × 20 = 100, multiply the numerator 3 by 20.",
        "formula": "\\frac{3}{5}=\\frac{60}{100}=60\\%"
      },

      "finalAnswer": "60%",

      "examRelevance": {
        "ssc": 85,
        "banking": 80,
        "railway": 85,
        "defence": 80,
        "teaching": 80
      },

      "tags": [
        "fraction-to-percentage",
        "conversion"
      ]
    },


    {
      "id": "percentage-ex-003",
      "title": "Percentage Increase",

      "difficulty": "foundation",
      "type": "application",

      "question": "The price of an article increases from ₹500 to ₹600. Find the percentage increase.",

      "given": [
        "Original price = ₹500",
        "New price = ₹600"
      ],

      "required": "Find the percentage increase.",

      "skills": [
        {
          "id": "percentage-increase",
          "role": "primary"
        }
      ],

      "concepts": [
        "percentage-increase"
      ],

      "formula": [
        {
          "title": "Percentage Increase",
          "latex": "\\frac{\\text{Increase}}{\\text{Original Value}}\\times100"
        }
      ],

      "approach": "Find the increase first, then divide it by the original value.",

      "solution": [
        {
          "step": 1,
          "title": "Find the increase",
          "content": [
            {
              "type": "formula",
              "latex": "600-500=100"
            }
          ]
        },

        {
          "step": 2,
          "title": "Use the original value as denominator",
          "content": [
            {
              "type": "formula",
              "latex": "\\frac{100}{500}\\times100"
            }
          ]
        },

        {
          "step": 3,
          "title": "Calculate",
          "content": [
            {
              "type": "calculation",
              "value": "20%"
            },

            {
              "type": "result",
              "value": "20%"
            }
          ]
        }
      ],

      "commonTrap": "The denominator must be the original price, not the new price.",

      "verification": "20% of ₹500 is ₹100. Adding ₹100 to ₹500 gives ₹600.",

      "finalAnswer": "20%",

      "examRelevance": {
        "ssc": 95,
        "banking": 95,
        "railway": 95,
        "defence": 90,
        "teaching": 85
      },

      "tags": [
        "percentage-increase",
        "price-change"
      ]
    },


    {
      "id": "percentage-ex-004",
      "title": "Percentage Decrease",

      "difficulty": "foundation",
      "type": "application",

      "question": "A quantity decreases from 800 to 680. Find the percentage decrease.",

      "given": [
        "Original value = 800",
        "New value = 680"
      ],

      "required": "Find the percentage decrease.",

      "skills": [
        {
          "id": "percentage-decrease",
          "role": "primary"
        }
      ],

      "concepts": [
        "percentage-decrease"
      ],

      "formula": [
        {
          "title": "Percentage Decrease",
          "latex": "\\frac{\\text{Decrease}}{\\text{Original Value}}\\times100"
        }
      ],

      "approach": "Calculate the decrease and compare it with the original value.",

      "solution": [
        {
          "step": 1,
          "title": "Find the decrease",
          "content": [
            {
              "type": "formula",
              "latex": "800-680=120"
            }
          ]
        },

        {
          "step": 2,
          "title": "Calculate percentage decrease",
          "content": [
            {
              "type": "formula",
              "latex": "\\frac{120}{800}\\times100"
            }
          ]
        },

        {
          "step": 3,
          "title": "Simplify",
          "content": [
            {
              "type": "calculation",
              "value": "15%"
            },

            {
              "type": "result",
              "value": "15%"
            }
          ]
        }
      ],

      "commonTrap": "Use the original value as the denominator when calculating percentage decrease.",

      "finalAnswer": "15%",

      "examRelevance": {
        "ssc": 95,
        "banking": 95,
        "railway": 95,
        "defence": 90,
        "teaching": 85
      },

      "tags": [
        "percentage-decrease",
        "quantity-change"
      ]
    },


    {
      "id": "percentage-ex-005",
      "title": "Successive Percentage Changes",

      "difficulty": "advanced",
      "type": "shortcut",

      "question": "A number is increased by 20% and then decreased by 10%. Find the net percentage change.",

      "given": [
        "First change = +20%",
        "Second change = -10%"
      ],

      "required": "Find the net percentage change.",

      "skills": [
        {
          "id": "successive-percentage-change",
          "role": "primary"
        },
        {
          "id": "percentage-increase",
          "role": "secondary"
        },
        {
          "id": "percentage-decrease",
          "role": "secondary"
        }
      ],

      "concepts": [
        "successive-percentage-change"
      ],

      "formula": [
        {
          "title": "Net Successive Change",
          "latex": "a+b+\\frac{ab}{100}"
        }
      ],

      "approach": "Take the two percentage changes with their signs and apply the successive-change formula.",

      "solution": [
        {
          "step": 1,
          "title": "Assign signs",
          "content": [
            {
              "type": "text",
              "value": "Increase = +20%, decrease = -10%."
            }
          ]
        },

        {
          "step": 2,
          "title": "Apply the formula",
          "content": [
            {
              "type": "formula",
              "latex": "20+(-10)+\\frac{20(-10)}{100}"
            }
          ]
        },

        {
          "step": 3,
          "title": "Calculate",
          "content": [
            {
              "type": "calculation",
              "value": "20 - 10 - 2 = 8%"
            }
          ]
        },

        {
          "step": 4,
          "title": "Interpret the result",
          "content": [
            {
              "type": "result",
              "value": "Net increase = 8%"
            }
          ]
        }
      ],

      "shortcut": {
        "title": "Direct Competitive Shortcut",
        "explanation": "For successive changes a% and b%, use a + b + ab/100, keeping the signs of increase and decrease.",
        "formula": "a+b+ab/100"
      },

      "commonTrap": "Do not simply subtract 10% from 20% and stop. The second change is applied to the changed value.",

      "verification": "Assume 100. After a 20% increase it becomes 120. A 10% decrease gives 108. Therefore the net increase is 8%.",

      "finalAnswer": "8% increase",

      "examRelevance": {
        "ssc": 100,
        "banking": 100,
        "railway": 95,
        "defence": 95,
        "teaching": 90
      },

      "tags": [
        "successive-change",
        "net-percentage-change"
      ]
    },


    {
      "id": "percentage-ex-006",
      "title": "Reverse Percentage",

      "difficulty": "advanced",
      "type": "multi-step",

      "question": "After a 20% increase, the price of an article becomes ₹600. Find its original price.",

      "given": [
        "Final price = ₹600",
        "Increase = 20%"
      ],

      "required": "Find the original price.",

      "skills": [
        {
          "id": "reverse-percentage",
          "role": "primary"
        },
        {
          "id": "percentage-increase",
          "role": "secondary"
        }
      ],

      "concepts": [
        "reverse-percentage"
      ],

      "formula": [
        {
          "title": "Original Value After Percentage Increase",
          "latex": "\\text{Original Value}=\\frac{\\text{Final Value}\\times100}{100+r}"
        }
      ],

      "approach": "If the original value is increased by 20%, the final value represents 120% of the original value.",

      "solution": [
        {
          "step": 1,
          "title": "Express the final value as a percentage of the original",
          "content": [
            {
              "type": "formula",
              "latex": "\\text{Final Value}=120\\%\\text{ of Original Value}"
            }
          ]
        },

        {
          "step": 2,
          "title": "Form the equation",
          "content": [
            {
              "type": "formula",
              "latex": "600=\\frac{120}{100}\\times\\text{Original Value}"
            }
          ]
        },

        {
          "step": 3,
          "title": "Solve for the original value",
          "content": [
            {
              "type": "formula",
              "latex": "\\text{Original Value}=600\\times\\frac{100}{120}"
            }
          ]
        },

        {
          "step": 4,
          "title": "Calculate",
          "content": [
            {
              "type": "calculation",
              "value": "600 × 5/6 = 500"
            },

            {
              "type": "result",
              "value": "₹500"
            }
          ]
        }
      ],

      "shortcut": {
        "title": "Direct Formula",
        "explanation": "After an r% increase, divide the final value by (100 + r) and multiply by 100.",
        "formula": "\\frac{600\\times100}{120}=500"
      },

      "commonTrap": "Do not subtract 20% from ₹600. The 20% increase was calculated on the original price, not on ₹600.",

      "verification": "20% of ₹500 is ₹100. Therefore ₹500 + ₹100 = ₹600.",

      "finalAnswer": "₹500",

      "examRelevance": {
        "ssc": 100,
        "banking": 100,
        "railway": 95,
        "defence": 95,
        "teaching": 90
      },

      "tags": [
        "reverse-percentage",
        "original-value"
      ]
    }

  ]
}
