  "question": {
    "text": "A number is decreased by 20% and becomes 160. What was the original number?",
    "language": "en"
  },

  "options": [
    {
      "id": "a",
      "text": "180"
    },
    {
      "id": "b",
      "text": "200"
    },
    {
      "id": "c",
      "text": "220"
    },
    {
      "id": "d",
      "text": "240"
    }
  ],

  "answer": {
    "type": "option",
    "value": "b"
  },

  "solution": {
    "steps": [
      {
        "step": 1,
        "text": "After a 20% decrease, the final value is 80% of the original number."
      },
      {
        "step": 2,
        "text": "Therefore, 80% of the original number equals 160."
      },
      {
        "step": 3,
        "text": "Original number = 160 ÷ 0.80 = 200."
      }
    ],
    "finalAnswer": "200"
  },

  "hints": [
    "After a 20% decrease, 80% of the original remains.",
    "Divide the final value by 0.80."
  ],

