  "question": {
    "text": "A number is increased by 20% and becomes 240. What was the original number?",
    "language": "en"
  },

  "options": [
    {
      "id": "a",
      "text": "180"
    },
    {
      "id": "b",
      "text": "200"
    },
    {
      "id": "c",
      "text": "220"
    },
    {
      "id": "d",
      "text": "288"
    }
  ],

  "answer": {
    "type": "option",
    "value": "b"
  },

  "solution": {
    "steps": [
      {
        "step": 1,
        "text": "After a 20% increase, the final value is 120% of the original number."
      },
      {
        "step": 2,
        "text": "Therefore, 120% of the original number equals 240."
      },
      {
        "step": 3,
        "text": "Original number = 240 ÷ 1.20 = 200."
      }
    ],
    "finalAnswer": "200"
  },

  "hints": [
    "The final value represents 120% of the original.",
    "Divide the final value by 1.20."
  ],

