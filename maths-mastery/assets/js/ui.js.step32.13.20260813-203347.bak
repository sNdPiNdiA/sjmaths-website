export function getScreen() {
    return document.getElementById("mastery-screen");
}


export function renderWelcome(
    {
        onStart = null
    } = {}
) {

    const screen = getScreen();

    if (!screen) {
        return;
    }


    screen.innerHTML = `

        <div class="mastery-page">

            <section class="mastery-hero">

                <div class="mastery-hero__content">

                    <div class="mastery-eyebrow">
                        SJMaths Learning System
                    </div>

                    <h1>
                        Master maths.<br>
                        One step at a time.
                    </h1>

                    <p class="mastery-hero__text">
                        Learn concepts, practise intelligently,
                        understand your mistakes and build lasting
                        mathematical mastery.
                    </p>

                    <button
                        class="mastery-button"
                        id="start-mastery-button"
                        type="button"
                    >
                        Start Maths Mastery
                        <span aria-hidden="true">→</span>
                    </button>

                </div>

            </section>


            <section class="mastery-section">

                <div class="mastery-section-heading">

                    <span>
                        Your learning journey
                    </span>

                    <h2>
                        Learn. Practise. Improve.
                    </h2>

                </div>


                <div class="mastery-journey">

                    <article class="mastery-journey-card">

                        <div class="mastery-journey-card__number">
                            01
                        </div>

                        <h2>
                            Learn
                        </h2>

                        <p>
                            Build concepts from the foundation
                            and follow a structured learning path.
                        </p>

                    </article>


                    <article class="mastery-journey-card">

                        <div class="mastery-journey-card__number">
                            02
                        </div>

                        <h2>
                            Practise
                        </h2>

                        <p>
                            Work on questions selected according
                            to your learning needs.
                        </p>

                    </article>


                    <article class="mastery-journey-card">

                        <div class="mastery-journey-card__number">
                            03
                        </div>

                        <h2>
                            Improve
                        </h2>

                        <p>
                            Your performance guides what you
                            should learn and practise next.
                        </p>

                    </article>

                </div>

            </section>


            <section class="mastery-section">

                <div class="mastery-feature-grid">

                    <article class="mastery-feature-card">

                        <h3>
                            Personalised path
                        </h3>

                        <p>
                            Your learning journey adapts to
                            your current understanding.
                        </p>

                    </article>


                    <article class="mastery-feature-card">

                        <h3>
                            Meaningful practice
                        </h3>

                        <p>
                            Practice is connected to concepts,
                            skills and previous attempts.
                        </p>

                    </article>


                    <article class="mastery-feature-card">

                        <h3>
                            Continuous improvement
                        </h3>

                        <p>
                            Progress becomes the foundation
                            for your next learning decision.
                        </p>

                    </article>

                </div>

            </section>

        </div>
    `;


    const button =
        document.getElementById(
            "start-mastery-button"
        );


    if (button && onStart) {

        button.addEventListener(
            "click",
            onStart
        );

    }

}


export function renderError(
    message
) {

    const screen = getScreen();

    if (!screen) {
        return;
    }

    screen.innerHTML = `

        <div class="mastery-error">

            <strong>
                Maths Mastery could not start.
            </strong>

            <div style="margin-top:8px">
                ${escapeHtml(message)}
            </div>

        </div>
    `;
}


export function showStatus(
    message
) {

    const status =
        document.getElementById(
            "mastery-status"
        );

    if (!status) {
        return;
    }

    status.textContent =
        message;

    status.hidden =
        false;

    window.clearTimeout(
        showStatus.timer
    );

    showStatus.timer =
        window.setTimeout(
            () => {
                status.hidden = true;
            },
            3000
        );
}


function escapeHtml(
    value
) {

    return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
}
