/* ============================================================
   SJMaths Maths Mastery
   STEP 32.15
   APPLICATION FLOW
   ============================================================ */

import {
    MathsMasteryApplication
} from "./maths-mastery-application.js";


import {
    renderWelcome,
    renderOnboarding,
    renderExamSelection,
    renderFoundation,
    renderDiagnosticIntro,
    renderError,
    showStatus
} from "./ui.js";


let application = null;


/* ============================================================
   BOOT
   ============================================================ */

function getApplication() {

    if (!application) {

        application =
            new MathsMasteryApplication();

    }

    return application;

}


function getStudentId() {

    const key =
        "sjmaths-maths-mastery-student-id";


    let id =
        localStorage.getItem(
            key
        );


    if (!id) {

        id =
            "local";

        localStorage.setItem(
            key,
            id
        );

    }


    return id;

}


/* ============================================================
   START
   ============================================================ */

function boot() {

    try {

        const app =
            getApplication();


        const state =
            app.start(
                getStudentId()
            );


        /*
         * Always show the frozen welcome UI
         * for a fresh session.
         */

        renderWelcome({

            onStart:
                beginOnboarding

        });


        /*
         * Keep application state available
         * for future dashboard integration.
         */

        window.SJMathsMastery = {
            application: app,
            state
        };


    }
    catch (error) {

        console.error(
            "[Maths Mastery] Boot failed",
            error
        );


        renderError(
            error?.message ||
            "Unable to start Maths Mastery."
        );

    }

}


/* ============================================================
   ONBOARDING
   ============================================================ */

function beginOnboarding() {

    try {

        const app =
            getApplication();


        const state =
            app.beginOnboarding();


        renderOnboarding({

            onExam:
                () => showExamSelection(
                    state
                ),

            onFoundation:
                () => showFoundation(
                    state
                ),

            onDiagnostic:
                () => showDiagnostic()

        });


        syncDebugState();

    }
    catch (error) {

        handleError(
            error
        );

    }

}


/* ============================================================
   EXAM
   ============================================================ */

function showExamSelection(
    state = null
) {

    try {

        const app =
            getApplication();


        const current =
            state ||
            app.getState();


        const exams =
            extractExamOptions(
                current
            );


        renderExamSelection({

            exams,

            onBack:
                () => beginOnboarding(),

            onSelect:
                examId => {

                    try {

                        const nextState =
                            app.selectExam(
                                examId
                            );


                        showFoundation(
                            nextState
                        );


                    }
                    catch (error) {

                        handleError(
                            error
                        );

                    }

                }

        });


        syncDebugState();

    }
    catch (error) {

        handleError(
            error
        );

    }

}


/* ============================================================
   FOUNDATION
   ============================================================ */

function showFoundation(
    state = null
) {

    try {

        const app =
            getApplication();


        renderFoundation({

            onBack:
                () =>
                    beginOnboarding(),

            onSelect:
                foundation => {

                    try {

                        const nextState =
                            app.chooseFoundation(
                                foundation
                            );


                        showDiagnosticOrNext(
                            nextState
                        );


                    }
                    catch (error) {

                        handleError(
                            error
                        );

                    }

                },

            onDiagnostic:
                () =>
                    showDiagnostic()

        });


        syncDebugState();

    }
    catch (error) {

        handleError(
            error
        );

    }

}


/* ============================================================
   DIAGNOSTIC
   ============================================================ */

function showDiagnostic() {

    try {

        const app =
            getApplication();


        const state =
            app.startDiagnostic();


        renderDiagnosticIntro({

            onBack:
                () =>
                    beginOnboarding(),

            onBegin:
                () =>
                    beginDiagnostic(
                        state
                    )

        });


        syncDebugState();

    }
    catch (error) {

        handleError(
            error
        );

    }

}


function beginDiagnostic(
    state
) {

    /*
     * At this stage the UI deliberately enters the diagnostic
     * introduction only.
     *
     * The actual diagnostic question experience will be
     * connected in the next runtime step using the existing
     * diagnostic/application contract.
     */

    showStatus(
        "Diagnostic is ready for the next learning step."
    );


    window.SJMathsMastery =
        Object.assign(
            window.SJMathsMastery || {},
            {
                diagnosticState:
                    state
            }
        );

}


/* ============================================================
   FOUNDATION → NEXT
   ============================================================ */

function showDiagnosticOrNext(
    state
) {

    /*
     * We intentionally do not invent an internal flow state.
     * The existing application remains the source of truth.
     *
     * For now, present the diagnostic entry point after
     * foundation selection.
     */

    renderDiagnosticIntro({

        onBack:
            () =>
                showFoundation(
                    state
                ),

        onBegin:
            () =>
                beginDiagnostic(
                    state
                )

    });

}


/* ============================================================
   EXAM OPTIONS
   ============================================================ */

function extractExamOptions(
    state
) {

    const candidates = [

        state?.exams,

        state?.availableExams,

        state?.flow?.exams,

        state?.flow?.availableExams,

        state?.learnerState?.exams,

        state?.learnerState?.availableExams

    ];


    for (
        const value of candidates
    ) {

        if (
            !Array.isArray(
                value
            )
        ) {
            continue;
        }


        return value

            .map(
                item => {

                    if (
                        typeof item ===
                        "string"
                    ) {

                        return {
                            id: item,
                            name: item
                        };

                    }


                    return {

                        id:
                            item?.id ||
                            item?.examId ||
                            "",

                        code:
                            item?.code ||
                            item?.shortCode ||
                            "EXAM",

                        name:
                            item?.name ||
                            item?.title ||
                            item?.examName ||
                            item?.id ||
                            "Exam",

                        description:
                            item?.description ||
                            ""

                    };

                }
            )

            .filter(
                exam => exam.id
            );

    }


    return [];

}


/* ============================================================
   DEBUG STATE
   ============================================================ */

function syncDebugState() {

    if (!application) {
        return;
    }


    window.SJMathsMastery =
        Object.assign(
            window.SJMathsMastery || {},
            {
                application,

                state:
                    safeGetState()
            }
        );

}


function safeGetState() {

    try {

        return application.getState();

    }
    catch {

        return null;

    }

}


/* ============================================================
   ERRORS
   ============================================================ */

function handleError(
    error
) {

    console.error(
        "[Maths Mastery]",
        error
    );


    renderError(
        error?.message ||
        "Something went wrong."
    );

}


/* ============================================================
   DOM BOOT
   ============================================================ */

if (
    document.readyState ===
    "loading"
) {

    document.addEventListener(
        "DOMContentLoaded",
        boot,
        {
            once: true
        }
    );

}
else {

    boot();

}
