/* ============================================================
   ERROR
   ============================================================ */

export function renderError(
    message
) {

    const screen = getScreen();

    if (!screen) {
        return;
    }


    screen.innerHTML = `

        <div class="mastery-page">

            <div class="mastery-error">

                <strong>
                    Maths Mastery could not start.
                </strong>

                <p>
                    ${escapeHtml(message)}
                </p>

            </div>

        </div>

    `;

}


/* ============================================================
   STATUS
   ============================================================ */

export function showStatus(
    message
) {

    const status =
        document.getElementById(
            "mastery-status"
        );

    if (!status) {
        return;
    }


    status.textContent =
        message;

    status.hidden =
        false;


    window.clearTimeout(
        showStatus.timer
    );


    showStatus.timer =
        window.setTimeout(
            () => {

                status.hidden =
                    true;

            },
            3000
        );

}


/* ============================================================
   ESCAPE
   ============================================================ */

function escapeHtml(
    value
) {

    return String(value)

        .replaceAll(
            "&",
            "&amp;"
        )

        .replaceAll(
            "<",
            "&lt;"
        )

        .replaceAll(
            ">",
            "&gt;"
        )

        .replaceAll(
            '"',
            "&quot;"
        )

        .replaceAll(
            "'",
            "&#039;"
        );

}
