                        <span>
                            It is used to understand your starting
                            point, not simply to give you a score.
                        </span>
                    </div>


                    <div>
                        <strong>
                            Personalised
                        </strong>

                        <span>
                            The result can guide the learning path
                            that follows.
                        </span>
                    </div>


                    <div>
                        <strong>
                            Useful evidence
                        </strong>

                        <span>
                            Your performance becomes part of the
                            learner state.
                        </span>
                    </div>

                </div>


                <button
                    type="button"
                    class="mastery-button mastery-button--primary"
                    data-begin
                >
                    Begin diagnostic
                    <span>→</span>
                </button>

            </section>

        </div>
    `;


    screen
        .querySelector(
            "[data-back]"
        )
        ?.addEventListener(
            "click",
            () => onBack?.()
