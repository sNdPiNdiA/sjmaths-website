/* ============================================================
   SJMaths MATHS MASTERY
   STEP 32.12 COMPONENT LAYER
   ============================================================ */

.mastery-progress-bar {

    width: 100%;
    height: 7px;

    overflow: hidden;

    border-radius: 999px;

    background:
        #eeeeeb;
}

.mastery-progress-bar__value {

    height: 100%;

    border-radius: inherit;

    background:
        linear-gradient(
            90deg,
            var(--mastery-red),
            var(--mastery-orange)
        );
}


.mastery-chip {

    display:
        inline-flex;

    align-items:
        center;

    min-height:
        28px;

    padding:
        0 9px;

    border-radius:
        999px;

    background:
        #fff0ec;

    color:
        var(--mastery-red);

    font-size:
        .65rem;

    font-weight:
        900;
}


.mastery-divider {

    width:
        100%;

    height:
        1px;

    background:
        var(--mastery-border);

    margin:
        18px 0;
}


.mastery-empty {

    padding:
        28px 18px;

    text-align:
        center;

    color:
        var(--mastery-muted);
}


.mastery-error {

    margin:
        18px auto;

    width:
        min(
            calc(100% - 28px),
            560px
        );

    padding:
        18px;

    border:
        1px solid #f1d6d1;

    border-radius:
        14px;

    background:
        #fff8f6;

    color:
        var(--mastery-text);

    font-size:
        .84rem;

    line-height:
        1.5;
}


/* ============================================================
   LEARNING SCREEN HELPERS
   ============================================================ */

.mastery-learning-header {

    display:
        flex;

    flex-direction:
        column;

    gap:
        8px;

    margin-bottom:
        18px;
}


.mastery-learning-header h1 {

    margin:
        0;

    font-size:
        1.7rem;

    line-height:
        1.1;

    letter-spacing:
        -.04em;
}


.mastery-learning-header p {

    margin:
        0;

    color:
        var(--mastery-muted);

    font-size:
        .86rem;

    line-height:
        1.5;
}


.mastery-action-row {

    display:
        flex;

    flex-direction:
        column;

    gap:
        8px;

    margin-top:
        18px;
}


.mastery-action-row .mastery-button {

    width:
        100%;
}


@media (min-width: 640px) {

    .mastery-action-row {

        flex-direction:
            row;
    }

    .mastery-action-row .mastery-button {

        width:
            auto;
    }
}

/* ============================================================
   STEP 32.15 — ONBOARDING COMPONENTS
   ============================================================ */

.mastery-flow-top {

    width: 100%;

    display:
        flex;

    align-items:
        center;

    justify-content:
        space-between;

    gap:
        10px;

    margin-bottom:
        26px;
}


.mastery-back-button {

    min-height:
        40px;

    display:
        inline-flex;

    align-items:
        center;

    gap:
        7px;

    padding:
        0 11px;

    border:
        1px solid var(--mastery-border);

    border-radius:
        10px;

    background:
        white;

    color:
        var(--mastery-text);

    font-size:
        .74rem;

    font-weight:
        800;

    cursor:
        pointer;
}


.mastery-flow-step {

    color:
        var(--mastery-soft);

    font-size:
        .59rem;

    font-weight:
        900;

    letter-spacing:
        .09em;

    text-transform:
        uppercase;
}


.mastery-onboarding-header {

    max-width:
        700px;

    margin-bottom:
        24px;
}


.mastery-onboarding-kicker {

    display:
        block;

    margin-bottom:
        8px;

    color:
        var(--mastery-red);

    font-size:
        .61rem;

    font-weight:
        950;

    letter-spacing:
        .1em;

    text-transform:
        uppercase;
}


.mastery-onboarding-header h1 {

    margin:
        0;

    color:
        var(--mastery-black);

    font-size:
        clamp(
            2rem,
            8vw,
            3.2rem
        );

    line-height:
        1.02;

    letter-spacing:
        -.05em;

    font-weight:
        950;
}


.mastery-onboarding-header p {

    max-width:
        620px;

    margin:
        13px 0 0;

    color:
        var(--mastery-muted);

    font-size:
        .88rem;

    line-height:
        1.6;
}


/* ============================================================
   ROUTE CARDS
   ============================================================ */

.mastery-route-grid,
.mastery-route-list {

    width:
        100%;

    display:
        grid;

    grid-template-columns:
        1fr;

    gap:
        10px;
}


.mastery-route-card {

    width:
        100%;

    min-width:
        0;

    min-height:
        154px;

    display:
        grid;

    grid-template-columns:
        auto minmax(0,1fr) auto;

    align-items:
        center;

    gap:
        14px;

    padding:
        17px;

    border:
        1px solid var(--mastery-border);

    border-radius:
        var(--mastery-radius-md);

    background:
        white;

    color:
        var(--mastery-text);

    text-align:
        left;

    box-shadow:
        var(--mastery-shadow);

    cursor:
        pointer;

    transition:
        transform .16s ease,
        border-color .16s ease,
        box-shadow .16s ease;
}


.mastery-route-card:hover {

    transform:
        translateY(-2px);

    border-color:
        rgba(232,75,61,.35);

    box-shadow:
        var(--mastery-shadow-large);
}


.mastery-route-card__icon {

    width:
        48px;

    height:
        48px;

    display:
        grid;

    place-items:
        center;

    flex:
        0 0 auto;

    border-radius:
        13px;

    background:
        var(--mastery-red-soft);

    color:
        var(--mastery-red);

    font-size:
        .58rem;

    font-weight:
        950;

    letter-spacing:
        .03em;
}


.mastery-route-card__body {

    min-width:
        0;
}


.mastery-route-card__eyebrow {

    display:
        block;

    margin-bottom:
        4px;

    color:
        var(--mastery-red);

    font-size:
        .57rem;

    font-weight:
        900;

    text-transform:
        uppercase;

    letter-spacing:
        .06em;
}


.mastery-route-card h2 {

    margin:
        0;

    font-size:
        1.02rem;

    line-height:
        1.15;

    letter-spacing:
        -.02em;

    font-weight:
        900;
}


.mastery-route-card p {

    margin:
        7px 0 0;

    color:
        var(--mastery-muted);

    font-size:
        .76rem;

    line-height:
        1.5;
}


.mastery-route-card__arrow {

    flex:
        0 0 auto;

    color:
        #b7b7b3;

    font-size:
        1rem;

    font-weight:
        900;
}


.mastery-route-card--compact {

    min-height:
        108px;
}


/* ============================================================
   EMPTY STATE
   ============================================================ */

.mastery-empty-state {

    padding:
        30px 20px;

    border:
        1px dashed var(--mastery-border);

    border-radius:
        var(--mastery-radius-md);

    background:
        white;

    text-align:
        center;
}


.mastery-empty-state__icon {

    width:
        32px;

    height:
        32px;

    margin:
        0 auto 10px;

    display:
        grid;

    place-items:
        center;

    border-radius:
        50%;

    background:
        #f3f3f0;

    color:
        var(--mastery-muted);

    font-weight:
        900;
}


.mastery-empty-state h2 {

    margin:
        0;

    font-size:
        1rem;
}


.mastery-empty-state p {

    max-width:
        430px;

    margin:
        7px auto 0;

    color:
        var(--mastery-muted);

    font-size:
        .76rem;

    line-height:
        1.5;
}


/* ============================================================
   SECONDARY ACTION
   ============================================================ */

.mastery-secondary-action {

    margin-top:
        18px;
}


.mastery-text-button {

    padding:
        0;

    background:
        transparent;

    color:
        var(--mastery-muted);

    font-size:
        .75rem;

    font-weight:
        750;

    cursor:
        pointer;
}


.mastery-text-button span {

    color:
        var(--mastery-red);

    font-weight:
        900;
}


/* ============================================================
   DIAGNOSTIC
   ============================================================ */

.mastery-diagnostic {

    max-width:
        740px;

    padding:
        24px;

    border:
        1px solid var(--mastery-border);

    border-radius:
        var(--mastery-radius-lg);

    background:
        white;

    box-shadow:
        var(--mastery-shadow);
}


.mastery-diagnostic h1 {

    margin:
        0;

    font-size:
        clamp(
            2rem,
            8vw,
            3.2rem
        );

    line-height:
        1.02;

    letter-spacing:
        -.05em;

    font-weight:
        950;
}


.mastery-diagnostic > p {

    max-width:
        580px;

    margin:
        14px 0 0;

    color:
        var(--mastery-muted);

    font-size:
        .88rem;

    line-height:
        1.6;
}


.mastery-diagnostic-points {

    display:
        grid;

    grid-template-columns:
        1fr;

    gap:
        8px;

    margin:
        22px 0;
}


.mastery-diagnostic-points > div {

    padding:
        13px;

    border:
        1px solid var(--mastery-border);

    border-radius:
        12px;

    background:
        #fafaf8;
}


.mastery-diagnostic-points strong {

    display:
        block;

    margin-bottom:
        3px;

    font-size:
        .78rem;

    font-weight:
        900;
}


.mastery-diagnostic-points span {

    display:
        block;

    color:
        var(--mastery-muted);

    font-size:
        .7rem;

    line-height:
        1.45;
}


@media (min-width: 700px) {

    .mastery-route-grid {

        grid-template-columns:
            repeat(3,1fr);
    }


    .mastery-route-card {

        min-height:
            210px;

        grid-template-columns:
            1fr auto;

        align-content:
            start;
    }


    .mastery-route-card__body {

        grid-column:
            1 / -1;
    }


    .mastery-route-card__icon {

        width:
            42px;

        height:
            42px;
    }


    .mastery-route-card__arrow {

        align-self:
            center;
    }


    .mastery-diagnostic-points {

        grid-template-columns:
            repeat(3,1fr);
    }

}


@media (min-width: 900px) {

    .mastery-onboarding-header {

        margin-bottom:
            30px;
    }


    .mastery-route-card {

        padding:
            22px;
    }


    .mastery-diagnostic {

        padding:
            34px;
    }

}
