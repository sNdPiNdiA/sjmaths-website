/* ============================================================
   SJMaths Maths Mastery
   STEP 32.11
   MOBILE-FIRST RESPONSIVE SYSTEM

   IMPORTANT:
   Mobile is the PRIMARY design.
   Larger layouts progressively enhance the mobile layout.
   ============================================================ */


/* ============================================================
   1. BASE — 320px+
   ============================================================ */

html {
    width: 100%;
    min-width: 320px;
    overflow-x: hidden;
}

body {
    width: 100%;
    min-width: 320px;
    overflow-x: hidden;
}

.mastery-app {
    width: 100%;
    min-width: 320px;
    min-height: 100dvh;

    display: flex;
    flex-direction: column;
}


/* ============================================================
   2. HEADER — MOBILE
   ============================================================ */

.mastery-header {
    min-height: 58px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding:
        10px 14px;

    gap: 10px;

    position: sticky;
    top: 0;
    z-index: 50;

    background:
        rgba(255,255,255,0.96);

    backdrop-filter:
        blur(10px);

    border-bottom:
        1px solid var(--mastery-border);
}

.mastery-header__brand {
    min-width: 0;
}

.mastery-brand {
    display: inline-flex;
    flex-direction: column;

    min-width: 0;

    text-decoration: none;
}

.mastery-brand__name {
    font-size: 0.95rem;
    font-weight: 900;
    line-height: 1.05;
}

.mastery-brand__product {
    margin-top: 3px;

    font-size: 0.62rem;
    font-weight: 800;

    letter-spacing: 0.05em;
    text-transform: uppercase;

    color:
        var(--mastery-text-soft);
}

.mastery-header__actions {
    display: flex;
    align-items: center;
    gap: 6px;
}


/* ============================================================
   3. TOUCH TARGETS
   ============================================================ */

button,
a,
input,
select,
textarea {
    -webkit-tap-highlight-color: transparent;
}

button,
.mastery-button,
.mastery-option-card,
.mastery-icon-button {
    min-height: 44px;
}

.mastery-icon-button {
    padding:
        9px 12px;

    border:
        1px solid var(--mastery-border);

    border-radius:
        10px;

    background:
        var(--mastery-surface);

    color:
        var(--mastery-text);

    font-weight:
        800;

    cursor:
        pointer;
}


/* ============================================================
   4. MAIN
   ============================================================ */

.mastery-main {
    flex: 1;
    width: 100%;
}

.mastery-screen {
    width: 100%;
}


/* ============================================================
   5. PAGE CONTAINER
   ============================================================ */

.mastery-page {
    width:
        calc(100% - 24px);

    max-width:
        var(--mastery-content-width);

    margin:
        0 auto;

    padding:
        20px 0 36px;
}


/* ============================================================
   6. HERO — MOBILE
   ============================================================ */

.mastery-hero {
    width: 100%;

    padding:
        30px 18px;

    border-radius:
        18px;

    text-align:
        center;
}

.mastery-eyebrow {
    margin-bottom:
        8px;

    font-size:
        0.68rem;
}

.mastery-hero h1,
.mastery-section-heading h1,
.mastery-dashboard-header h1 {
    font-size:
        clamp(
            1.85rem,
            9vw,
            2.5rem
        );

    line-height:
        1.08;

    letter-spacing:
        -0.035em;
}

.mastery-hero__text {
    max-width:
        100%;

    margin:
        14px auto 20px;

    font-size:
        0.94rem;

    line-height:
        1.55;
}


/* ============================================================
   7. PRIMARY ACTIONS
   ============================================================ */

.mastery-button {
    width:
        auto;

    min-height:
        46px;

    padding:
        11px 17px;

    border-radius:
        11px;

    font-size:
        0.9rem;
}

.mastery-hero .mastery-button {
    width:
        100%;

    max-width:
        320px;
}


/* ============================================================
   8. FEATURE GRID — MOBILE
   ============================================================ */

.mastery-feature-grid,
.mastery-option-grid,
.mastery-dashboard-grid {
    display:
        grid;

    grid-template-columns:
        1fr;

    gap:
        12px;
}

.mastery-feature-grid {
    margin-top:
        12px;
}

.mastery-feature-card {
    padding:
        18px;
}

.mastery-feature-card h2 {
    font-size:
        1.05rem;
}

.mastery-feature-card p {
    font-size:
        0.9rem;

    line-height:
        1.5;
}


/* ============================================================
   9. OPTION CARDS — TOUCH FRIENDLY
   ============================================================ */

.mastery-option-card {
    width:
        100%;

    min-height:
        76px;

    padding:
        17px;

    border-radius:
        14px;
}

.mastery-option-card strong {
    font-size:
        1rem;
}

.mastery-option-card span {
    font-size:
        0.86rem;

    line-height:
        1.45;
}


/* ============================================================
   10. DASHBOARD CARDS
   ============================================================ */

.mastery-card {
    width:
        100%;

    padding:
        18px;

    border-radius:
        14px;
}

.mastery-card__value {
    font-size:
        1.8rem;
}


/* ============================================================
   11. RECOMMENDATION
   ============================================================ */

.mastery-card--recommendation {
    gap:
        16px;

    margin-top:
        12px;

    padding:
        18px;
}

.mastery-card--recommendation .mastery-button {
    width:
        100%;
}


/* ============================================================
   12. DIAGNOSTIC / LEARNING CONTENT
   ============================================================ */

.mastery-card--diagnostic {
    width:
        100%;

    max-width:
        none;

    margin:
        0 auto;
}

.mastery-info-list {
    gap:
        9px;

    margin:
        18px 0;
}

.mastery-info-list div {
    padding:
        12px;
}


/* ============================================================
   13. MATH CONTENT SAFETY
   ============================================================ */

/*
   Mathematical expressions must never create horizontal
   scrolling on the entire page.
*/

.katex-display,
.math-display,
.math-expression,
.mastery-math {
    max-width:
        100%;

    overflow-x:
        auto;

    overflow-y:
        hidden;

    -webkit-overflow-scrolling:
        touch;

    padding-bottom:
        4px;
}


/* ============================================================
   14. QUESTION SCREEN PREPARATION
   ============================================================ */

.mastery-question,
.mastery-question-card {
    width:
        100%;

    max-width:
        100%;

    margin:
        0 auto;
}

.mastery-question-card {
    padding:
        18px;

    border-radius:
        16px;
}

.mastery-question-actions {
    display:
        grid;

    grid-template-columns:
        1fr;

    gap:
        8px;

    width:
        100%;
}

.mastery-question-actions button,
.mastery-question-actions .mastery-button {
    width:
        100%;
}


/* ============================================================
   15. STATUS / TOAST
   ============================================================ */

.mastery-status {
    bottom:
        12px;

    width:
        calc(100% - 24px);

    max-width:
        500px;

    padding:
        11px 13px;

    font-size:
        0.86rem;
}


/* ============================================================
   16. FOOTER — MOBILE
   ============================================================ */

.mastery-footer {
    display:
        flex;

    flex-direction:
        column;

    align-items:
        center;

    justify-content:
        center;

    gap:
        6px;

    padding:
        14px 16px;

    text-align:
        center;

    font-size:
        0.7rem;
}


/* ============================================================
   17. SMALL PHONES — 320–359px
   ============================================================ */

@media (max-width: 359px) {

    .mastery-page {
        width:
            calc(100% - 20px);

        padding-top:
            16px;
    }

    .mastery-hero {
        padding:
            26px 14px;
    }

    .mastery-hero h1 {
        font-size:
            1.75rem;
    }

    .mastery-feature-card,
    .mastery-card,
    .mastery-option-card {
        padding:
            15px;
    }
}


/* ============================================================
   18. LARGE PHONES — 400px+
   ============================================================ */

@media (min-width: 400px) {

    .mastery-page {
        width:
            calc(100% - 32px);
    }

    .mastery-hero {
        padding:
            34px 22px;
    }

    .mastery-feature-card,
    .mastery-card,
    .mastery-option-card {
        padding:
            20px;
    }
}


/* ============================================================
   19. TABLET — PROGRESSIVE ENHANCEMENT
   ============================================================ */

@media (min-width: 640px) {

    .mastery-header {
        min-height:
            64px;

        padding-left:
            28px;

        padding-right:
            28px;
    }

    .mastery-page {
        width:
            calc(100% - 48px);

        padding-top:
            42px;

        padding-bottom:
            52px;
    }

    .mastery-feature-grid {
        grid-template-columns:
            repeat(3, 1fr);

        gap:
            14px;
    }

    .mastery-option-grid {
        grid-template-columns:
            repeat(2, 1fr);

        gap:
            14px;
    }

    .mastery-dashboard-grid {
        grid-template-columns:
            repeat(2, 1fr);

        gap:
            14px;
    }

    .mastery-hero {
        padding:
            48px 32px;
    }

    .mastery-hero .mastery-button {
        width:
            auto;
    }

    .mastery-card--recommendation {
        flex-direction:
            row;

        align-items:
            center;

        justify-content:
            space-between;
    }

    .mastery-card--recommendation .mastery-button {
        width:
            auto;

        flex-shrink:
            0;
    }

    .mastery-question-actions {
        grid-template-columns:
            repeat(2, 1fr);
    }

    .mastery-footer {
        flex-direction:
            row;

        justify-content:
            space-between;

        text-align:
            left;
    }
}


/* ============================================================
   20. DESKTOP — PROGRESSIVE ENHANCEMENT
   ============================================================ */

@media (min-width: 900px) {

    .mastery-header {
        min-height:
            72px;

        padding-left:
            40px;

        padding-right:
            40px;
    }

    .mastery-page {
        width:
            min(
                calc(100% - 64px),
                var(--mastery-content-width)
            );

        padding-top:
            56px;

        padding-bottom:
            72px;
    }

    .mastery-hero {
        padding:
            64px 48px;

        border-radius:
            20px;
    }

    .mastery-hero h1,
    .mastery-section-heading h1,
    .mastery-dashboard-header h1 {
        font-size:
            3.4rem;
    }

    .mastery-dashboard-grid {
        grid-template-columns:
            repeat(3, 1fr);
    }

    .mastery-question-card {
        padding:
            28px;
    }
}


/* ============================================================
   21. VERY LARGE DESKTOP
   ============================================================ */

@media (min-width: 1200px) {

    .mastery-page {
        padding-top:
            64px;
    }

    .mastery-hero {
        padding:
            76px 60px;
    }
}


/* ============================================================
   22. REDUCED MOTION
   ============================================================ */

@media (prefers-reduced-motion: reduce) {

    *,
    *::before,
    *::after {
        scroll-behavior:
            auto !important;

        animation-duration:
            0.01ms !important;

        animation-iteration-count:
            1 !important;

        transition-duration:
            0.01ms !important;
    }
}


/* ============================================================
   23. LANDSCAPE PHONE
   ============================================================ */

@media (
    max-width: 767px
) and (
    orientation: landscape
) {

    .mastery-hero {
        padding:
            24px 20px;
    }

    .mastery-page {
        padding-top:
            18px;
    }
}


/* ============================================================
   END MOBILE-FIRST SYSTEM
   ============================================================ */
