/* ============================================================
   SJMaths Maths Mastery
   Core visual system
   ============================================================ */

:root {

    --mastery-primary: #e74c3c;
    --mastery-primary-dark: #c0392b;
    --mastery-secondary: #f39c12;

    --mastery-bg: #f7f7f7;
    --mastery-surface: #ffffff;
    --mastery-surface-soft: #fff8f5;

    --mastery-text: #202124;
    --mastery-text-soft: #626262;
    --mastery-border: #e4e4e4;

    --mastery-radius-sm: 10px;
    --mastery-radius-md: 16px;
    --mastery-radius-lg: 24px;

    --mastery-shadow:
        0 8px 30px rgba(0, 0, 0, 0.07);

    --mastery-content-width: 1180px;
}


* {
    box-sizing: border-box;
}


html {
    scroll-behavior: smooth;
}


body {

    margin: 0;

    min-width: 320px;

    background:
        var(--mastery-bg);

    color:
        var(--mastery-text);

    font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    line-height: 1.55;
}


button,
input,
select,
textarea {

    font: inherit;
}


button {

    cursor: pointer;
}


a {

    color: inherit;
}


.mastery-app {

    min-height: 100vh;

    display: flex;

    flex-direction: column;
}


.mastery-header {

    position: sticky;

    top: 0;

    z-index: 50;

    display: flex;

    align-items: center;

    justify-content: space-between;

    min-height: 64px;

    padding:
        12px 18px;

    background:
        rgba(255, 255, 255, 0.96);

    border-bottom:
        1px solid var(--mastery-border);

    backdrop-filter:
        blur(12px);
}


.mastery-brand {

    display: inline-flex;

    flex-direction: column;

    text-decoration: none;

    line-height: 1.15;
}


.mastery-brand__name {

    font-size: 1.05rem;

    font-weight: 900;

    color:
        var(--mastery-primary);
}


.mastery-brand__product {

    margin-top: 3px;

    font-size: 0.72rem;

    font-weight: 700;

    color:
        var(--mastery-text-soft);

    text-transform: uppercase;

    letter-spacing:
        0.08em;
}


.mastery-header__actions {

    display: flex;

    align-items: center;

    gap: 8px;
}


.mastery-icon-button {

    min-height: 38px;

    padding:
        8px 12px;

    border:
        1px solid var(--mastery-border);

    border-radius:
        var(--mastery-radius-sm);

    background:
        var(--mastery-surface);

    color:
        var(--mastery-text);

    font-weight: 700;
}


.mastery-main {

    flex: 1;

    width: 100%;
}


.mastery-screen {

    width: 100%;
}


.mastery-page {

    width: min(
        calc(100% - 32px),
        var(--mastery-content-width)
    );

    margin:
        0 auto;

    padding:
        34px 0 60px;
}


.mastery-hero {

    padding:
        42px 24px;

    text-align: center;

    background:
        linear-gradient(
            145deg,
            #fff,
            var(--mastery-surface-soft)
        );

    border:
        1px solid var(--mastery-border);

    border-radius:
        var(--mastery-radius-lg);

    box-shadow:
        var(--mastery-shadow);
}


.mastery-eyebrow {

    display: inline-block;

    margin-bottom: 10px;

    color:
        var(--mastery-primary);

    font-size: 0.75rem;

    font-weight: 900;

    letter-spacing:
        0.1em;

    text-transform:
        uppercase;
}


.mastery-hero h1,
.mastery-section-heading h1,
.mastery-dashboard-header h1 {

    margin:
        0;

    font-size:
        clamp(2rem, 7vw, 3.4rem);

    line-height:
        1.08;

    letter-spacing:
        -0.04em;
}


.mastery-hero__text {

    max-width: 650px;

    margin:
        18px auto 26px;

    color:
        var(--mastery-text-soft);

    font-size:
        1.05rem;
}


.mastery-section-heading {

    margin-bottom:
        28px;
}


.mastery-section-heading p {

    max-width: 680px;

    margin:
        12px 0 0;

    color:
        var(--mastery-text-soft);
}


.mastery-button {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    min-height: 46px;

    padding:
        11px 18px;

    border:
        0;

    border-radius:
        12px;

    font-weight:
        800;

    transition:
        transform 0.16s ease,
        box-shadow 0.16s ease,
        background 0.16s ease;
}


.mastery-button:hover {

    transform:
        translateY(-1px);
}


.mastery-button--primary {

    background:
        var(--mastery-primary);

    color:
        #ffffff;

    box-shadow:
        0 7px 18px
        rgba(231, 76, 60, 0.22);
}


.mastery-button--primary:hover {

    background:
        var(--mastery-primary-dark);
}


.mastery-button--secondary {

    background:
        var(--mastery-surface);

    color:
        var(--mastery-text);

    border:
        1px solid var(--mastery-border);
}


.mastery-feature-grid,
.mastery-option-grid,
.mastery-dashboard-grid {

    display: grid;

    gap: 14px;
}


.mastery-feature-grid {

    margin-top:
        18px;
}


.mastery-feature-card,
.mastery-option-card,
.mastery-card {

    background:
        var(--mastery-surface);

    border:
        1px solid var(--mastery-border);

    border-radius:
        var(--mastery-radius-md);

    box-shadow:
        var(--mastery-shadow);
}


.mastery-feature-card {

    padding:
        22px;
}


.mastery-feature-card__icon {

    width: 38px;

    height: 38px;

    display: grid;

    place-items: center;

    margin-bottom:
        16px;

    border-radius:
        10px;

    background:
        #fff1ed;

    color:
        var(--mastery-primary);

    font-size:
        0.75rem;

    font-weight:
        900;
}


.mastery-feature-card h2,
.mastery-feature-card p {

    margin:
        0;
}


.mastery-feature-card p {

    margin-top:
        8px;

    color:
        var(--mastery-text-soft);
}


.mastery-option-card {

    width: 100%;

    padding:
        22px;

    text-align:
        left;

    color:
        var(--mastery-text);

    transition:
        transform 0.16s ease,
        border-color 0.16s ease,
        box-shadow 0.16s ease;
}


.mastery-option-card:hover {

    transform:
        translateY(-2px);

    border-color:
        var(--mastery-primary);

    box-shadow:
        0 12px 30px
        rgba(0, 0, 0, 0.09);
}


.mastery-option-card strong,
.mastery-option-card span {

    display: block;
}


.mastery-option-card strong {

    font-size:
        1.05rem;
}


.mastery-option-card span {

    margin-top:
        7px;

    color:
        var(--mastery-text-soft);

    font-size:
        0.92rem;
}


.mastery-card {

    padding:
        22px;
}


.mastery-card__label {

    display: block;

    margin-bottom:
        8px;

    color:
        var(--mastery-text-soft);

    font-size:
        0.75rem;

    font-weight:
        800;

    text-transform:
        uppercase;

    letter-spacing:
        0.07em;
}


.mastery-card__value {

    display: block;

    font-size:
        2rem;

    color:
        var(--mastery-primary);
}


.mastery-card p {

    margin:
        8px 0 0;

    color:
        var(--mastery-text-soft);
}


.mastery-card--recommendation {

    display: flex;

    flex-direction: column;

    gap: 20px;

    margin-top:
        16px;

    background:
        linear-gradient(
            145deg,
            #ffffff,
            #fff8f5
        );
}


.mastery-card--diagnostic {

    max-width:
        760px;

    margin:
        0 auto;
}


.mastery-info-list {

    display:
        grid;

    gap:
        12px;

    margin:
        24px 0;
}


.mastery-info-list div {

    padding:
        14px;

    border:
        1px solid var(--mastery-border);

    border-radius:
        12px;

    background:
        #fafafa;
}


.mastery-info-list strong,
.mastery-info-list span {

    display:
        block;
}


.mastery-info-list span {

    margin-top:
        3px;

    color:
        var(--mastery-text-soft);
}


.mastery-empty {

    margin-top:
        18px;

    padding:
        18px;

    border:
        1px dashed var(--mastery-border);

    border-radius:
        var(--mastery-radius-md);

    color:
        var(--mastery-text-soft);

    background:
        var(--mastery-surface);
}


.mastery-status {

    position:
        fixed;

    left:
        50%;

    bottom:
        20px;

    z-index:
        100;

    width:
        min(
            calc(100% - 32px),
            500px
        );

    transform:
        translateX(-50%);

    padding:
        12px 16px;

    border:
        1px solid var(--mastery-border);

    border-radius:
        12px;

    background:
        #ffffff;

    box-shadow:
        0 10px 35px
        rgba(0, 0, 0, 0.12);

    font-weight:
        700;

    text-align:
        center;
}


.mastery-status[data-type="error"] {

    border-color:
        #e74c3c;

    color:
        #b83227;
}


.mastery-status[data-type="success"] {

    border-color:
        #5aa469;

    color:
        #367442;
}


.mastery-footer {

    display:
        flex;

    justify-content:
        space-between;

    gap:
        14px;

    padding:
        16px 20px;

    border-top:
        1px solid var(--mastery-border);

    background:
        #ffffff;

    color:
        var(--mastery-text-soft);

    font-size:
        0.78rem;
}
