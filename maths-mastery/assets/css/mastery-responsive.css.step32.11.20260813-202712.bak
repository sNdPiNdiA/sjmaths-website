/* ============================================================
   SJMaths Maths Mastery
   Responsive layout
   ============================================================ */

@media (min-width: 640px) {

    .mastery-header {

        padding-left:
            28px;

        padding-right:
            28px;
    }


    .mastery-page {

        padding-top:
            48px;
    }


    .mastery-feature-grid {

        grid-template-columns:
            repeat(3, 1fr);
    }


    .mastery-option-grid {

        grid-template-columns:
            repeat(2, 1fr);
    }


    .mastery-dashboard-grid {

        grid-template-columns:
            repeat(3, 1fr);
    }


    .mastery-card--recommendation {

        flex-direction:
            row;

        align-items:
            center;

        justify-content:
            space-between;
    }


    .mastery-card--recommendation .mastery-button {

        flex-shrink:
            0;
    }
}


@media (min-width: 900px) {

    .mastery-header {

        min-height:
            72px;

        padding-left:
            40px;

        padding-right:
            40px;
    }


    .mastery-page {

        width:
            min(
                calc(100% - 64px),
                var(--mastery-content-width)
            );

        padding-top:
            64px;
    }


    .mastery-hero {

        padding:
            72px 50px;
    }


    .mastery-hero h1,
    .mastery-section-heading h1,
    .mastery-dashboard-header h1 {

        font-size:
            3.6rem;
    }
}


@media (max-width: 639px) {

    .mastery-footer {

        flex-direction:
            column;

        text-align:
            center;
    }


    .mastery-dashboard-actions {

        width:
            100%;
    }


    .mastery-dashboard-actions .mastery-button {

        width:
            100%;
    }
}
