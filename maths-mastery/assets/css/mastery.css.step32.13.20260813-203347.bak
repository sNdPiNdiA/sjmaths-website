/* ============================================================
   SJMaths MATHS MASTERY
   STEP 32.12
   CORE DESIGN SYSTEM
   ============================================================ */

:root {

    --mastery-red: #e94b3c;
    --mastery-red-dark: #cf3e31;
    --mastery-orange: #f39a2f;

    --mastery-black: #171717;
    --mastery-text: #242424;
    --mastery-muted: #6f6f6f;
    --mastery-soft: #979797;

    --mastery-bg: #f7f7f5;
    --mastery-surface: #ffffff;
    --mastery-surface-soft: #fff8f5;

    --mastery-border: #e8e8e5;

    --mastery-shadow:
        0 10px 30px rgba(0,0,0,.055);

    --mastery-shadow-lg:
        0 20px 55px rgba(0,0,0,.08);

    --mastery-radius-sm: 10px;
    --mastery-radius-md: 16px;
    --mastery-radius-lg: 22px;

    --mastery-content-width: 1120px;

    --mastery-font:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
}


/* ============================================================
   RESET
   ============================================================ */

*,
*::before,
*::after {
    box-sizing: border-box;
}

html {
    font-family: var(--mastery-font);
    background: var(--mastery-bg);
    color: var(--mastery-text);
    text-rendering: optimizeLegibility;
}

body {
    margin: 0;
    min-width: 320px;
    min-height: 100dvh;
    background: var(--mastery-bg);
}

button,
input,
select,
textarea {
    font: inherit;
}

button {
    border: 0;
}

a {
    color: inherit;
}


/* ============================================================
   APP
   ============================================================ */

.mastery-app {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
}


/* ============================================================
   HEADER
   ============================================================ */

.mastery-header {
    min-height: 64px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 10px 16px;

    background: rgba(255,255,255,.94);

    border-bottom:
        1px solid var(--mastery-border);

    position: sticky;
    top: 0;
    z-index: 100;

    backdrop-filter: blur(16px);
}

.mastery-brand {
    display: flex;
    align-items: center;
    gap: 9px;

    text-decoration: none;
}

.mastery-brand__mark {

    width: 34px;
    height: 34px;

    display: grid;
    place-items: center;

    border-radius: 10px;

    background:
        linear-gradient(
            145deg,
            var(--mastery-red),
            var(--mastery-orange)
        );

    color: white;

    font-size: .72rem;
    font-weight: 950;
    letter-spacing: -.03em;
}

.mastery-brand__text {
    display: flex;
    flex-direction: column;
}

.mastery-brand__text strong {
    font-size: .92rem;
    line-height: 1;
    font-weight: 900;
}

.mastery-brand__text small {
    margin-top: 4px;

    font-size: .58rem;
    font-weight: 800;

    letter-spacing: .08em;
    text-transform: uppercase;

    color: var(--mastery-muted);
}

.mastery-nav {
    display: flex;
    gap: 7px;
}

.mastery-nav-button {
    min-height: 40px;

    padding:
        0 12px;

    border:
        1px solid var(--mastery-border);

    border-radius: 10px;

    background: white;

    color:
        var(--mastery-text);

    font-size: .78rem;
    font-weight: 800;

    cursor: pointer;
}


/* ============================================================
   MAIN
   ============================================================ */

.mastery-main {
    flex: 1;
}

.mastery-screen {
    width: 100%;
}


/* ============================================================
   LOADING
   ============================================================ */

.mastery-loading {
    min-height: 70vh;

    display: grid;
    place-content: center;
    justify-items: center;

    gap: 14px;

    color: var(--mastery-muted);

    font-size: .9rem;
}

.mastery-loading__spinner {

    width: 28px;
    height: 28px;

    border:
        3px solid #eeeeec;

    border-top-color:
        var(--mastery-red);

    border-radius: 50%;

    animation:
        mastery-spin .75s linear infinite;
}

@keyframes mastery-spin {
    to {
        transform: rotate(360deg);
    }
}


/* ============================================================
   PAGE
   ============================================================ */

.mastery-page {

    width:
        min(
            calc(100% - 28px),
            var(--mastery-content-width)
        );

    margin:
        0 auto;

    padding:
        22px 0 40px;
}


/* ============================================================
   HERO
   ============================================================ */

.mastery-hero {

    position: relative;

    overflow: hidden;

    padding:
        28px 20px;

    border:
        1px solid #f0ded8;

    border-radius:
        var(--mastery-radius-lg);

    background:
        linear-gradient(
            145deg,
            #fffdfc 0%,
            #fff7f3 100%
        );

    box-shadow:
        var(--mastery-shadow-lg);
}

.mastery-hero::after {

    content: "";

    position: absolute;

    width: 180px;
    height: 180px;

    right: -80px;
    top: -80px;

    border-radius: 50%;

    background:
        rgba(233,75,60,.08);

    pointer-events: none;
}

.mastery-hero__content {
    position: relative;
    z-index: 2;
}

.mastery-eyebrow {

    display: inline-flex;

    align-items: center;

    gap: 7px;

    margin-bottom:
        12px;

    color:
        var(--mastery-red);

    font-size:
        .68rem;

    font-weight:
        900;

    letter-spacing:
        .12em;

    text-transform:
        uppercase;
}

.mastery-eyebrow::before {

    content: "";

    width: 6px;
    height: 6px;

    border-radius: 50%;

    background:
        var(--mastery-red);
}

.mastery-hero h1 {

    max-width: 650px;

    margin:
        0;

    color:
        var(--mastery-black);

    font-size:
        clamp(
            2.15rem,
            10vw,
            4.1rem
        );

    line-height:
        .98;

    letter-spacing:
        -.055em;

    font-weight:
        950;
}

.mastery-hero__text {

    max-width:
        560px;

    margin:
        16px 0 22px;

    color:
        var(--mastery-muted);

    font-size:
        .95rem;

    line-height:
        1.55;
}


/* ============================================================
   BUTTON
   ============================================================ */

.mastery-button {

    min-height:
        48px;

    display:
        inline-flex;

    align-items:
        center;

    justify-content:
        center;

    gap:
        8px;

    padding:
        0 18px;

    border-radius:
        11px;

    background:
        var(--mastery-red);

    color:
        white;

    font-size:
        .86rem;

    font-weight:
        900;

    cursor:
        pointer;

    box-shadow:
        0 8px 20px rgba(233,75,60,.18);

    transition:
        transform .18s ease,
        box-shadow .18s ease,
        background .18s ease;
}

.mastery-button:hover {
    background:
        var(--mastery-red-dark);

    transform:
        translateY(-1px);

    box-shadow:
        0 12px 25px rgba(233,75,60,.22);
}

.mastery-button:active {
    transform:
        translateY(0);
}


/* ============================================================
   JOURNEY
   ============================================================ */

.mastery-journey {

    margin-top:
        14px;

    display:
        grid;

    gap:
        10px;
}

.mastery-journey-card {

    position:
        relative;

    padding:
        17px;

    border:
        1px solid var(--mastery-border);

    border-radius:
        var(--mastery-radius-md);

    background:
        white;

    box-shadow:
        var(--mastery-shadow);

    transition:
        transform .18s ease,
        box-shadow .18s ease;
}

.mastery-journey-card:hover {

    transform:
        translateY(-2px);

    box-shadow:
        var(--mastery-shadow-lg);
}

.mastery-journey-card__number {

    width:
        30px;

    height:
        30px;

    display:
        grid;

    place-items:
        center;

    margin-bottom:
        14px;

    border-radius:
        9px;

    background:
        #fff0ec;

    color:
        var(--mastery-red);

    font-size:
        .68rem;

    font-weight:
        950;
}

.mastery-journey-card h2 {

    margin:
        0 0 6px;

    font-size:
        1rem;

    font-weight:
        900;
}

.mastery-journey-card p {

    margin:
        0;

    color:
        var(--mastery-muted);

    font-size:
        .82rem;

    line-height:
        1.5;
}


/* ============================================================
   SECTION
   ============================================================ */

.mastery-section {

    margin-top:
        30px;
}

.mastery-section-heading {

    margin-bottom:
        14px;
}

.mastery-section-heading span {

    display:
        block;

    margin-bottom:
        5px;

    color:
        var(--mastery-red);

    font-size:
        .65rem;

    font-weight:
        900;

    letter-spacing:
        .1em;

    text-transform:
        uppercase;
}

.mastery-section-heading h2 {

    margin:
        0;

    font-size:
        1.35rem;

    letter-spacing:
        -.025em;

    font-weight:
        900;
}


/* ============================================================
   FEATURE CARDS
   ============================================================ */

.mastery-feature-grid {

    display:
        grid;

    gap:
        10px;
}

.mastery-feature-card {

    padding:
        17px;

    border:
        1px solid var(--mastery-border);

    border-radius:
        var(--mastery-radius-md);

    background:
        white;
}

.mastery-feature-card h3 {

    margin:
        0 0 7px;

    font-size:
        .98rem;

    font-weight:
        900;
}

.mastery-feature-card p {

    margin:
        0;

    color:
        var(--mastery-muted);

    font-size:
        .8rem;

    line-height:
        1.5;
}


/* ============================================================
   BOTTOM NAV
   ============================================================ */

.mastery-bottom-nav {

    position:
        fixed;

    left:
        10px;

    right:
        10px;

    bottom:
        10px;

    z-index:
        120;

    padding:
        7px;

    display:
        grid;

    grid-template-columns:
        repeat(3,1fr);

    gap:
        4px;

    border:
        1px solid var(--mastery-border);

    border-radius:
        16px;

    background:
        rgba(255,255,255,.96);

    box-shadow:
        0 12px 35px rgba(0,0,0,.12);

    backdrop-filter:
        blur(16px);
}

.mastery-bottom-nav button {

    min-height:
        50px;

    display:
        flex;

    flex-direction:
        column;

    align-items:
        center;

    justify-content:
        center;

    gap:
        3px;

    border-radius:
        11px;

    background:
        transparent;

    color:
        var(--mastery-muted);

    font-size:
        .62rem;

    font-weight:
        800;
}

.mastery-bottom-nav__icon {

    font-size:
        .75rem;

    font-weight:
        950;
}


/* ============================================================
   FOOTER
   ============================================================ */

.mastery-footer {

    display:
        flex;

    justify-content:
        center;

    gap:
        8px;

    padding:
        18px 16px 90px;

    color:
        var(--mastery-soft);

    font-size:
        .62rem;

    font-weight:
        700;
}


/* ============================================================
   STATUS
   ============================================================ */

.mastery-status {

    position:
        fixed;

    left:
        50%;

    bottom:
        78px;

    transform:
        translateX(-50%);

    width:
        calc(100% - 24px);

    max-width:
        480px;

    padding:
        12px 14px;

    border:
        1px solid var(--mastery-border);

    border-radius:
        12px;

    background:
        white;

    box-shadow:
        0 12px 30px rgba(0,0,0,.12);

    font-size:
        .8rem;

    font-weight:
        750;

    z-index:
        200;
}


/* ============================================================
   ACCESSIBILITY
   ============================================================ */

button:focus-visible,
a:focus-visible {

    outline:
        3px solid rgba(233,75,60,.25);

    outline-offset:
        3px;
}


/* ============================================================
   DESKTOP
   ============================================================ */

@media (min-width: 700px) {

    .mastery-header {
        padding:
            12px 28px;
    }

    .mastery-page {
        padding-top:
            38px;
    }

    .mastery-hero {
        padding:
            48px 44px;
    }

    .mastery-journey {

        grid-template-columns:
            repeat(3,1fr);

        gap:
            12px;
    }

    .mastery-feature-grid {

        grid-template-columns:
            repeat(3,1fr);

        gap:
            12px;
    }

    .mastery-footer {
        padding-bottom:
            20px;
    }

    .mastery-bottom-nav {
        display:
            none;
    }
}


@media (min-width: 1000px) {

    .mastery-header {
        min-height:
            72px;

        padding-left:
            40px;

        padding-right:
            40px;
    }

    .mastery-page {
        padding-top:
            55px;

        padding-bottom:
            65px;
    }

    .mastery-hero {
        padding:
            64px 62px;
    }

    .mastery-hero h1 {
        font-size:
            4.25rem;
    }

    .mastery-journey-card {
        padding:
            21px;
    }
}
