/* ============================================================
   STEP 32.12
   MOBILE-FIRST RESPONSIVE OVERRIDES
   ============================================================ */

html,
body {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
}

.mastery-page,
.mastery-hero,
.mastery-journey,
.mastery-feature-grid {
    min-width: 0;
}

.mastery-hero,
.mastery-journey-card,
.mastery-feature-card {
    overflow: hidden;
}

.katex-display,
.math-display,
.math-expression {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
}


@media (max-width: 359px) {

    .mastery-page {
        width:
            calc(100% - 20px);
    }

    .mastery-header {
        padding:
            9px 11px;
    }

    .mastery-hero {
        padding:
            24px 16px;
    }

    .mastery-hero h1 {
        font-size:
            2rem;
    }

    .mastery-journey-card,
    .mastery-feature-card {
        padding:
            15px;
    }
}


@media (min-width: 390px) {

    .mastery-page {
        width:
            calc(100% - 32px);
    }
}


@media (min-width: 768px) {

    .mastery-page {
        width:
            calc(100% - 56px);
    }
}


@media (min-width: 1100px) {

    .mastery-page {
        width:
            calc(100% - 80px);
    }
}


@media (prefers-reduced-motion: reduce) {

    *,
    *::before,
    *::after {

        animation-duration:
            .01ms !important;

        transition-duration:
            .01ms !important;
    }
}
