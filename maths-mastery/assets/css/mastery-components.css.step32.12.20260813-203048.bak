/* ============================================================
   SJMaths Maths Mastery
   Component refinements
   ============================================================ */

.mastery-dashboard-header {

    display:
        flex;

    flex-direction:
        column;

    gap:
        18px;

    margin-bottom:
        20px;
}


.mastery-dashboard-header p {

    margin:
        10px 0 0;

    color:
        var(--mastery-text-soft);
}


.mastery-dashboard-actions {

    display:
        flex;

    gap:
        8px;

    flex-wrap:
        wrap;
}


.mastery-card h2 {

    margin:
        0;

    font-size:
        1.25rem;

    line-height:
        1.25;
}


.mastery-card--recommendation .mastery-button {

    align-self:
        flex-start;
}


.mastery-loading {

    min-height:
        55vh;

    display:
        grid;

    place-items:
        center;

    align-content:
        center;

    gap:
        12px;

    color:
        var(--mastery-text-soft);
}


.mastery-loading__spinner {

    width:
        34px;

    height:
        34px;

    border:
        3px solid var(--mastery-border);

    border-top-color:
        var(--mastery-primary);

    border-radius:
        50%;

    animation:
        mastery-spin 0.8s linear infinite;
}


@keyframes mastery-spin {

    to {
        transform:
            rotate(360deg);
    }
}


button:focus-visible,
a:focus-visible {

    outline:
        3px solid
        rgba(231, 76, 60, 0.35);

    outline-offset:
        3px;
}
