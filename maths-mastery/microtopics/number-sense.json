        {
            "id": "place-value",
            "title": "1. Place Value & Face Value",
            "standard": {
                "explanation": "<h3>The Foundation of Mathematics</h3><p>Number sense is the ability to understand, relate, and connect numbers.</p><h4>Place Value</h4><p>Understanding the value of each digit based on its position.</p><ul><li><strong>Units (Ones):</strong> The rightmost digit.</li><li><strong>Tens:</strong> The second digit from right.</li><li><strong>Hundreds:</strong> The third digit.</li></ul><div class='interactive-card'><p>In <strong>4,321</strong>:</p><ul><li>4 is 4000</li><li>3 is 300</li><li>2 is 20</li><li>1 is 1</li></ul></div>",
                "practice": {
                    "level1": [
                        {
                            "q": "Value of 7 in 7,532?",
                            "options": [
                                "7",
                                "70",
                                "700",
                                "7000"
                            ],
                            "correct": 3,
                            "answer": "7000"
                        },
                        {
                            "q": "Value of 0 in 5,023?",
                            "options": [
                                "0",
                                "10",
                                "100",
                                "Zero"
                            ],
                            "correct": 2,
                            "answer": "100"
                        }
                    ],
                    "level2": [
                        {
                            "q": "Write 5000 + 400 + 2 in standard form.",
                            "type": "input",
                            "answer": "5402"
                        },
                        {
                            "q": "How many tens in 520?",
                            "type": "input",
                            "answer": "52"
                        }
                    ]
                },
                "test": [
                    {
                        "q": "Value of 9 in 19,234?",
                        "options": [
                            "90",
                            "900",
                            "9000",
                            "9"
                        ],
                        "correct": 2,
                        "answer": "9000"
                    },
                    {
                        "q": "Which digit is in the hundreds place in 5,678?",
                        "options": [
                            "5",
                            "6",
                            "7",
                            "8"
                        ],
                        "correct": 1,
                        "answer": "6"
                    },
                    {
                        "q": "What is the face value of 3 in 3,456?",
                        "type": "input",
                        "answer": "3"
                    },
                    {
                        "q": "Write 7000 + 50 + 9 in standard form.",
                        "type": "input",
                        "answer": "7059"
                    },
                    {
                        "q": "Value of 0 in 405?",
                        "options": [
                            "0",
                            "10",
