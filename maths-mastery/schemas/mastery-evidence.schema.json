{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sjmaths.com/schemas/maths-mastery/mastery-evidence.schema.json",

  "title": "SJMaths Maths Mastery Evidence",
  "description": "Student evidence collected from learning, practice and tests.",
  "type": "object",

  "required": [
    "version",
    "topicId",
    "skills",
    "concepts",
    "attempts"
  ],

  "properties": {

    "version": {
      "type": "string"
    },

    "topicId": {
      "type": "string"
    },

    "skills": {
      "type": "object",

      "additionalProperties": {
        "$ref": "#/$defs/skillEvidence"
      }
    },

    "concepts": {
      "type": "object",

      "additionalProperties": {
        "$ref": "#/$defs/conceptEvidence"
      }
    },

    "attempts": {
      "type": "array",

      "items": {
        "$ref": "#/$defs/attempt"
      }
    }
  },

  "$defs": {

    "skillEvidence": {
      "type": "object",

      "required": [
        "status",
        "score",
        "evidenceCount"
      ],

      "properties": {

        "status": {
          "type": "string",
          "enum": [
            "not-started",
            "learning",
            "developing",
            "proficient",
            "mastered"
          ]
        },

        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },

        "evidenceCount": {
          "type": "integer",
          "minimum": 0
        },

        "correct": {
          "type": "integer",
          "minimum": 0
        },

        "incorrect": {
          "type": "integer",
          "minimum": 0
        },

        "averageTimeSeconds": {
          "type": "number",
          "minimum": 0
        },

        "lastAttemptAt": {
          "type": "string"
        }
      },

      "additionalProperties": false
    },

    "conceptEvidence": {
      "type": "object",

      "required": [
        "status",
        "score"
      ],

      "properties": {

        "status": {
          "type": "string",
          "enum": [
            "not-started",
            "learning",
            "developing",
            "proficient",
            "mastered"
          ]
        },

        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },

        "viewed": {
          "type": "boolean"
        },

        "examplesCompleted": {
          "type": "integer",
          "minimum": 0
        },

        "practiceAttempts": {
          "type": "integer",
          "minimum": 0
        }
      },

      "additionalProperties": false
    },

    "attempt": {
      "type": "object",

      "required": [
        "id",
        "itemId",
        "itemType",
        "result",
        "timestamp"
      ],

      "properties": {

        "id": {
          "type": "string"
        },

        "itemId": {
          "type": "string"
        },

        "itemType": {
          "type": "string",
          "enum": [
            "concept",
            "example",
            "practice",
            "mini-test"
          ]
        },

        "result": {
          "type": "string",
          "enum": [
            "completed",
            "correct",
            "incorrect",
            "passed",
            "failed"
          ]
        },

        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },

        "timeSeconds": {
          "type": "number",
          "minimum": 0
        },

        "skillIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },

        "conceptIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },

        "timestamp": {
          "type": "string"
        }
      },

      "additionalProperties": false
    }
  },

  "additionalProperties": false
}
