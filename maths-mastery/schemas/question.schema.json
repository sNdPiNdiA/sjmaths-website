{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SJMaths Question",
  "type": "object",

  "required": [
    "id",
    "version",
    "topicId",
    "conceptId",
    "skillIds",
    "questionType",
    "difficulty",
    "exams",
    "question",
    "answer",
    "solution",
    "metadata"
  ],

  "properties": {

    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },

    "version": {
      "type": "string"
    },

    "topicId": {
      "type": "string"
    },

    "conceptId": {
      "type": "string"
    },

    "skillIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },

    "questionType": {
      "type": "string",
      "enum": [
        "mcq",
        "numerical",
        "short-answer",
        "long-answer",
        "true-false",
        "assertion-reason",
        "case-study",
        "multi-select"
      ]
    },

    "difficulty": {
      "type": "string",
      "enum": [
        "foundation",
        "basic",
        "intermediate",
        "advanced",
        "olympiad"
      ]
    },

    "exams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },

    "question": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {

        "text": {
          "type": "string",
          "minLength": 1
        },

        "language": {
          "type": "string",
          "enum": [
            "en",
            "hi",
            "bilingual"
          ]
        }
      }
    },

    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "properties": {

          "id": {
            "type": "string"
          },

          "text": {
            "type": "string"
          }
        }
      }
    },

    "answer": {
      "type": "object",
      "required": [
        "type",
        "value"
      ],
      "properties": {

        "type": {
          "type": "string"
        },

        "value": {}
      }
    },

    "solution": {
      "type": "object",
      "required": [
        "steps"
      ],
      "properties": {

        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "step",
              "text"
            ],
            "properties": {

              "step": {
                "type": "integer",
                "minimum": 1
              },

              "text": {
                "type": "string"
              }
            }
          }
        },

        "finalAnswer": {
          "type": "string"
        }
      }
    },

    "hints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "metadata": {

      "type": "object",

      "required": [
        "source",
        "authoringStatus"
      ],

      "properties": {

        "source": {
          "type": "string"
        },

        "sourceYear": {
          "type": [
            "integer",
            "null"
          ]
        },

        "authoringStatus": {
          "type": "string",
          "enum": [
            "draft",
            "reviewed",
            "verified",
            "published"
          ]
        },

        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },

  "additionalProperties": false
}
