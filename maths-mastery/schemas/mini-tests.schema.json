{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sjmaths.com/schemas/maths-mastery/mini-tests.schema.json",

  "title": "SJMaths Maths Mastery Mini Tests",
  "description": "Test definitions referencing practice question IDs.",
  "type": "object",

  "required": [
    "version",
    "topicId",
    "tests"
  ],

  "properties": {

    "version": {
      "type": "string"
    },

    "topicId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },

    "tests": {
      "type": "array",
      "minItems": 1,

      "items": {
        "$ref": "#/$defs/test"
      }
    }
  },

  "$defs": {

    "test": {
      "type": "object",

      "required": [
        "id",
        "title",
        "type",
        "difficulty",
        "questionIds",
        "settings"
      ],

      "properties": {

        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },

        "title": {
          "type": "string",
          "minLength": 1
        },

        "description": {
          "type": "string"
        },

        "type": {
          "type": "string",
          "enum": [
            "foundation",
            "intermediate",
            "advanced",
            "mixed",
            "competitive",
            "mastery"
          ]
        },

        "difficulty": {
          "type": "string",
          "enum": [
            "basic",
            "foundation",
            "intermediate",
            "advanced",
            "mixed",
            "exam-level"
          ]
        },

        "questionIds": {
          "type": "array",
          "minItems": 1,

          "items": {
            "type": "string"
          },

          "uniqueItems": true
        },

        "settings": {
          "$ref": "#/$defs/settings"
        },

        "mastery": {
          "$ref": "#/$defs/mastery"
        },

        "skills": {
          "type": "array",

          "items": {
            "type": "object",

            "required": [
              "id",
              "weight"
            ],

            "properties": {

              "id": {
                "type": "string"
              },

              "weight": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },

            "additionalProperties": false
          }
        },

        "difficultyDistribution": {
          "type": "object",

          "properties": {

            "basic": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },

            "foundation": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },

            "intermediate": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },

            "advanced": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },

            "exam-level": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },

          "additionalProperties": false
        },

        "examRelevance": {
          "type": "object",

          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      },

      "additionalProperties": false
    },

    "settings": {
      "type": "object",

      "required": [
        "questionCount",
        "timeLimitSeconds"
      ],

      "properties": {

        "questionCount": {
          "type": "integer",
          "minimum": 1
        },

        "timeLimitSeconds": {
          "type": "integer",
          "minimum": 30
        },

        "shuffleQuestions": {
          "type": "boolean"
        },

        "shuffleOptions": {
          "type": "boolean"
        },

        "showInstantFeedback": {
          "type": "boolean"
        },

        "allowRetry": {
          "type": "boolean"
        },

        "showSolutionsAfterSubmit": {
          "type": "boolean"
        }
      },

      "additionalProperties": false
    },

    "mastery": {
      "type": "object",

      "required": [
        "minimumScore",
        "minimumAccuracy"
      ],

      "properties": {

        "minimumScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },

        "minimumAccuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },

        "requiresAllQuestionsAttempted": {
          "type": "boolean"
        }
      },

      "additionalProperties": false
    }
  },

  "additionalProperties": false
}
