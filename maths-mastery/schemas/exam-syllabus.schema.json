{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sjmaths.com/schemas/exam-syllabus.schema.json",

  "title": "SJMaths Versioned Exam Syllabus",

  "type": "object",

  "required": [
    "schemaVersion",
    "exam",
    "syllabus"
  ],

  "properties": {

    "schemaVersion": {
      "type": "string",
      "minLength": 1
    },

    "exam": {
      "$ref": "#/$defs/examReference"
    },

    "syllabus": {
      "$ref": "#/$defs/syllabus"
    }
  },

  "$defs": {

    "examReference": {

      "type": "object",

      "required": [
        "examId",
        "familyId",
        "name"
      ],

      "properties": {

        "examId": {
          "type": "string",
          "minLength": 1
        },

        "familyId": {
          "type": "string",
          "minLength": 1
        },

        "name": {
          "type": "string",
          "minLength": 1
        },

        "authority": {
          "type": "string"
        }
      }
    },


    "syllabus": {

      "type": "object",

      "required": [
        "version",
        "status",
        "sections",
        "verification"
      ],

      "properties": {

        "version": {
          "type": "string",
          "minLength": 1
        },

        "effectiveFrom": {
          "type": [
            "string",
            "null"
          ]
        },

        "effectiveTo": {
          "type": [
            "string",
            "null"
          ]
        },

        "status": {
          "type": "string",

          "enum": [
            "draft",
            "research",
            "partially-verified",
            "verified",
            "superseded"
          ]
        },

        "sections": {

          "type": "array",

          "items": {
            "$ref": "#/$defs/section"
          }
        },

        "verification": {
          "$ref": "#/$defs/verification"
        },

        "notes": {
          "type": "array",

          "items": {
            "type": "string"
          }
        }
      }
    },


    "section": {

      "type": "object",

      "required": [
        "id",
        "name",
        "order",
        "topics"
      ],

      "properties": {

        "id": {
          "type": "string",
          "minLength": 1
        },

        "name": {
          "type": "string",
          "minLength": 1
        },

        "order": {
          "type": "integer",
          "minimum": 1
        },

        "topics": {

          "type": "array",

          "items": {
            "$ref": "#/$defs/topicMapping"
          }
        }
      }
    },


    "topicMapping": {

      "type": "object",

      "required": [
        "topicId",
        "included"
      ],

      "properties": {

        "topicId": {
          "type": "string",
          "minLength": 1
        },

        "included": {
          "type": "boolean"
        },

        "level": {
          "type": [
            "string",
            "null"
          ]
        },

        "priority": {
          "type": [
            "string",
            "null"
          ]
        },

        "weight": {
          "type": [
            "number",
            "null"
          ]
        },

        "subtopics": {

          "type": "array",

          "items": {
            "$ref": "#/$defs/subtopicMapping"
          }
        }
      }
    },


    "subtopicMapping": {

      "type": "object",

      "required": [
        "subtopicId",
        "included"
      ],

      "properties": {

        "subtopicId": {
          "type": "string",
          "minLength": 1
        },

        "included": {
          "type": "boolean"
        },

        "level": {
          "type": [
            "string",
            "null"
          ]
        },

        "priority": {
          "type": [
            "string",
            "null"
          ]
        },

        "weight": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },


    "verification": {

      "type": "object",

      "required": [
        "status"
      ],

      "properties": {

        "status": {

          "type": "string",

          "enum": [
            "unverified",
            "partially-verified",
            "verified"
          ]
        },

        "sourceType": {

          "type": [
            "string",
            "null"
          ]
        },

        "sourceName": {

          "type": [
            "string",
            "null"
          ]
        },

        "sourceUrl": {

          "type": [
            "string",
            "null"
          ]
        },

        "checkedAt": {

          "type": [
            "string",
            "null"
          ]
        },

        "reviewedBy": {

          "type": [
            "string",
            "null"
          ]
        },

        "notes": {

          "type": "array",

          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
