{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sjmaths.com/schemas/maths-mastery/examples.schema.json",

  "title": "SJMaths Maths Mastery Solved Examples",
  "description": "Structured solved examples for a Maths Mastery topic.",
  "type": "object",

  "required": [
    "version",
    "topicId",
    "examples"
  ],

  "properties": {

    "version": {
      "type": "string"
    },

    "topicId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },

    "examples": {
      "type": "array",
      "minItems": 1,

      "items": {
        "$ref": "#/$defs/example"
      }
    }
  },

  "$defs": {

    "example": {
      "type": "object",

      "required": [
        "id",
        "title",
        "difficulty",
        "type",
        "question",
        "skills",
        "solution",
        "finalAnswer"
      ],

      "properties": {

        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },

        "title": {
          "type": "string",
          "minLength": 1
        },

        "difficulty": {
          "type": "string",
          "enum": [
            "basic",
            "foundation",
            "intermediate",
            "advanced",
            "exam-level"
          ]
        },

        "type": {
          "type": "string",
          "enum": [
            "conceptual",
            "direct",
            "application",
            "multi-step",
            "shortcut",
            "advanced",
            "exam-style"
          ]
        },

        "question": {
          "type": "string",
          "minLength": 1
        },

        "given": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },

        "required": {
          "type": "string"
        },

        "skills": {
          "type": "array",
          "minItems": 1,

          "items": {
            "type": "object",

            "required": [
              "id",
              "role"
            ],

            "properties": {

              "id": {
                "type": "string"
              },

              "role": {
                "type": "string",
                "enum": [
                  "primary",
                  "secondary"
                ]
              }
            },

            "additionalProperties": false
          }
        },

        "concepts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },

        "formula": {
          "type": "array",

          "items": {
            "type": "object",

            "required": [
              "latex"
            ],

            "properties": {

              "title": {
                "type": "string"
              },

              "latex": {
                "type": "string"
              }
            },

            "additionalProperties": false
          }
        },

        "approach": {
          "type": "string"
        },

        "solution": {
          "type": "array",
          "minItems": 1,

          "items": {
            "$ref": "#/$defs/solutionStep"
          }
        },

        "shortcut": {
          "type": "object",

          "properties": {

            "title": {
              "type": "string"
            },

            "explanation": {
              "type": "string"
            },

            "formula": {
              "type": "string"
            }
          },

          "required": [
            "title",
            "explanation"
          ],

          "additionalProperties": false
        },

        "alternativeMethod": {
          "type": "object",

          "properties": {

            "title": {
              "type": "string"
            },

            "steps": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },

          "required": [
            "title",
            "steps"
          ],

          "additionalProperties": false
        },

        "commonTrap": {
          "type": "string"
        },

        "verification": {
          "type": "string"
        },

        "finalAnswer": {
          "type": "string",
          "minLength": 1
        },

        "examRelevance": {
          "type": "object",

          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },

        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },

      "additionalProperties": false
    },

    "solutionStep": {
      "type": "object",

      "required": [
        "step",
        "title",
        "content"
      ],

      "properties": {

        "step": {
          "type": "integer",
          "minimum": 1
        },

        "title": {
          "type": "string",
          "minLength": 1
        },

        "content": {
          "type": "array",
          "minItems": 1,

          "items": {
            "$ref": "#/$defs/solutionBlock"
          }
        }
      },

      "additionalProperties": false
    },

    "solutionBlock": {
      "type": "object",

      "required": [
        "type"
      ],

      "properties": {

        "type": {
          "type": "string",
          "enum": [
            "text",
            "formula",
            "calculation",
            "equation",
            "note",
            "result"
          ]
        },

        "value": {
          "type": "string"
        },

        "latex": {
          "type": "string"
        }
      },

      "additionalProperties": false
    }
  },

  "additionalProperties": false
}
