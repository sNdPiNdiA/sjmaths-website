{
  "version": "1.0.0",

  "entity": "skill",

  "required": [
    "id",
    "topicId",
    "conceptId",
    "name",
    "status"
  ],

  "allowedStatus": [
    "active",
    "draft",
    "deprecated"
  ],

  "rules": {
    "idMustBeUnique": true,
    "topicMustExist": true,
    "conceptMustExist": true,
    "statusMustBeValid": true
  }
}
