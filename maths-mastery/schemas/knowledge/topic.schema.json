{
  "version": "1.0.0",

  "entity": "topic",

  "required": [
    "id",
    "domainId",
    "name",
    "level",
    "status"
  ],

  "allowedLevels": [
    "foundation",
    "basic",
    "intermediate",
    "advanced",
    "competitive"
  ],

  "allowedStatus": [
    "active",
    "draft",
    "deprecated"
  ],

  "rules": {
    "idMustBeUnique": true,
    "domainMustExist": true,
    "levelMustBeValid": true,
    "statusMustBeValid": true
  }
}
