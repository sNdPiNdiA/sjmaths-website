{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sjmaths.com/schemas/readiness-question.schema.json",
  "title": "SJMaths Readiness Diagnostic Question",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "questionType",
    "topicId",
    "conceptId",
    "skillIds",
    "readinessSkillId",
    "role",
    "difficulty"
  ],
  "properties": {

    "id": {
      "type": "string",
      "minLength": 1
    },

    "questionType": {
      "type": "string",
      "enum": [
        "mcq",
        "integer",
        "numeric",
        "short-answer",
        "subjective"
      ]
    },

    "topicId": {
      "type": "string",
      "minLength": 1
    },

    "conceptId": {
      "type": "string",
      "minLength": 1
    },

    "skillIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },

    "readinessSkillId": {
      "type": "string",
      "minLength": 1
    },

    "role": {
      "type": "string",
      "enum": [
        "diagnostic",
        "remediation",
        "mixed"
      ]
    },

    "difficulty": {
      "type": "string",
      "enum": [
        "basic",
        "standard",
        "intermediate",
        "advanced"
      ]
    },

    "diagnosticWeight": {
      "type": "number",
      "minimum": 0
    },

    "questionText": {
      "type": "string",
      "minLength": 1
    },

    "options": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },

    "correctAnswer": {},

    "explanation": {
      "type": "string"
    },

    "hint": {
      "type": "string"
    },

    "commonMistakes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "prerequisiteSkillIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "diagnosticTags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "source": {
      "type": "object"
    },

    "metadata": {
      "type": "object"
    }
  }
}
