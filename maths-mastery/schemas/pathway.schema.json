{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SJMaths Learning Pathway",
  "type": "object",

  "required": [
    "version",
    "id",
    "name",
    "topics"
  ],

  "properties": {

    "version": {
      "type": "string"
    },

    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },

    "name": {
      "type": "string",
      "minLength": 1
    },

    "description": {
      "type": "string"
    },

    "topics": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "minItems": 1,
      "uniqueItems": true
    },

    "recommendedOrder": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },

    "stages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },

  "additionalProperties": true
}
