{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sjmaths.com/schemas/maths-mastery/concepts.schema.json",

  "title": "SJMaths Maths Mastery Concepts",
  "description": "Structured concept content for a Maths Mastery topic.",
  "type": "object",

  "required": [
    "version",
    "topicId",
    "sections"
  ],

  "properties": {

    "version": {
      "type": "string"
    },

    "topicId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },

    "sections": {
      "type": "array",
      "minItems": 1,

      "items": {
        "type": "object",

        "required": [
          "id",
          "title",
          "order",
          "concepts"
        ],

        "properties": {

          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },

          "title": {
            "type": "string",
            "minLength": 1
          },

          "order": {
            "type": "integer",
            "minimum": 1
          },

          "description": {
            "type": "string"
          },

          "concepts": {
            "type": "array",
            "minItems": 1,

            "items": {
              "$ref": "#/$defs/concept"
            }
          }
        },

        "additionalProperties": false
      }
    }
  },

  "$defs": {

    "concept": {
      "type": "object",

      "required": [
        "id",
        "title",
        "difficulty",
        "estimatedMinutes",
        "skills",
        "blocks"
      ],

      "properties": {

        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },

        "title": {
          "type": "string",
          "minLength": 1
        },

        "shortDescription": {
          "type": "string"
        },

        "difficulty": {
          "type": "string",
          "enum": [
            "basic",
            "foundation",
            "intermediate",
            "advanced",
            "exam-level"
          ]
        },

        "estimatedMinutes": {
          "type": "integer",
          "minimum": 1
        },

        "skills": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },

        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },

        "blocks": {
          "type": "array",
          "minItems": 1,

          "items": {
            "$ref": "#/$defs/contentBlock"
          }
        }
      },

      "additionalProperties": false
    },

    "contentBlock": {
      "type": "object",

      "required": [
        "type"
      ],

      "properties": {

        "type": {
          "type": "string",
          "enum": [
            "heading",
            "text",
            "definition",
            "formula",
            "example",
            "shortcut",
            "tip",
            "warning",
            "common-mistake",
            "table",
            "image",
            "diagram",
            "video",
            "question-reference",
            "callout"
          ]
        },

        "title": {
          "type": "string"
        },

        "value": {
          "type": "string"
        },

        "latex": {
          "type": "string"
        },

        "ref": {
          "type": "string"
        },

        "src": {
          "type": "string"
        },

        "alt": {
          "type": "string"
        },

        "caption": {
          "type": "string"
        },

        "provider": {
          "type": "string"
        },

        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },

        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },

        "level": {
          "type": "string",
          "enum": [
            "info",
            "important",
            "exam"
          ]
        }
      },

      "additionalProperties": false
    }
  },

  "additionalProperties": false
}
