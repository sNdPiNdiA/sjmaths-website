{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sjmaths.com/schemas/maths-mastery/practice.schema.json",

  "title": "SJMaths Maths Mastery Practice Questions",
  "description": "Structured practice question bank for competitive mathematics.",
  "type": "object",

  "required": [
    "version",
    "topicId",
    "questions"
  ],

  "properties": {

    "version": {
      "type": "string"
    },

    "topicId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },

    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },

  "$defs": {

    "question": {
      "type": "object",

      "required": [
        "id",
        "question",
        "type",
        "difficulty",
        "skills",
        "concepts",
        "answer",
        "solution"
      ],

      "properties": {

        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },

        "question": {
          "type": "string",
          "minLength": 1
        },

        "type": {
          "type": "string",
          "enum": [
            "mcq",
            "multiple-correct",
            "numerical",
            "integer",
            "true-false",
            "fill-blank",
            "assertion-reason",
            "match-following",
            "word-problem"
          ]
        },

        "difficulty": {
          "type": "string",
          "enum": [
            "basic",
            "foundation",
            "intermediate",
            "advanced",
            "exam-level"
          ]
        },

        "skills": {
          "type": "array",
          "minItems": 1,

          "items": {
            "type": "object",

            "required": [
              "id",
              "role"
            ],

            "properties": {

              "id": {
                "type": "string"
              },

              "role": {
                "type": "string",
                "enum": [
                  "primary",
                  "secondary"
                ]
              }
            },

            "additionalProperties": false
          }
        },

        "concepts": {
          "type": "array",
          "minItems": 1,

          "items": {
            "type": "string"
          },

          "uniqueItems": true
        },

        "options": {
          "type": "array",

          "items": {
            "$ref": "#/$defs/option"
          }
        },

        "answer": {
          "type": "object",

          "required": [
            "value"
          ],

          "properties": {

            "value": {
              "type": "string"
            },

            "acceptedValues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },

          "additionalProperties": false
        },

        "hint": {
          "type": "string"
        },

        "solution": {
          "type": "array",
          "minItems": 1,

          "items": {
            "$ref": "#/$defs/solutionStep"
          }
        },

        "shortcut": {
          "type": "object",

          "required": [
            "title",
            "explanation"
          ],

          "properties": {

            "title": {
              "type": "string"
            },

            "explanation": {
              "type": "string"
            },

            "formula": {
              "type": "string"
            }
          },

          "additionalProperties": false
        },

        "commonTrap": {
          "type": "string"
        },

        "estimatedSeconds": {
          "type": "integer",
          "minimum": 5
        },

        "examRelevance": {
          "type": "object",

          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },

        "examTags": {
          "type": "array",

          "items": {
            "type": "object",

            "required": [
              "exam",
              "relevance"
            ],

            "properties": {

              "exam": {
                "type": "string"
              },

              "relevance": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },

              "year": {
                "type": "integer",
                "minimum": 1900
              },

              "paper": {
                "type": "string"
              }
            },

            "additionalProperties": false
          }
        },

        "tags": {
          "type": "array",

          "items": {
            "type": "string"
          },

          "uniqueItems": true
        }
      },

      "additionalProperties": false
    },

    "option": {
      "type": "object",

      "required": [
        "id",
        "text"
      ],

      "properties": {

        "id": {
          "type": "string"
        },

        "text": {
          "type": "string"
        }
      },

      "additionalProperties": false
    },

    "solutionStep": {
      "type": "object",

      "required": [
        "step",
        "title",
        "content"
      ],

      "properties": {

        "step": {
          "type": "integer",
          "minimum": 1
        },

        "title": {
          "type": "string"
        },

        "content": {
          "type": "array",
          "minItems": 1,

          "items": {
            "$ref": "#/$defs/solutionBlock"
          }
        }
      },

      "additionalProperties": false
    },

    "solutionBlock": {
      "type": "object",

      "required": [
        "type"
      ],

      "properties": {

        "type": {
          "type": "string",
          "enum": [
            "text",
            "formula",
            "calculation",
            "equation",
            "result"
          ]
        },

        "value": {
          "type": "string"
        },

        "latex": {
          "type": "string"
        }
      },

      "additionalProperties": false
    }
  },

  "additionalProperties": false
}
