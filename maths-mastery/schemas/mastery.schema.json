{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sjmaths.com/schemas/maths-mastery/mastery.schema.json",

  "title": "SJMaths Maths Mastery Contract",
  "description": "Mastery configuration and evidence model for a Maths Mastery topic.",
  "type": "object",

  "required": [
    "version",
    "topicId",
    "skills",
    "concepts",
    "masteryModel"
  ],

  "properties": {

    "version": {
      "type": "string"
    },

    "topicId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },

    "skills": {
      "type": "array",
      "minItems": 1,

      "items": {
        "$ref": "#/$defs/skillMastery"
      }
    },

    "concepts": {
      "type": "array",

      "items": {
        "$ref": "#/$defs/conceptMastery"
      }
    },

    "masteryModel": {
      "$ref": "#/$defs/masteryModel"
    }
  },

  "$defs": {

    "skillMastery": {
      "type": "object",

      "required": [
        "skillId",
        "weight",
        "minimumMastery"
      ],

      "properties": {

        "skillId": {
          "type": "string"
        },

        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },

        "minimumMastery": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },

        "minimumEvidence": {
          "type": "integer",
          "minimum": 1
        }
      },

      "additionalProperties": false
    },

    "conceptMastery": {
      "type": "object",

      "required": [
        "conceptId",
        "weight"
      ],

      "properties": {

        "conceptId": {
          "type": "string"
        },

        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },

      "additionalProperties": false
    },

    "masteryModel": {
      "type": "object",

      "required": [
        "components",
        "levels",
        "readiness"
      ],

      "properties": {

        "components": {
          "type": "object",

          "required": [
            "conceptLearning",
            "practice",
            "miniTest"
          ],

          "properties": {

            "conceptLearning": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },

            "practice": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },

            "miniTest": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },

          "additionalProperties": false
        },

        "levels": {
          "type": "array",
          "minItems": 1,

          "items": {
            "$ref": "#/$defs/masteryLevel"
          }
        },

        "readiness": {
          "$ref": "#/$defs/readiness"
        }
      },

      "additionalProperties": false
    },

    "masteryLevel": {
      "type": "object",

      "required": [
        "id",
        "min",
        "max"
      ],

      "properties": {

        "id": {
          "type": "string"
        },

        "min": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },

        "max": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },

      "additionalProperties": false
    },

    "readiness": {
      "type": "object",

      "required": [
        "minimum",
        "prerequisiteGate",
        "skillGate"
      ],

      "properties": {

        "minimum": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },

        "prerequisiteGate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },

        "skillGate": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },

      "additionalProperties": false
    }
  },

  "additionalProperties": false
}
