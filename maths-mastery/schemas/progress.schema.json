{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sjmaths://schemas/progress.schema.json",
  "title": "SJMaths Student Progress",
  "description": "Evidence-based student progress contract for Maths Mastery.",
  "type": "object",
  "required": [
    "version",
    "studentId",
    "updatedAt",
    "topics"
  ],
  "properties": {

    "version": {
      "type": "string"
    },

    "studentId": {
      "type": "string",
      "minLength": 1
    },

    "updatedAt": {
      "type": "string"
    },

    "topics": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/topicProgress"
      }
    }
  },

  "$defs": {

    "topicProgress": {

      "type": "object",

      "required": [
        "topicId",
        "status",
        "evidence",
        "concepts",
        "skills",
        "miniTests"
      ],

      "properties": {

        "topicId": {
          "type": "string"
        },

        "status": {
          "type": "string",
          "enum": [
            "not-started",
            "learning",
            "developing",
            "proficient",
            "mastered"
          ]
        },

        "evidence": {
          "$ref": "#/$defs/evidence"
        },

        "concepts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/conceptProgress"
          }
        },

        "skills": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/skillProgress"
          }
        },

        "miniTests": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/miniTestProgress"
          }
        }
      }
    },


    "evidence": {

      "type": "object",

      "required": [
        "attempts",
        "correct",
        "incorrect",
        "skipped",
        "timeSpentSeconds"
      ],

      "properties": {

        "attempts": {
          "type": "integer",
          "minimum": 0
        },

        "correct": {
          "type": "integer",
          "minimum": 0
        },

        "incorrect": {
          "type": "integer",
          "minimum": 0
        },

        "skipped": {
          "type": "integer",
          "minimum": 0
        },

        "timeSpentSeconds": {
          "type": "integer",
          "minimum": 0
        },

        "lastAttemptAt": {
          "type": [
            "string",
            "null"
          ]
        },

        "firstAttemptAt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },


    "conceptProgress": {

      "type": "object",

      "required": [
        "conceptId",
        "status",
        "evidence"
      ],

      "properties": {

        "conceptId": {
          "type": "string"
        },

        "status": {
          "type": "string",
          "enum": [
            "not-started",
            "learning",
            "developing",
            "proficient",
            "mastered"
          ]
        },

        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },


    "skillProgress": {

      "type": "object",

      "required": [
        "skillId",
        "score",
        "evidence"
      ],

      "properties": {

        "skillId": {
          "type": "string"
        },

        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },

        "evidence": {
          "$ref": "#/$defs/evidence"
        },

        "lastUpdatedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },


    "miniTestProgress": {

      "type": "object",

      "required": [
        "testId",
        "attempts"
      ],

      "properties": {

        "testId": {
          "type": "string"
        },

        "attempts": {
          "type": "integer",
          "minimum": 0
        },

        "bestScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },

        "bestAccuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },

        "lastScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },

        "lastAccuracy": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },

        "lastAttemptAt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
