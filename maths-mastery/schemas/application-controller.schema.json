{
  "version": "1.0.0",

  "required": [
    "studentId",
    "learnerFlow",
    "session",
    "progress",
    "mastery",
    "recommendation"
  ],

  "controllerResponsibilities": [
    "session-restoration",
    "onboarding",
    "diagnostic",
    "learning",
    "progress",
    "mastery",
    "recommendation"
  ],

  "rules": {
    "controllerDoesNotOwnEvidenceCalculation": true,
    "controllerDoesNotOwnMasteryAlgorithm": true,
    "controllerDoesNotOwnRecommendationAlgorithm": true,
    "controllerDelegatesToExistingEngines": true,
    "stateUpdatesMustBePersisted": true,
    "immutableState": true
  }
}
