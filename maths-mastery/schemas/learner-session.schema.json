{
  "version": "1.0.0",

  "required": [
    "sessionVersion",
    "studentId",
    "learnerFlow",
    "savedAt"
  ],

  "rules": {
    "studentIdRequired": true,
    "learnerFlowRequired": true,
    "savedAtRequired": true,
    "immutableUpdates": true,
    "corruptDataMustNotCrash": true,
    "missingDataCreatesNewSession": true
  }
}
