{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SJMaths Learner State",
  "type": "object",

  "required": [
    "version",
    "studentId",
    "state",
    "hasEvidence",
    "selectedExam",
    "startingPoint"
  ],

  "properties": {

    "version": {
      "type": "string"
    },

    "studentId": {
      "type": "string",
      "minLength": 1
    },

    "state": {
      "type": "string",
      "enum": [
        "new",
        "onboarding",
        "learning",
        "returning"
      ]
    },

    "hasEvidence": {
      "type": "boolean"
    },

    "selectedExam": {
      "type": [
        "string",
        "null"
      ]
    },

    "startingPoint": {
      "type": [
        "string",
        "null"
      ]
    },

    "diagnosticCompleted": {
      "type": "boolean"
    },

    "lastActiveAt": {
      "type": [
        "string",
        "null"
      ]
    }

  },

  "additionalProperties": false
}
