{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sjmaths.com/schemas/syllabus.schema.json",

  "title": "SJMaths Exam Syllabus",
  "type": "object",

  "required": [
    "id",
    "examId",
    "version",
    "name",
    "sections"
  ],

  "properties": {

    "id": {
      "type": "string",
      "minLength": 1
    },

    "examId": {
      "type": "string",
      "minLength": 1
    },

    "version": {
      "type": "string",
      "minLength": 1
    },

    "name": {
      "type": "string",
      "minLength": 1
    },

    "description": {
      "type": "string"
    },

    "subject": {
      "type": "string"
    },

    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },

    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },

  "$defs": {

    "section": {

      "type": "object",

      "required": [
        "id",
        "name",
        "order",
        "topics"
      ],

      "properties": {

        "id": {
          "type": "string",
          "minLength": 1
        },

        "name": {
          "type": "string",
          "minLength": 1
        },

        "order": {
          "type": "integer",
          "minimum": 1
        },

        "description": {
          "type": "string"
        },

        "topics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/topicRef"
          }
        }
      }
    },

    "topicRef": {

      "type": "object",

      "required": [
        "topicId",
        "order"
      ],

      "properties": {

        "topicId": {
          "type": "string",
          "minLength": 1
        },

        "order": {
          "type": "integer",
          "minimum": 1
        },

        "priority": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },

        "weight": {
          "type": "number",
          "minimum": 0
        },

        "description": {
          "type": "string"
        }
      }
    }
  }
}
