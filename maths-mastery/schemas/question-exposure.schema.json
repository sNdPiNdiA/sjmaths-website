{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "title": "SJMaths Question Exposure",

  "type": "object",

  "required": [
    "version",
    "studentId",
    "updatedAt",
    "questions"
  ],

  "properties": {

    "version": {
      "type": "string"
    },

    "studentId": {
      "type": "string",
      "minLength": 1
    },

    "updatedAt": {
      "type": "string"
    },

    "questions": {
      "type": "object"
    }
  }
}
