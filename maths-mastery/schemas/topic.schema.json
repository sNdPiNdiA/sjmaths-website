{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sjmaths.com/schemas/maths-mastery/topic.schema.json",

  "title": "SJMaths Maths Mastery Topic",
  "description": "Schema for a single Maths Mastery topic.",
  "type": "object",

  "required": [
    "id",
    "name",
    "slug",
    "domain",
    "level",
    "status",
    "description",
    "order",
    "skills",
    "prerequisites",
    "unlocks",
    "content",
    "mastery",
    "examRelevance"
  ],

  "properties": {

    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },

    "name": {
      "type": "string",
      "minLength": 1
    },

    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },

    "domain": {
      "type": "string",
      "enum": [
        "arithmetic",
        "algebra",
        "geometry",
        "mensuration",
        "trigonometry",
        "statistics",
        "probability",
        "data-interpretation"
      ]
    },

    "level": {
      "type": "string",
      "enum": [
        "foundation",
        "intermediate",
        "advanced"
      ]
    },

    "status": {
      "type": "string",
      "enum": [
        "active",
        "coming-soon",
        "draft"
      ]
    },

    "description": {
      "type": "string",
      "minLength": 1
    },

    "order": {
      "type": "integer",
      "minimum": 1
    },

    "estimatedMinutes": {
      "type": "integer",
      "minimum": 1
    },

    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },

    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "topicId",
          "required"
        ],
        "properties": {
          "topicId": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },

    "unlocks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },

    "content": {
      "type": "object",

      "required": [
        "concepts",
        "examples",
        "practice",
        "miniTests",
        "mastery"
      ],

      "properties": {

        "concepts": {
          "type": "string"
        },

        "examples": {
          "type": "string"
        },

        "practice": {
          "type": "string"
        },

        "miniTests": {
          "type": "string"
        },

        "mastery": {
          "type": "string"
        }
      },

      "additionalProperties": false
    },

    "mastery": {
      "type": "object",

      "required": [
        "minimumReadiness",
        "masteryThreshold"
      ],

      "properties": {

        "minimumReadiness": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },

        "masteryThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },

      "additionalProperties": false
    },

    "examRelevance": {
      "type": "object",

      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      }
    },

    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },

  "additionalProperties": false
}
