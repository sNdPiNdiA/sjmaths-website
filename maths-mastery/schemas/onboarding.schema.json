{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SJMaths Onboarding State",
  "type": "object",

  "required": [
    "version",
    "studentId",
    "status",
    "route",
    "selectedExam",
    "startingPoint"
  ],

  "properties": {

    "version": {
      "type": "string"
    },

    "studentId": {
      "type": "string",
      "minLength": 1
    },

    "status": {
      "type": "string",
      "enum": [
        "not-started",
        "in-progress",
        "completed"
      ]
    },

    "route": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "diagnostic",
        "foundation",
        null
      ]
    },

    "selectedExam": {
      "type": [
        "string",
        "null"
      ]
    },

    "startingPoint": {
      "type": [
        "string",
        "null"
      ]
    },

    "completedAt": {
      "type": [
        "string",
        "null"
      ]
    }

  },

  "additionalProperties": false
}
