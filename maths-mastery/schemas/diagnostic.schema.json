{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SJMaths Diagnostic",
  "type": "object",

  "required": [
    "version",
    "id",
    "title",
    "minimumQuestions",
    "questions"
  ],

  "properties": {

    "version": {
      "type": "string"
    },

    "id": {
      "type": "string",
      "minLength": 1
    },

    "title": {
      "type": "string",
      "minLength": 1
    },

    "description": {
      "type": "string"
    },

    "minimumQuestions": {
      "type": "integer",
      "minimum": 1
    },

    "questions": {
      "type": "array",
      "minItems": 1,

      "items": {

        "type": "object",

        "required": [
          "id",
          "topicId",
          "skillId",
          "difficulty",
          "questionType"
        ],

        "properties": {

          "id": {
            "type": "string"
          },

          "topicId": {
            "type": "string"
          },

          "skillId": {
            "type": "string"
          },

          "difficulty": {
            "type": "string",
            "enum": [
              "foundation",
              "basic",
              "intermediate",
              "advanced"
            ]
          },

          "questionType": {
            "type": "string",
            "enum": [
              "mcq",
              "numeric"
            ]
          }

        },

        "additionalProperties": false
      }
    }

  },

  "additionalProperties": false
}
