{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "sjmaths-web",
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "scripts/**",
      "tests/**",
      "**/*.md",
      "**/*.log",
      "test_output*.txt",
      "read_output.js",
      "build.js",
      "package*.json",
      "test_report.json"
    ],
    "redirects": [
      {
        "regex": "^/class-9-maths/ncert-exercise-practice/chapter-4-linear-equations-in-two-variables/?$",
        "destination": "/class-9-maths/ncert-exercise-practice/chapter-4-linear-equations-in-two-variables/exercise-4-1.html",
        "type": 301
      },
      {
        "regex": "^/classes/class-9-maths/ncert-exercise-practice/chapter-4-linear-equations-in-two-variables/?$",
        "destination": "/class-9-maths/ncert-exercise-practice/chapter-4-linear-equations-in-two-variables/exercise-4-1.html",
        "type": 301
      },
      {
        "regex": "^/class-(9|10|11|12)-maths/ncert-exercise-practice/([^/.]+)/?$",
        "destination": "/class-:1-maths/ncert-exercise-practice/",
        "type": 301
      },
      {
        "regex": "^/class-9-maths/ncert-examplar-practice/([^/.]+)/?$",
        "destination": "/class-9-maths/ncert-examplar-practice/",
        "type": 301
      },
      {
        "regex": "^/class-11-maths/ncert-exemplar-practice/([^/.]+)/?$",
        "destination": "/class-11-maths/ncert-exemplar-practice/",
        "type": 301
      },
      {
        "regex": "^/class-(9|10|11)-maths/worksheets/([^/.]+)/?$",
        "destination": "/class-:1-maths/worksheets/",
        "type": 301
      },
      {
        "regex": "^/class-10-maths/tests/chapter-wise/(chapter-(5-arithmetic-progressions|6-triangles|7-coordinate-geometry|8-introduction-to-trigonometry|9-applications-of-trigonometry|11-areas-related-to-circles|14-probability))/?$",
        "destination": "/class-10-maths/tests/chapter-wise/",
        "type": 301
      },
      {
        "regex": "^/class-10-maths/tests/unit-wise/?$",
        "destination": "/class-10-maths/tests/",
        "type": 301
      },
      {
        "regex": "^/class-12-maths/tests/chapter-wise/([^/.]+)/?$",
        "destination": "/class-12-maths/tests/chapter-wise/",
        "type": 301
      },
      {
        "regex": "^/class-12-maths/tests/unit-wise/(unit-(2-algebra|3-calculus|4-vectors-and-3d-geometry|5-linear-programming|6-probability))/?$",
        "destination": "/class-12-maths/tests/unit-wise/",
        "type": 301
      },
      {
        "regex": "^/class-(9|12)-maths/tests/full-length-tests/?$",
        "destination": "/class-:1-maths/tests/",
        "type": 301
      },
      {
        "regex": "^/class-12-maths/previous-years-questions-chapter-wise/chapter-wise/?$",
        "destination": "/class-12-maths/previous-years-questions-chapter-wise/",
        "type": 301
      },
      {
        "regex": "^/class-12-maths/previous-years-questions-chapter-wise/chapter-wise/(chapter-(1-relations-and-functions|2-inverse-trigonometric-functions|3-matrices))/?$",
        "destination": "/class-12-maths/previous-years-questions-chapter-wise/",
        "type": 301
      },
      {
        "regex": "^/maths-mastery/arithmetic/topics/?$",
        "destination": "/maths-mastery/arithmetic/",
        "type": 301
      },
      {
        "regex": "^/classes/class-(9|10|11|12)-maths/index\\.html$",
        "destination": "/class-:1-maths/",
        "type": 301
      },
      {
        "regex": "^/classes/class-(9|10|11|12)-maths/(.+)/index\\.html$",
        "destination": "/class-:1-maths/:2/",
        "type": 301
      },
      {
        "regex": "^/classes/class-(9|10|11|12)-maths/(.+)/$",
        "destination": "/class-:1-maths/:2/",
        "type": 301
      },
      {
        "regex": "^/classes/class-(9|10|11|12)-maths/(.+)$",
        "destination": "/class-:1-maths/:2",
        "type": 301
      },
      {
        "regex": "^/classes/class-(9|10|11|12)-maths/?$",
        "destination": "/class-:1-maths/",
        "type": 301
      },
      {
        "regex": "^/classes/class-(9|10|11|12)/?$",
        "destination": "/class-:1-maths/",
        "type": 301
      },
      {
        "regex": "^/class-(9|10|11|12)-maths/assets/(.+)$",
        "destination": "/assets/:2",
        "type": 301
      },
      {
        "regex": "^/_nextjs_migration_backup/\\.next/server/app/classes/class-(9|10|11|12)\\.html$",
        "destination": "/class-:1-maths/",
        "type": 301
      },
      {
        "regex": "^/_nextjs_migration_backup/src/content/classes/class-(9|10|11|12)/(.+)$",
        "destination": "/class-:1-maths/:2",
        "type": 301
      },
      {
        "regex": "^/pages/?$",
        "destination": "/pages/sitemap.html",
        "type": 301
      },
      {
        "regex": "^/security\\.txt$",
        "destination": "/.well-known/security.txt",
        "type": 301
      },
      {
        "regex": "^/classes/class-11/ncert-examplar-practice/(.+)/index\\.html$",
        "destination": "/class-11-maths/ncert-exemplar-practice/:1/",
        "type": 301
      },
      {
        "regex": "^/classes/class-11/ncert-examplar-practice/(.+)/$",
        "destination": "/class-11-maths/ncert-exemplar-practice/:1/",
        "type": 301
      },
      {
        "regex": "^/classes/class-11/ncert-examplar-practice/(.+)$",
        "destination": "/class-11-maths/ncert-exemplar-practice/:1",
        "type": 301
      },
      {
        "regex": "^/classes/class-(9|10|11|12)/index\\.html$",
        "destination": "/class-:1-maths/",
        "type": 301
      },
      {
        "regex": "^/classes/class-(9|10|11|12)/(.+)/index\\.html$",
        "destination": "/class-:1-maths/:2/",
        "type": 301
      },
      {
        "regex": "^/classes/class-(9|10|11|12)/(.+)/$",
        "destination": "/class-:1-maths/:2/",
        "type": 301
      },
      {
        "regex": "^/classes/class-(9|10|11|12)/(.+)$",
        "destination": "/class-:1-maths/:2",
        "type": 301
      },
      {
        "source": "/classes/class-9/:path*",
        "destination": "/class-9-maths/:path*",
        "type": 301
      },
      {
        "source": "/classes/class-10/:path*",
        "destination": "/class-10-maths/:path*",
        "type": 301
      },
      {
        "source": "/classes/class-11/ncert-examplar-practice/:path*",
        "destination": "/class-11-maths/ncert-exemplar-practice/:path*",
        "type": 301
      },
      {
        "source": "/classes/class-11/:path*",
        "destination": "/class-11-maths/:path*",
        "type": 301
      },
      {
        "source": "/classes/class-12/:path*",
        "destination": "/class-12-maths/:path*",
        "type": 301
      },
      {
        "source": "/classes/live-class.html",
        "destination": "/pages/pricing.html",
        "type": 301
      },
      {
        "source": "/classes/",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/:path*/index.html",
        "destination": "/:path*/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "upgrade-insecure-requests; default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://www.google.com https://apis.google.com https://www.google-analytics.com https://www.googletagmanager.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; img-src 'self' data: https:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com https://cdn.jsdelivr.net https://www.google-analytics.com; worker-src 'self' blob: https://cdnjs.cloudflare.com; frame-src 'self' https://www.google.com https://accounts.google.com https://apis.google.com https://sjmaths-web.firebaseapp.com;"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          },
          {
            "key": "Vary",
            "value": "Accept-Encoding"
          },
          {
            "key": "Link",
            "value": "<https://www.google.com>; rel=preconnect, <https://www.gstatic.com>; rel=preconnect"
          }
        ]
      },
      {
        "source": "**/@(dashboard|teacher-dashboard|profile|settings|notifications|search|404|offline|login|signup|my-submissions).html",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "**/pages/@(admin|manage-content).html",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "**/@(components|scripts|.firebase|.vscode)/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "questions-module/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, follow"
          }
        ]
      },
      {
        "source": "@(src|dataconnect|digital-evaluation|utils)/**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|gif|png|webp|svg|ico|woff|woff2|ttf|min.css|min.js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          }
        ]
      },
      {
        "source": "**/service-worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "**/*.json",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, stale-while-revalidate=86400"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, follow"
          }
        ]
      },
      {
        "source": "**/*.txt",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.xml",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, must-revalidate"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, follow"
          }
        ]
      },
      {
        "source": "**/firebase-config.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
