            "learn": {
                "paragraphs": [
                    "**1. General Term ($a_n$):** $a_n = a + (n-1)d$ where $a$ is first term and $d$ is common difference.",
                    "**2. Sum of $n$ Terms ($S_n$):** $S_n = \\frac{n}{2}[2a + (n-1)d]$ or $S_n = \\frac{n}{2}(a+l)$ where $l$ is the last term.",
                    "**3. Arithmetic Mean (AM):** If $A$ is the AM of $a$ and $b$, then $A = \\frac{a+b}{2}$."
                ],
                "formulas": [
                    {
                        "rule": "Sum Formula",
                        "formula": "S_n = \\frac{n}{2}[2a + (n-1)d]",
                        "example": "Sum of first 10 terms of 2, 4, 6... is 110."
                    }
                ],
                "boxes": [
                    {
                        "type": "tip",
                        "html": "Three numbers in AP can be assumed as $a-d, a, a+d$ for easier calculations."
                    }
                ]
            },
            "practice": [
