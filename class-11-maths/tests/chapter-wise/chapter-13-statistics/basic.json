      "marks": 3,
      "question": "Find the variance of the data: 2, 4, 6, 8, 10.",
      "finalAnswer": "8",
      "solutionSteps": [
        "Mean $\\bar{x} = \\frac{2+4+6+8+10}{5} = 6$.",
        "Deviations $x_i - \\bar{x}$: -4, -2, 0, 2, 4.",
        "Squares $(x_i - \\bar{x})^2$: 16, 4, 0, 4, 16.",
        "Sum of squares = 40.",
        "Variance $\\sigma^2 = \\frac{40}{5} = 8$."
      ]
    },
