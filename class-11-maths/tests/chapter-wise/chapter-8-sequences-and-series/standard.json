      "question": "If the sum of $n$ terms of an A.P. is $3n^2 + n$, then its common difference is",
      "options": [
        "6",
        "4",
        "3",
        "2"
      ],
      "finalAnswer": "(a) 6",
      "solutionSteps": [
        "$S_n = 3n^2 + n$.",
        "$a_1 = S_1 = 3(1)^2 + 1 = 4$.",
        "$S_2 = 3(2)^2 + 2 = 14$.",
        "$a_2 = S_2 - S_1 = 14 - 4 = 10$.",
        "$d = a_2 - a_1 = 10 - 4 = 6$."
      ]
