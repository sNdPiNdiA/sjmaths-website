            "learn": {
                "paragraphs": [
                    "**1. The Laws:** $0 \\le P(A) \\le 1$ and $P(S) = 1$.",
                    "**2. Addition Rule:** $P(A \\cup B) = P(A) + P(B) - P(A \\cap B)$.",
                    "**3. Axiom for Mutually Exclusive:** If $A \\cap B = \\phi$, then $P(A \\cup B) = P(A) + P(B)$."
                ],
                "formulas": [
                    {
                        "rule": "General Addition Theorem",
                        "formula": "P(A \\cup B) = P(A) + P(B) - P(A \\cap B)",
                        "example": "Avoid double counting overlap."
                    }
                ],
                "boxes": [
                    {
                        "type": "warning",
                        "html": "Subtraction is key for non-mutually exclusive events!"
                    }
                ]
            },
