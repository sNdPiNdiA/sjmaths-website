    },
    {
      "id": "tet",
      "title": "Teacher Eligibility Tests",
      "note": "CTET covers elementary and upper-primary mathematics, along with mathematics pedagogy. State TET syllabi and paper structures can differ."
    },
    {
      "id": "banking",
      "title": "Banking examinations",
      "note": "Use common quantitative-aptitude preparation topics and verify the current recruitment notification and exam pattern."
    },
    {
      "id": "railways",
      "title": "Railway examinations",
      "note": "RRB notifications name a broad mathematics syllabus; the applicable topics and depth vary by recruitment and post."
    },
    {
      "id": "cat",
      "title": "CAT and management entrance examinations",
      "note": "Advanced aptitude entries are included for preparation coverage. Confirm the current exam pattern and target-institute requirements."
    },
    {
      "id": "ssc",
      "title": "SSC examinations",
      "note": "SSC exam syllabi and depth differ by examination and tier; the SSC CGL source pages currently supply the shared lesson files."
    },
    {
      "id": "state-recruitment",
      "title": "State-government recruitment examinations",
      "note": "There is no single state-government syllabus. Select topics against the specific state, commission, post and notification."
