  "concepts": [
    {
      "concept_title": "Concept 1: Rectangular Prisms & Cubes",
      "summary": "Volume is the product of three dimensions, while surface area is the sum of the areas of all six faces.",
      "key_rules": [
        "Volume of a rectangular prism: $V = l \\times w \\times h$",
        "Surface Area of a rectangular prism: $SA = 2(lw + lh + wh)$",
        "Volume of a cube with side $s$: $V = s^3$"
      ],
      "traditional_method": "Identify the length, width, and height from the problem statement, substitute them into the respective formula, and perform arithmetic multiplication.",
      "sat_speed_trick": "Define variables $l, w, h$ in Desmos as sliders or constants, then type the formula directly to evaluate instantly.",
      "worked_example": {
        "problem": "A rectangular prism has a length of 5, width of 4, and height of 3. What is the surface area?",
        "traditional_solution": [
          "Identify dimensions: $l=5, w=4, h=3$",
          "Formula: $SA = 2(lw + lh + wh)$",
          "Substitute: $SA = 2((5)(4) + (5)(3) + (4)(3))$",
          "Calculate: $SA = 2(20 + 15 + 12)$",
          "Final: $SA = 2(47) = 94$"
        ],
        "speed_trick": [
          "Define $l=5, w=4, h=3$ in Desmos",
          "Type $2(lw + lh + wh)$",
          "Read result: 94"
        ],
        "answer": "94"
      }
    },
    {
      "concept_title": "Concept 2: Cylinders",
      "summary": "Cylinders are circular prisms where the base area is $\\pi r^2$ and the lateral surface area is the circumference times height.",
      "key_rules": [
        "Volume: $V = \\pi r^2 h$",
        "Lateral Surface Area: $LSA = 2\\pi rh$",
        "Total Surface Area: $SA = 2\\pi r^2 + 2\\pi rh$"
      ],
      "traditional_method": "Calculate the area of the circular base first, then multiply by height for volume, or use the perimeter of the base for lateral area.",
      "sat_speed_trick": "Use the Desmos constant 'pi' and define $r$ and $h$ to calculate values without manual rounding errors.",
      "worked_example": {
        "problem": "A cylinder has a radius of 3 and height of 10. Find the volume in terms of $\\pi$.",
        "traditional_solution": [
          "Formula: $V = \\pi r^2 h$",
          "Substitute: $V = \\pi (3)^2 (10)$",
          "Calculate: $V = \\pi (9)(10)$",
          "Final: $V = 90\\pi$"
        ],
        "speed_trick": [
          "Define $r=3, h=10$ in Desmos",
          "Type $r^2 h$",
          "Result is 90, append $\\pi$"
        ],
        "answer": "90\\pi"
      }
    },
    {
      "concept_title": "Concept 3: Scaling Factors",
      "summary": "When a 3D object is scaled by a factor $k$, its volume changes by $k^3$ and its surface area changes by $k^2$.",
      "key_rules": [
        "New Volume: $V_{new} = V_{old} \\times k^3$",
        "New Surface Area: $SA_{new} = SA_{old} \\times k^2$",
        "Linear dimension change: $L_{new} = L_{old} \\times k$"
      ],
      "traditional_method": "Determine the scale factor $k$ by comparing corresponding sides, then apply the power rule to the original volume or area.",
      "sat_speed_trick": "If the problem gives the ratio of volumes, take the cube root to find $k$, then square it to find the ratio of surface areas.",
      "worked_example": {
        "problem": "A cube has its side length tripled. By what factor does the volume increase?",
        "traditional_solution": [
          "Scale factor: $k = 3$",
          "Volume change rule: $k^3$",
          "Calculation: $3^3 = 27$",
          "Final: 27 times"
        ],
        "speed_trick": [
          "Identify $k=3$",
          "Type $3^3$ in Desmos",
          "Result: 27"
        ],
        "answer": "27"
      }
    },
    {
      "concept_title": "Concept 4: Spheres",
      "summary": "Spheres are defined solely by their radius, with formulas for volume and surface area involving powers of $r$.",
      "key_rules": [
        "Volume: $V = \\frac{4}{3}\\pi r^3$",
        "Surface Area: $SA = 4\\pi r^2$"
      ],
      "traditional_method": "Isolate the radius $r$ from the given information (diameter or circumference), then plug into the formula.",
      "sat_speed_trick": "Use Desmos to solve for $r$ if given $V$ or $SA$ by setting up an equation $V = (4/3)\\pi r^3$ and finding the intersection with $x=r$.",
      "worked_example": {
        "problem": "A sphere has a volume of $36\\pi$. What is the radius?",
        "traditional_solution": [
          "Equation: $36\\pi = \\frac{4}{3}\\pi r^3$",
          "Divide by $\\pi$: $36 = \\frac{4}{3} r^3$",
          "Multiply by $3/4$: $27 = r^3$",
          "Cube root: $r = 3$"
        ],
        "speed_trick": [
          "Type $y = (4/3)\\pi x^3$ in Desmos",
          "Type $y = 36\\pi$ in Desmos",
          "Find intersection $x=3$"
        ],
        "answer": "3"
      }
    }
  ],
