  "formula_sheet": {
    "core_formulas": [
      {
        "name": "Constant of Proportionality",
        "formula": "$k = \\frac{y}{x}$",
        "description": "Used to find the unit rate in direct variation problems."
      },
      {
        "name": "Percent Proportion",
        "formula": "$\\frac{\\text{part}}{\\text{whole}} = \\frac{\\text{percent}}{100}$",
        "description": "Essential for solving complex percentage-based proportion problems."
      }
    ],
    "sat_traps": [
      {
        "title": "Units Mismatch",
        "description": "The SAT often provides values in different units (e.g., feet vs. inches). Always convert to a single unit before setting up the proportion."
      },
      {
        "title": "Inverse vs Direct",
        "description": "Watch for 'inversely proportional' keywords. If $y$ is inversely proportional to $x$, use $y = \\frac{k}{x}$ instead of $y = kx$."
      }
    ],
