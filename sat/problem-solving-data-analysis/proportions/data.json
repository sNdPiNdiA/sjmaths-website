  "concepts": [
    {
      "concept_title": "Concept 1: Basic Proportionality",
      "summary": "A proportion is an equation stating that two ratios are equivalent, often used to scale quantities while maintaining a constant relationship.",
      "key_rules": [
        "Cross-multiplication property: If $\\frac{a}{b} = \\frac{c}{d}$, then $ad = bc$",
        "Unit rate identification: $k = \\frac{y}{x}$ where $k$ is the constant of proportionality",
        "Direct variation: $y = kx$"
      ],
      "traditional_method": "Set up the ratio as a fraction, equate it to the target ratio, and solve for the unknown variable using cross-multiplication.",
      "sat_speed_trick": "Type the equation into Desmos as 'y/x = k' or use the slider feature to find the intersection point instantly.",
      "worked_example": {
        "problem": "If 5 apples cost $3.00, how much do 12 apples cost?",
        "traditional_solution": [
          "Set up the ratio: $\\frac{5}{3} = \\frac{12}{x}$",
          "Cross-multiply: $5x = 36$",
          "Divide by 5: $x = \\frac{36}{5}$",
          "Final answer: $x = 7.2$"
        ],
        "speed_trick": [
          "Type 'y/5 = 3/x' into Desmos",
          "Add a slider for x or look for the intersection with x=12",
          "Read the value of y as 7.2"
        ],
        "answer": "7.2"
      }
    },
    {
      "concept_title": "Concept 2: Scale Factors & Geometry",
      "summary": "Scale factors represent the ratio of corresponding sides between similar figures or maps.",
      "key_rules": [
        "Length ratio: $k = \\frac{L_2}{L_1}$",
        "Area ratio: $k^2 = \\frac{A_2}{A_1}$",
        "Volume ratio: $k^3 = \\frac{V_2}{V_1}$"
      ],
      "traditional_method": "Identify the scale factor $k$ by comparing known corresponding sides, then apply the power of $k$ to the target dimension.",
      "sat_speed_trick": "Use Desmos to calculate the ratio $k$ first, then store it as a variable 'k' to perform subsequent calculations.",
      "worked_example": {
        "problem": "A map has a scale of 1 inch to 5 miles. If two cities are 4 inches apart on the map, what is the actual distance?",
        "traditional_solution": [
          "Identify the ratio: $\\frac{1}{5} = \\frac{4}{x}$",
          "Cross-multiply: $1 \\cdot x = 5 \\cdot 4$",
          "Solve: $x = 20$"
        ],
        "speed_trick": [
          "Define the ratio in Desmos: $r = 5/1$",
          "Multiply the map distance by the ratio: $4 * r$",
          "Result: 20"
        ],
        "answer": "20"
      }
    }
  ],
