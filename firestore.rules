// Synced against live-deployed rules (fetch: 2026-09-22) so deploy is behavior-preserving.
// Addition vs live: anonymous guest profile bootstrap (users/{user_*}) for analytics.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ==============================
       AUTH HELPERS (EMAIL BASED)
    ============================== */

    function isSignedIn() {
      return request.auth != null;
    }

    // OWNER (Super Admin – Full Access)
    function isOwner() {
      return isSignedIn()
        && request.auth.token.email == "sandeepjaiswal215@gmail.com";
    }

    // ADMINS
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email in [
          "sandeepjaiswal5677@gmail.com"
        ];
    }

    // TEACHERS
    function isTeacher() {
      return isSignedIn()
        && request.auth.token.email in [
          "support@sjmaths.com" 
        ];
    }

    // PREMIUM USERS
    function isPremium() {
      return isSignedIn()
        && request.auth.token.email in [
          "premium1@gmail.com"
        ];
    }

    function canWriteAnalyticsForUser(userId) {
      return (isSignedIn() && request.auth.uid == userId)
        || (request.auth == null && userId.matches('^user_[0-9a-z]+_[0-9]+$'));
    }

    function validPageView(userId) {
      return request.resource.data.keys().hasOnly([
          'userId', 'page', 'referrer', 'activeSeconds', 'maxScrollDepth', 'timestamp'
        ])
        && request.resource.data.userId == userId
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 2048
        && request.resource.data.referrer is string
        && request.resource.data.referrer.size() <= 2048
        && request.resource.data.activeSeconds is int
        && request.resource.data.activeSeconds >= 0
        && request.resource.data.activeSeconds <= 86400
        && request.resource.data.maxScrollDepth is int
        && request.resource.data.maxScrollDepth >= 0
        && request.resource.data.maxScrollDepth <= 100
        && request.resource.data.timestamp is timestamp;
    }

    function validUserAction(userId) {
      return request.resource.data.keys().hasOnly([
          'userId', 'page', 'actionType', 'elementText', 'details', 'timestamp'
        ])
        && request.resource.data.userId == userId
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 2048
        && request.resource.data.actionType is string
        && request.resource.data.actionType.size() <= 64
        && request.resource.data.elementText is string
        && request.resource.data.elementText.size() <= 100
        && (!request.resource.data.keys().hasAny(['details'])
          || (request.resource.data.details is string && request.resource.data.details.size() <= 4000))
        && request.resource.data.timestamp is timestamp;
    }

    /* ==============================
       USERS COLLECTION
    ============================== */
    match /users/{userId} {
      allow read: if isSignedIn() && (
          request.auth.uid == userId || isTeacher() || isAdmin() || isOwner()
      );
      allow create: if (isSignedIn() && request.auth.uid == userId)
        // Anonymous visitors: bootstrap their own guest profile (persistent sj_uid).
        // Constrained to guest-only fields so no privileged fields can be injected.
        || (request.auth == null
            && userId.matches('^user_[0-9a-z]+_[0-9]+$')
            && request.resource.data.userId == userId
            && request.resource.data.isAnonymous == true
            && request.resource.data.keys().hasOnly([
              'userId', 'displayName', 'email', 'photoURL', 'isAnonymous', 'createdAt', 'lastActive'
]));
      
      allow update: if 
        (isSignedIn() && request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastActive'])) ||
        (isSignedIn() && (
          isOwner() ||
          (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isPremium', 'premiumExpiry'])) ||
          (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isPremium', 'premiumExpiry']))
        ));
      
      // Allow writing to subcollections for analytics
      match /page_views/{viewId} {
        allow create: if canWriteAnalyticsForUser(userId) && validPageView(userId);
        allow read: if isOwner() || isAdmin();
      }
      match /user_actions/{actionId} {
        allow create: if canWriteAnalyticsForUser(userId) && validUserAction(userId);
        allow read: if isOwner() || isAdmin();
      }
    }

    /* ==============================
       SUBMISSIONS (For Unit Tests)
    ============================== */
    match /submissions/{submissionId} {
      // Only allow logged-in users to create submissions
      allow create: if isSignedIn();
      
      // Students can read their own; Teachers can read all
      allow read: if (isSignedIn() && resource.data.studentId == request.auth.uid) 
                  || isTeacher() || isAdmin() || isOwner();
                  
      // Only Teachers/Admins can grade (update)
      allow update: if isTeacher() || isAdmin() || isOwner();
    }

    /* ==============================
       FEEDBACKS
    ============================== */
    match /feedbacks/{feedbackId} {
      allow create: if isSignedIn();
      allow read: if isTeacher() || isAdmin() || isOwner();
    }

    /* ==============================
       CONTENT MANAGEMENT
    ============================== */
    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin() || isOwner();
    }

    match /classes/{classId}/{document=**} {
      allow read: if true;
      allow write: if isOwner() || isAdmin() || isTeacher();
    }

    match /premium_content/{docId} {
      allow read: if isPremium() || isAdmin() || isOwner();
      allow write: if isAdmin() || isOwner();
    }

    match /admin_logs/{logId} {
      allow read, write: if isAdmin() || isOwner();
    }

    /* ==============================
       NOTIFICATIONS (Public Read)
    ============================== */
    match /notifications/{notifId} {
      allow read: if true;
      allow write: if isAdmin() || isOwner();
    }

    /* ==============================
       FCM TOKENS (Push Notifications)
    ============================== */
    match /fcmTokens/{tokenId} {
      // Logged-in users can create/update their own token docs
      allow create, update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      // Only admins can read all tokens (for sending pushes)
      allow read: if isAdmin() || isOwner();
      // Users can delete their own tokens
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    /* ==============================
       PAGE VIEWS (Top-level analytics)
    ============================== */
    match /page_views/{viewId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && validPageView(request.auth.uid);
      // Only owner / admin can read analytics data
      allow read: if isOwner() || isAdmin();
    }

    /* ==============================
       USER ACTIONS (Top-level analytics)
    ============================== */
    match /user_actions/{actionId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && validUserAction(request.auth.uid);
      // Only owner / admin can read
      allow read: if isOwner() || isAdmin();
    }


    /* ==============================
       COLLECTION GROUP QUERIES
       Required for collectionGroup() reads across all users
    ============================== */
    match /{path=**}/page_views/{viewId} {
      allow read: if isOwner() || isAdmin();
    }

    match /{path=**}/user_actions/{actionId} {
      allow read: if isOwner() || isAdmin();
    }

    /* ==============================
       DEFAULT DENY
    ============================== */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
