                "correctIndex": 0,
                "passMessage": "Correct! This is Thales Theorem (BPT).",
                "failMessage": "BPT states parallel lines divide sides in the same ratio: AD/DB = AE/EC."
            },
            "learn": {
                "paragraphs": [
                    "**1. Similar Figures:** Have same shape but not necessarily same size. All circles, squares, and equilateral triangles are similar.",
                    "**2. Basic Proportionality Theorem (BPT):** If a line parallel to one side of a triangle intersects the other two sides, it divides them in the same ratio.",
                    "**3. Converse of BPT:** If a line divides two sides in the same ratio, it is parallel to the third side."
                ],
                "formulas": [
                    {
                        "rule": "BPT Formula",
                        "formula": "AD/DB = AE/EC",
                        "example": "If AD=2, DB=3, AE=4, then EC=6."
                    }
                ],
                "boxes": [
                    {
                        "type": "info",
                        "html": "Thales is the mathematician credited with BPT."
                    }
                ]
            },
