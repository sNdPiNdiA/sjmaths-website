    "question": "The area of a triangle with vertices $(2, 7), (1, 1)$ and $(10, 8)$ is: [1 mark]",
    "options": [
      "47 sq units",
      "23.5 sq units",
      "50 sq units",
      "25 sq units"
    ],
    "solutionSteps": [
      "Area $= \\frac{1}{2} |\\begin{vmatrix} 2 & 7 & 1 \\\\ 1 & 1 & 1 \\\\ 10 & 8 & 1 \\end{vmatrix}|$.",
      "$= \\frac{1}{2} |2(1-8) - 7(1-10) + 1(8-10)|$.",
      "$= \\frac{1}{2} |-14 + 63 - 2| = \\frac{47}{2} = 23.5$ sq. units."
    ],
    "finalAnswer": "23.5 sq units",
