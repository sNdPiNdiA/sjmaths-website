        { "id": "7", "year": "2022", "marks": 3, "type": "sa", "question": "The minute hand of a clock is 14 cm long. Find the area swept by the minute hand in 5 minutes.", "solutionSteps": [ "Radius $r = 14$ cm. $\\theta$ in 5 mins $= 30^{\\circ}$.", "Area $= (30/360) \\times (22/7) \\times 14 \\times 14$.", "Area $= (1/12) \\times 22 \\times 2 \\times 14 = (1/6) \\times 22 \\times 14 = 154/3 = 51.33$ cm²." ], "finalAnswer": "Ans: 51.33 cm²" },
        { "id": "8", "year": "2019", "marks": 3, "type": "sa", "question": "A sector of a circle of radius 12 cm has an angle of 120°. Find the length of its arc and its area. (Use $\\pi = 3.14$)", "solutionSteps": [ "Length $= (120/360) \\times 2 \\times 3.14 \\times 12 = 1/3 \\times 75.36 = 25.12$ cm.", "Area $= (120/360) \\times 3.14 \\times 12 \\times 12 = 1/3 \\times 452.16 = 150.72$ cm²." ], "finalAnswer": "Ans: Length = 25.12 cm, Area = 150.72 cm²" }
