      "questions": [
        { "id": "1", "year": "2026", "marks": 1, "type": "mcq", "question": "The area of a sector of a circle with radius 14 cm and central angle 45° is:", "options": [ "(A) 77 cm²", "(B) 154 cm²", "(C) 38.5 cm²", "(D) 308 cm²" ], "solutionSteps": [ "Area $= (45/360) \\times (22/7) \\times 14 \\times 14$.", "Area $= 1/8 \\times 22 \\times 2 \\times 14 = 77$ cm²." ], "finalAnswer": "Ans: (A) 77 cm²" },
        { "id": "2", "year": "2025", "marks": 1, "type": "mcq", "question": "If the area of a sector of a circle is 1/10 of the area of the circle, then the central angle is:", "options": [ "(A) 18°", "(B) 36°", "(C) 72°", "(D) 90°" ], "solutionSteps": [ "$(\\theta/360) \\times \\pi r^2 = 1/10 \\times \\pi r^2$.", "$\\theta/360 = 1/10 \\Rightarrow \\theta = 36^{\\circ}$." ], "finalAnswer": "Ans: (B) 36°" },
        { "id": "3", "year": "2024", "marks": 1, "type": "mcq", "question": "The area of a sector of a circle with radius 6 cm if angle of the sector is 60° is:", "options": [ "(A) $132/7$ cm²", "(B) $154/7$ cm²", "(C) $164/7$ cm²", "(D) $176/7$ cm²" ], "solutionSteps": [ "Area of sector $= (\\theta/360) \\times \\pi r^2$.", "Area $= (60/360) \\times (22/7) \\times 6 \\times 6 = (1/6) \\times (22/7) \\times 36 = 132/7$ cm²." ], "finalAnswer": "Ans: (A) $132/7$ cm²" },
        { "id": "4", "year": "2023", "marks": 1, "type": "mcq", "question": "The area of a sector of angle $p$ (in degrees) of a circle with radius R is:", "options": [ "(A) $(p/180) \\times 2\\pi R$", "(B) $(p/180) \\times \\pi R^2$", "(C) $(p/360) \\times 2\\pi R$", "(D) $(p/720) \\times 2\\pi R^2$" ], "solutionSteps": [ "Area $= (p/360) \\times \\pi R^2$.", "Multiply numerator and denominator by 2: $(p/720) \\times 2\\pi R^2$." ], "finalAnswer": "Ans: (D)" },
        { "id": "5", "year": "2022", "marks": 1, "type": "vsa", "question": "Find the length of the arc of a circle of radius 14 cm which subtends an angle of 90° at the center.", "solutionSteps": [ "Length of arc $= (\\theta/360) \\times 2\\pi r$.", "Length $= (90/360) \\times 2 \\times (22/7) \\times 14 = (1/4) \\times 2 \\times 22 \\times 2 = 22$ cm." ], "finalAnswer": "Ans: 22 cm" },
        { "id": "6", "year": "2020", "marks": 1, "type": "mcq", "question": "The angle described by a minute hand in 5 minutes is:", "options": [ "(A) 30°", "(B) 60°", "(C) 90°", "(D) 15°" ], "solutionSteps": [ "In 60 minutes, minute hand covers 360°.", "In 1 minute, it covers $360/60 = 6^{\\circ}$.", "In 5 minutes, it covers $5 \\times 6 = 30^{\\circ}$." ], "finalAnswer": "Ans: (A) 30°" }
      ]
