    {
      "sectionName": "Section E — 4 Marks Case-Based Questions",
      "questions": [
        { "id": "15", "year": "2022", "marks": 4, "type": "case_study", "case_study": "**PASSAGE:** Book rental shop: fixed charge for first 2 days, then ₹y per day. Latika paid ₹22 for 6 days; Anand paid ₹16 for 4 days.", "parts": { "i": "Write the pair of equations.", "ii": "Fixed charge for first 2 days.", "iii": "(a) Daily charge after 2 days + Ramesh's cost for 7 days. OR (b) Solve graphically." }, "solutionSteps": [ "<strong>(i)</strong> $x+4y=22, x+2y=16$.", "<strong>(ii)</strong> Subtracting: $2y=6 \\Rightarrow y=3, x=10$.", "<strong>(iii)</strong> (a) Ramesh for 7 days (2 fixed + 5 extra) $= 10 + 5(3) = ₹25$." ] },
        { "id": "16", "year": "2021", "marks": 4, "type": "case_study", "case_study": "**PASSAGE:** Sneha and Trisha together have 45 marbles. Each loses 5, product of new counts = 128. Their counts satisfy x+y=45 and x-y=k (k>0).", "parts": { "i": "Write the equations.", "ii": "Find marbles each has.", "iii": "(a) Find k and verify. OR (b) If each gains 5 instead, what are the new equations?" }, "solutionSteps": [ "<strong>(i)</strong> $x+y=45, (x-5)(y-5)=128$.", "<strong>(ii)</strong> $y=45-x \\Rightarrow (x-5)(40-x)=128 \\Rightarrow 40x-x^2-200+5x=128 \\Rightarrow x^2-45x+328=0$.", "Solving: $x=24, y=21, k=3$." ] }
      ]
