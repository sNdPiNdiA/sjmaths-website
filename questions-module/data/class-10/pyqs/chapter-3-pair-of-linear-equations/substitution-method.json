      "sectionName": "Section B — 2 Marks Questions",
      "questions": [
        { "id": "1", "year": "2024", "marks": 2, "type": "sa", "question": "Sum of two numbers is 105 and their difference is 45. Find the numbers.", "solutionSteps": [ "Let numbers be $x$ and $y$.", "$x + y = 105$", "$x - y = 45$", "Adding: $2x = 150 \\Rightarrow x = 75$.", "Subtracting: $2y = 60 \\Rightarrow y = 30$." ], "finalAnswer": "Ans: 75 and 30" },
        { "id": "2", "year": "2023", "marks": 2, "type": "sa", "question": "A fraction becomes $1/3$ when 1 is subtracted from numerator. It becomes $1/4$ when 8 is added to denominator. Find the fraction.", "solutionSteps": [ "Let fraction be $x/y$.", "$(x-1)/y = 1/3 \\Rightarrow 3x - 3 = y$", "$x/(y+8) = 1/4 \\Rightarrow 4x = y + 8$", "Substitute $y$: $4x = (3x-3) + 8 \\Rightarrow 4x = 3x + 5 \\Rightarrow x = 5$.", "$y = 3(5) - 3 = 12$. Fraction is $5/12$." ], "finalAnswer": "Ans: 5/12" },
        { "id": "3", "year": "2020", "marks": 2, "type": "sa", "question": "Solve by substitution method: $7x - 15y = 2$ and $x + 2y = 3$", "solutionSteps": [ "From Eq 2: $x = 3 - 2y$.", "Substitute in Eq 1: $7(3 - 2y) - 15y = 2$.", "$21 - 14y - 15y = 2 \\Rightarrow 29y = 19 \\Rightarrow y = 19/29$.", "$x = 3 - 2(19/29) = (87 - 38)/29 = 49/29$." ], "finalAnswer": "Ans: $x = 49/29, y = 19/29$" },
        { "id": "4", "year": "2019", "marks": 2, "type": "sa", "question": "Find two numbers whose sum is 75 and difference is 15.", "solutionSteps": [ "$x + y = 75, x - y = 15$.", "$2x = 90 \\Rightarrow x = 45$.", "$2y = 60 \\Rightarrow y = 30$." ], "finalAnswer": "Ans: 45 and 30" },
        { "id": "5", "year": "2018", "marks": 2, "type": "sa", "question": "Solve: $\\sqrt{x} + \\sqrt{y} = 4$ and $1/\\sqrt{x} + 1/\\sqrt{y} = 4/3$ ($x, y > 0$)", "solutionSteps": [ "Let $a = \\sqrt{x}, b = \\sqrt{y}$.", "$a + b = 4$", "$1/a + 1/b = 4/3 \\Rightarrow (a+b)/ab = 4/3 \\Rightarrow 4/ab = 4/3 \\Rightarrow ab = 3$.", "Numbers whose sum is 4 and product is 3 are 1 and 3.", "If $a=1, b=3 \\Rightarrow x=1, y=9$. If $a=3, b=1 \\Rightarrow x=9, y=1$." ], "finalAnswer": "Ans: (1, 9) or (9, 1)" },
        { "id": "6", "year": "2017", "marks": 2, "type": "sa", "question": "Solve: $x + y = 5$ and $2x - 3y = 5$", "solutionSteps": [ "From Eq 1: $x = 5 - y$.", "Substitute in Eq 2: $2(5 - y) - 3y = 5$.", "$10 - 2y - 3y = 5 \\Rightarrow 5y = 5 \\Rightarrow y = 1$.", "$x = 5 - 1 = 4$." ], "finalAnswer": "Ans: $x = 4, y = 1$" },
        { "id": "7", "year": "2015", "marks": 2, "type": "sa", "question": "Solve: $\\sqrt{3}x - \\sqrt{8}y = 0$ and $\\sqrt{5}x + \\sqrt{2}y = 0$", "solutionSteps": [ "This is a homogeneous system. Since $D = \\sqrt{6} - (-\\sqrt{40}) \\neq 0$, the only solution is $(0, 0)$." ], "finalAnswer": "Ans: $x = 0, y = 0$" }
      ]
    },
    {
      "sectionName": "Section C — 3 Marks Questions",
      "questions": [
        { "id": "8", "year": "2025", "marks": 3, "type": "sa", "question": "Sum of digits of a two-digit number is 12. Reversing digits gives a number 36 more than original. Find the original number.", "solutionSteps": [ "Let tens digit $= x$, units digit $= y$. Number $= 10x + y$.", "$x + y = 12$", "$(10y + x) - (10x + y) = 36 \\Rightarrow 9y - 9x = 36 \\Rightarrow y - x = 4$.", "Adding: $2y = 16 \\Rightarrow y = 8, x = 4$. Number is 48." ], "finalAnswer": "Ans: 48" },
        { "id": "9", "year": "2022", "marks": 3, "type": "sa", "question": "A library has a fixed charge for first 3 days, extra per day after. Saritha paid ₹27 for 7 days and Susy paid ₹21 for 5 days. Find the charges.", "solutionSteps": [ "Let fixed charge $= x$, extra per day $= y$.", "Saritha: $x + 4y = 27$ (7 days - 3 fixed).", "Susy: $x + 2y = 21$ (5 days - 3 fixed).", "Subtract: $2y = 6 \\Rightarrow y = 3$. $x = 21 - 2(3) = 15$." ], "finalAnswer": "Ans: Fixed = ₹15, Extra = ₹3/day" },
        { "id": "10", "year": "2022", "marks": 3, "type": "sa", "question": "Solve: $2/x + 3/y = 13$ and $5/x - 4/y = -2$ ($x \\neq 0, y \\neq 0$)", "solutionSteps": [ "Let $1/x = a, 1/y = b$.", "$2a + 3b = 13$", "$5a - 4b = -2$", "Multiply Eq 1 by 4, Eq 2 by 3: $8a + 12b = 52, 15a - 12b = -6$.", "Adding: $23a = 46 \\Rightarrow a = 2 \\Rightarrow x = 1/2$.", "$b = (13-4)/3 = 3 \\Rightarrow y = 1/3$." ], "finalAnswer": "Ans: $x = 1/2, y = 1/3$" },
        { "id": "11", "year": "2020", "marks": 3, "type": "sa", "question": "Sum of a two-digit number and its reverse is 110. If 10 is subtracted, new number is 4 more than 5 times the sum of digits. Find the number.", "solutionSteps": [ "Let number $= 10x + y$. Reverse $= 10y + x$.", "$(10x+y) + (10y+x) = 110 \\Rightarrow 11x + 11y = 110 \\Rightarrow x + y = 10$.", "$(10x+y) - 10 = 5(x+y) + 4 \\Rightarrow 10x+y-10 = 5(10) + 4 = 54$.", "$10x + y = 64$. Solving with $x+y=10$: $9x = 54 \\Rightarrow x = 6, y = 4$." ], "finalAnswer": "Ans: 64" },
        { "id": "12", "year": "2018", "marks": 3, "type": "sa", "question": "The larger of two supplementary angles exceeds the smaller by 18°. Find them.", "solutionSteps": [ "$x + y = 180$", "$x - y = 18$", "$2x = 198 \\Rightarrow x = 99^{\\circ}$.", "$y = 180 - 99 = 81^{\\circ}$." ], "finalAnswer": "Ans: 99° and 81°" },
        { "id": "13", "year": "2017", "marks": 3, "type": "sa", "question": "Sum of a two-digit number and its reverse is 99. Digits differ by 3. Find the number.", "solutionSteps": [ "$(10x+y) + (10y+x) = 99 \\Rightarrow x+y = 9$.", "$x-y = 3$ or $y-x = 3$.", "Case 1: $2x=12 \\Rightarrow x=6, y=3$. Number 63.", "Case 2: $2y=12 \\Rightarrow y=6, x=3$. Number 36." ], "finalAnswer": "Ans: 63 and 36" }
      ]
    },
