      "questions": [
        { "id": "14", "year": "2021", "marks": 5, "type": "la", "question": "Sum of ages of father and son is 45 years. Five years ago, product of their ages was 4 times the father's age then. Find their present ages.", "solutionSteps": [ "Let father $= x$, son $= y$. $x+y=45$.", "Five years ago: father $= x-5$, son $= y-5$.", "$(x-5)(y-5) = 4(x-5) \\Rightarrow y-5 = 4 \\Rightarrow y = 9$.", "Father $x = 45 - 9 = 36$." ], "finalAnswer": "Ans: Father = 36, Son = 9" }
      ]
