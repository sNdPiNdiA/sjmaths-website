{
  "name": "sjmaths-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
  "build": "node build.js",
  "pages:build": "node scripts/prepare-pages.cjs --force --output-dir .pages-dist && node scripts/verify-pages-artifact.cjs --output-dir .pages-dist",
  "pages:verify": "node scripts/verify-pages-artifact.cjs --output-dir .pages-dist",
  "pages:deploy": "node scripts/deploy-pages.cjs",
  "pages:build:dry": "node scripts/prepare-pages.cjs --dry-run",
    "seo:audit": "node scripts/audit-seo.cjs",
    "seo:apply": "node scripts/apply-seo-policy.cjs",
    "seo:apply:dry": "node scripts/apply-seo-policy.cjs --dry-run",
    "generate:sitemaps": "node generate-sitemaps.cjs",
    "generate:search": "node generate-search-index.cjs",
    "generate:directories": "node scripts/generate-topic-directories.cjs",
    "seo:prerender": "node scripts/prerender-seo-content.cjs",
    "seo:test": "node --test scripts/seo-regression.test.cjs",
    "seo:test:browser": "node scripts/test-seo-browser.cjs",
    "syntax:test": "node scripts/check-js-syntax.cjs",
    "security:test": "node --test scripts/security-regression.test.cjs",
    "three:test": "node --test scripts/three-regression.test.cjs",
    "a11y:audit": "node scripts/audit-accessibility.cjs",
    "test": "npm run syntax:test && npm run security:test && npm run three:test && npm run seo:test && npm run seo:audit && npm run a11y:audit && npm audit --omit=dev",
  "seo:test:hosting": "node scripts/test-seo-hosting.cjs",
  "seo:test:hosting:runtime": "node scripts/test-seo-hosting.cjs --runtime-only --concurrency=4 --runtime-concurrency=4",
    "seo:test:redirects": "node scripts/check-cloudflare-redirects.cjs",
    "seo:build": "node scripts/build-seo-assets.cjs",
    "seo:report": "node scripts/generate-seo-report.cjs",
    "submit:indexnow": "node scripts/submit-indexnow.js",
    "create:chapter": "node scripts/author.js"
  },
  "devDependencies": {
    "@google/genai": "^2.10.0",
    "cheerio": "^1.2.0",
    "esbuild": "^0.25.0",
    "jsonrepair": "^3.15.0",
    "playwright": "^1.62.1"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "dotenv": "^17.4.2",
    "fast-xml-parser": "^5.0.0",
    "pdf-parse": "^2.4.5",
    "undici": "^8.10.2"
  }
}
