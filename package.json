{
  "name": "sjmaths-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "seo:apply": "node scripts/apply-seo-policy.js",
    "seo:apply:dry": "node scripts/apply-seo-policy.js --dry-run",
    "generate:sitemaps": "node generate-sitemaps.js",
    "generate:search": "node generate-search-index.js",
    "ca:fetch": "node scripts/current-affairs/fetch-search.js",
    "ca:process": "node scripts/current-affairs/deduplicate.js && node scripts/current-affairs/categorize.js && node scripts/current-affairs/exam-tag.js",
    "ca:generate": "node scripts/current-affairs/generate-pages.js",
    "ca:mcq": "node scripts/current-affairs/generate-mcqs.js",
    "ca:weekly": "node scripts/current-affairs/generate-weekly.js",
    "ca:bimonthly": "node scripts/current-affairs/generate-bimonthly.js",
    "ca:monthly": "node scripts/current-affairs/generate-monthly.js",
    "ca:enhance": "node scripts/current-affairs/ai-enhance.js",
    "ca:full": "npm run ca:fetch && npm run ca:process && npm run ca:generate && npm run ca:mcq && npm run ca:weekly && npm run ca:bimonthly && npm run ca:monthly",
    "sj:orchestrator": "node sarkari-jobs/scripts/orchestrator.js",
    "sj:fetch": "node sarkari-jobs/scripts/orchestrator.js --only fetch",
    "sj:download": "node sarkari-jobs/scripts/orchestrator.js --only download",
    "sj:extract": "node sarkari-jobs/scripts/orchestrator.js --only extract",
    "sj:parse": "node sarkari-jobs/scripts/orchestrator.js --only parse",
    "sj:generate": "node sarkari-jobs/scripts/orchestrator.js --only generate",
    "sj:database": "node sarkari-jobs/scripts/orchestrator.js --only database",
    "sj:hub": "node sarkari-jobs/scripts/orchestrator.js --only hub",
    "sj:dry-run": "node sarkari-jobs/scripts/orchestrator.js --dry-run"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@google/genai": "^2.8.0",
    "fast-xml-parser": "^5.0.0",
    "undici": "^7.24.0"
  }
}
