          {
            "en": "Pictographic Script",
            "hi": "चित्रात्मक लिपि (पिक्टोग्राफिक)"
          },
          {
            "en": "Unencrypted undeciphered script, mostly written right to left",
            "hi": "बिना पढ़ी जा सकने वाली अपठित लिपि, जो ज्यादातर दाएं से बाएं लिखी गई है"
          },
          {
            "en": "Indicates high administrative centralization and literacy",
            "hi": "उच्च प्रशासनिक केंद्रीयकरण और साक्षरता को इंगित करता है"
          }
        ],
        [
          {
            "en": "Boss with Perforated Knob",
            "hi": "छिद्रित उभार वाला बॉั้น (Boss with Perforated Knob)"
          },
          {
            "en": "Back of square seals featuring a pierced projection",
            "hi": "वर्षाकार मुहरों का पिछला हिस्सा जिसमें एक छिद्रित उभार होता है"
          },
          {
            "en": "Used for suspension, likely worn as amulets or badges of authority",
            "hi": "लटकाने के लिए प्रयुक्त, संभवतः ताबीज या अधिकार के प्रतीक के रूप में पहना जाता था"
          }
        ],
        [
          {
            "en": "Intaglio Carving",
            "hi": "इंटाग्लियो नक्काशी (Intaglio Carving)"
          },
          {
            "en": "Motifs and script carved deeply into the stone surface",
            "hi": "पत्थर की सतह पर गहराई से उकेरे गए रूपांकन और लिपि"
          },
          {
            "en": "Designed to create raised impressions on clay sealing for trade",
            "hi": "व्यापार के लिए मिट्टी की मुहरों पर उभरी हुई छाप बनाने के लिए डिज़ाइन किया गया"
          }
        ]
      ]
