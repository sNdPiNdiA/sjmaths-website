        {
            "id": "histograms",
            "title": "Histograms",
            "icon": "📶",
            "precheck": {
                "question": "Histograms are used for?",
                "options": [
                    "Continuous Data",
                    "Discrete Categories",
                    "Mean/Mode"
                ],
                "correctIndex": 0,
                "passMessage": "Exactly! Continuous intervals with no gaps.",
                "failMessage": "Histograms require continuous class intervals."
            },
            "learn": {
                "paragraphs": [
                    "**1. Standard Histograms:** Bars touch each other. Width = Class Size. Height = Frequency.",
                    "**2. Varying Widths:** If class sizes differ, the area (not height) must represent the frequency.",
                    "**3. Adjusting Height:** New Height = (Frequency / Class Size) * Minimum Class Size."
                ],
                "formulas": [
                    {
                        "rule": "Adjusted Height",
                        "formula": "H_{adj} = \\frac{f}{w} \\times w_{min}",
                        "example": "f=10, w=20, min_w=10 => H=5"
                    }
                ],
                "boxes": [
                    {
                        "type": "warning",
                        "html": "A <strong>kink (zig-zag line)</strong> is drawn on the X-axis if the first interval doesn't start from zero."
                    }
                ]
            },
