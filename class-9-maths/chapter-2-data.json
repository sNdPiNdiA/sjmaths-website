                "correctIndex": 1,
                "passMessage": "Correct! Highest power is 3.",
                "failMessage": "Degree is the highest power of the variable."
            },
            "learn": {
                "paragraphs": [
                    "**1. Definition:** A polynomial is an expression of the form $a_nx^n + a_{n-1}x^{n-1} + ...$ where powers are whole numbers.",
                    "**2. Degree:** The highest power of the variable in a polynomial.",
                    "**3. Zeros:** A value $k$ such that $p(k) = 0$.",
                    "**4. Classification:** Linear (deg 1), Quadratic (deg 2), Cubic (deg 3)."
                ],
                "formulas": [
                    {
                        "rule": "Zero of Linear Polynomial",
                        "formula": "x = -b/a",
                        "example": "For $3x + 6$, zero is $-6/3 = -2$"
                    }
                ],
                "boxes": [
                    {
                        "type": "info",
                        "html": "A non-zero constant polynomial has degree 0. The zero polynomial has undefined degree."
                    }
                ]
            },
