            "icon": "🍦",
            "precheck": {
                "question": "The curved surface area of a cone with radius r and slant height l is?",
                "options": [
                    "πrl",
                    "2πrh",
                    "πr²l"
                ],
                "correctIndex": 0,
                "passMessage": "Correct! It's πrl.",
                "failMessage": "CSA of a cone is πrl."
            },
            "learn": {
                "paragraphs": [
                    "**1. Slant Height (l):** The distance from the apex to any point on the base circle. $l = \\sqrt{r^2 + h^2}$.",
                    "**2. Curved Surface Area (CSA):** Area of the slanted part. $CSA = \\pi rl$.",
                    "**3. Total Surface Area (TSA):** Area of curved part + circular base. $TSA = \\pi r(l+r)$."
                ],
                "formulas": [
                    {
                        "rule": "Cone Formulas",
                        "formula": "CSA = \\pi rl, \\quad TSA = \\pi r(l+r)",
                        "example": "r=7, l=10 => CSA = 220"
                    }
                ],
                "boxes": [
                    {
                        "type": "warning",
                        "html": "Always check if <strong>height (h)</strong> or <strong>slant height (l)</strong> is given. Use Pythagoras for the missing one!"
                    }
                ]
            },
            "practice": [
