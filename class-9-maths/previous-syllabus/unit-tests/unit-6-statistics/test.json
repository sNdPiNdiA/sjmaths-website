    "questions": [
        {
            "id": "q1",
            "type": "mcq",
            "marks": 1,
            "question": "The class mark of the class 90-120 is",
            "options": [
                "90",
                "105",
                "115",
                "120"
            ],
            "finalAnswer": "(b) 105",
            "solutionSteps": [
                "Class mark = (Upper Limit + Lower Limit) / 2",
                "= (90+120)/2 = 210/2 = 105."
            ]
        },
        {
            "id": "q2",
            "type": "mcq",
            "marks": 1,
            "question": "The range of the data: 25, 18, 20, 22, 16, 6, 17, 15, 12, 30, 32, 10, 19, 8, 11, 20 is",
            "options": [
                "10",
                "15",
                "18",
                "26"
            ],
            "finalAnswer": "(d) 26",
            "solutionSteps": [
                "Highest value = 32",
                "Lowest value = 6",
                "Range = 32 - 6 = 26."
            ]
        },
        {
            "id": "q3",
            "type": "mcq",
            "marks": 1,
            "question": "In a frequency distribution, the mid value of a class is 10 and width of the class is 6. The lower limit of the class is",
            "options": [
                "6",
                "7",
                "8",
                "12"
            ],
            "finalAnswer": "(b) 7",
            "solutionSteps": [
                "Mid-value $M = 10$, Width $h = 6$.",
                "Lower limit $L = M - h/2 = 10 - 3 = 7$."
            ]
        },
        {
            "id": "q4",
            "type": "mcq",
            "marks": 1,
            "question": "A coin is tossed 1000 times and 560 heads were obtained. The probability of getting a tail is",
            "options": [
                "0.44",
                "0.56",
                "0.50",
                "0.40"
            ],
            "finalAnswer": "(a) 0.44",
            "solutionSteps": [
                "Heads = 560. Tails = $1000 - 560 = 440$.",
                "Prob(Tail) = $440/1000 = 0.44$."
            ]
        },
        {
            "id": "q5",
            "type": "subjective",
            "marks": 2,
            "question": "The mean of 5 numbers is 30. If one number is excluded, their mean becomes 28. Find the excluded number.",
            "finalAnswer": "38",
            "solutionSteps": [
                "Sum of 5 numbers = $5 \\times 30 = 150$.",
                "Sum of 4 numbers = $4 \\times 28 = 112$.",
                "Excluded number = $150 - 112 = 38$."
            ]
        },
        {
            "id": "q6",
            "type": "subjective",
            "marks": 3,
            "question": "A die is thrown 1000 times with the frequencies for the outcomes 1, 2, 3, 4, 5 and 6 as given below:\nOutcome: 1(179), 2(150), 3(157), 4(149), 5(175), 6(190).\nFind the probability of getting (i) an odd number, (ii) a number greater than 4.",
            "finalAnswer": "(i) 0.511, (ii) 0.365",
            "solutionSteps": [
                "(i) Odd numbers: 1, 3, 5. Frequency = 179 + 157 + 175 = 511.",
                "P(Odd) = 511/1000 = 0.511.",
                "(ii) > 4: 5, 6. Frequency = 175 + 190 = 365.",
                "P(>4) = 365/1000 = 0.365."
            ]
        },
