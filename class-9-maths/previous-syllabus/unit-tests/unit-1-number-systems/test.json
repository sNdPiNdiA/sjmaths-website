    "questions": [
        {
            "id": "q1",
            "type": "mcq",
            "marks": 1,
            "question": "Which of the following is a rational number?",
            "options": [
                "$\\sqrt{3}$",
                "$\\pi$",
                "$\\frac{22}{7}$",
                "$0.1010010001\\dots$"
            ],
            "finalAnswer": "(c) $\\frac{22}{7}$",
            "solutionSteps": [
                "A rational number is of the form $p/q$ where $q \\neq 0$.",
                "$\\sqrt{3}$ is irrational.",
                "$\\pi$ is irrational.",
                "$\\frac{22}{7}$ is a fraction $p/q$, so it is rational.",
                "$0.101001\\dots$ is non-terminating non-recurring, so irrational."
            ]
        },
        {
            "id": "q2",
            "type": "mcq",
            "marks": 1,
            "question": "The decimal representation of a rational number cannot be",
            "options": [
                "Terminating",
                "Non-terminating",
                "Non-terminating repeating",
                "Non-terminating non-repeating"
            ],
            "finalAnswer": "(d) Non-terminating non-repeating",
            "solutionSteps": [
                "Rational numbers have either terminating or non-terminating repeating decimal expansions.",
                "Non-terminating non-repeating decimals correspond to irrational numbers."
            ]
        },
        {
            "id": "q3",
            "type": "mcq",
            "marks": 1,
            "question": "The value of $(3 + \\sqrt{3})(3 - \\sqrt{3})$ is",
            "options": [
                "6",
                "9",
                "3",
                "0"
            ],
            "finalAnswer": "(a) 6",
            "solutionSteps": [
                "Use identity $(a+b)(a-b) = a^2 - b^2$.",
                "$(3)^2 - (\\sqrt{3})^2 = 9 - 3 = 6$."
            ]
        },
        {
            "id": "q4",
            "type": "mcq",
            "marks": 1,
            "question": "Every integer is a",
            "options": [
                "Natural number",
                "Rational number",
                "Whole number",
                "Irrational number"
            ],
            "finalAnswer": "(b) Rational number",
            "solutionSteps": [
                "Every integer $z$ can be written as $z/1$.",
                "Since it can be expressed in $p/q$ form, it is a rational number."
            ]
        },
        {
            "id": "q5",
            "type": "mcq",
            "marks": 1,
            "question": "Simplifying $\\sqrt[3]{2} \\times \\sqrt[4]{2}$ gives",
            "options": [
                "$\\sqrt[12]{2^7}$",
                "$\\sqrt[7]{2^{12}}$",
                "$\\sqrt[12]{2}$",
                "$\\sqrt[7]{2}$"
            ],
            "finalAnswer": "(a) $\\sqrt[12]{2^7}$",
            "solutionSteps": [
                "$2^{1/3} \\times 2^{1/4} = 2^{1/3 + 1/4} = 2^{(4+3)/12} = 2^{7/12}$",
                "This can be written as $\\sqrt[12]{2^7}$."
            ]
        },
        {
            "id": "q6",
            "type": "subjective",
            "marks": 2,
            "question": "Find five rational numbers between 1 and 2.",
            "finalAnswer": "1.1, 1.2, 1.3, 1.4, 1.5 (Sample answer)",
            "solutionSteps": [
                "There are infinite rational numbers between 1 and 2.",
                "We can write 1 as 10/10 and 2 as 20/10.",
                "Five numbers could be 11/10, 12/10, 13/10, 14/10, 15/10."
            ]
        },
        {
            "id": "q7",
            "type": "subjective",
            "marks": 3,
            "question": "Locate $\\sqrt{2}$ on the number line.",
            "finalAnswer": "Construction",
            "solutionSteps": [
                "Take a unit length OA on the number line from 0 to 1.",
                "Draw a perpendicular AB of unit length at A.",
                "Join OB. By Pythagoras theorem, $OB = \\sqrt{1^2 + 1^2} = \\sqrt{2}$.",
                "Using a compass with center O and radius OB, draw an arc intersecting the number line at point P.",
                "Point P represents $\\sqrt{2}$."
            ]
        },
        {
            "id": "q8",
            "type": "subjective",
            "marks": 3,
            "question": "Express $0.4777\\dots$ in the form $p/q$.",
            "finalAnswer": "43/90",
            "solutionSteps": [
                "Let $x = 0.4777\\dots$",
                "Multiply by 10: $10x = 4.777\\dots$ (i)",
                "Multiply by 100: $100x = 47.777\\dots$ (ii)",
                "Subtract (i) from (ii): $90x = 43$.",
                "$x = 43/90$."
            ]
        },
        {
            "id": "q9",
            "type": "subjective",
            "marks": 5,
            "question": "Simplify: $\\frac{1}{3-\\sqrt{8}} - \\frac{1}{\\sqrt{8}-\\sqrt{7}} + \\frac{1}{\\sqrt{7}-\\sqrt{6}} - \\frac{1}{\\sqrt{6}-\\sqrt{5}} + \\frac{1}{\\sqrt{5}-2}$",
            "finalAnswer": "5",
            "solutionSteps": [
                "Rationalize each term.",
                "$\\frac{1}{3-\\sqrt{8}} = 3+\\sqrt{8}$",
                "$\\frac{1}{\\sqrt{8}-\\sqrt{7}} = \\sqrt{8}+\\sqrt{7}$",
                "... and so on.",
                "Expression becomes: $(3+\\sqrt{8}) - (\\sqrt{8}+\\sqrt{7}) + (\\sqrt{7}+\\sqrt{6}) - (\\sqrt{6}+\\sqrt{5}) + (\\sqrt{5}+2)$",
                "$3 + 2 = 5$."
            ]
        },
        {
            "id": "q10",
            "type": "subjective",
            "marks": 5,
            "question": "If $x = \\frac{\\sqrt{3}+\\sqrt{2}}{\\sqrt{3}-\\sqrt{2}}$, find $x^2 + \\frac{1}{x^2}$.",
            "finalAnswer": "98",
            "solutionSteps": [
                "Rationalize $x$: $x = (\\sqrt{3}+\\sqrt{2})^2 / (3-2) = 5 + 2\\sqrt{6}$.",
                "Then $1/x = 5 - 2\\sqrt{6}$.",
                "$x + 1/x = 10$.",
                "Squaring both sides: $(x+1/x)^2 = 100$.",
                "$x^2 + 1/x^2 + 2 = 100 \\implies x^2 + 1/x^2 = 98$."
            ]
        }
    ]
