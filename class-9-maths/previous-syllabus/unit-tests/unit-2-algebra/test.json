        {
            "id": "q5",
            "type": "subjective",
            "marks": 2,
            "question": "Evaluate $(99)^2$ using a suitable identity.",
            "finalAnswer": "9801",
            "solutionSteps": [
                "$99 = 100 - 1$.",
                "$(100-1)^2 = (100)^2 - 2(100)(1) + (1)^2$.",
                "$10000 - 200 + 1 = 9801$."
            ]
        },
        {
            "id": "q6",
            "type": "subjective",
            "marks": 2,
            "question": "Find the value of $k$, if $x = 2, y = 1$ is a solution of the equation $2x + 3y = k$.",
            "finalAnswer": "7",
            "solutionSteps": [
                "Substitute $x=2, y=1$.",
                "$2(2) + 3(1) = k$.",
                "$4 + 3 = k \\implies k = 7$."
            ]
        },
