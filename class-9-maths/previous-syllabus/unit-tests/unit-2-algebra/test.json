            "marks": 1,
            "question": "Which of the following is a polynomial in one variable?",
            "options": [
                "$x + \\frac{2}{x}$",
                "$3\\sqrt{2}x^2 - 5x$",
                "$\\sqrt{x} + 3$",
                "$x^{10} + y^3 + t^{50}$"
            ],
            "finalAnswer": "(b) $3\\sqrt{2}x^2 - 5x$",
            "solutionSteps": [
                "Polynomials must have whole number exponents.",
                "$2/x = 2x^{-1}$ (exponent -1 is not whole).",
                "$\\sqrt{x} = x^{1/2}$ (exponent 1/2 is not whole).",
                "Option (d) has 3 variables.",
                "Option (b) has exponents 2 and 1, which are whole numbers."
            ]
        },
        {
            "id": "q2",
            "type": "mcq",
            "marks": 1,
            "question": "The zero of the polynomial $p(x) = 2x + 5$ is",
            "options": [
                "2",
                "5",
                "-5/2",
                "2/5"
            ],
            "finalAnswer": "(c) -5/2",
            "solutionSteps": [
                "Set $p(x) = 0 \\implies 2x + 5 = 0$.",
                "$2x = -5 \\implies x = -5/2$."
            ]
        },
