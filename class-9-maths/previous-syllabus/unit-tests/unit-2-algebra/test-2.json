        {
            "id": "q1",
            "type": "mcq",
            "marks": 1,
            "question": "The coefficient of $x^2$ in $(3x-5)(4+2x)$ is",
            "options": [
                "12",
                "6",
                "-10",
                "2"
            ],
            "finalAnswer": "(b) 6",
            "solutionSteps": [
                "Expand $(3x-5)(4+2x) = 12x + 6x^2 - 20 - 10x$.",
                "Simplified: $6x^2 + 2x - 20$.",
                "The coefficient of $x^2$ is 6."
            ]
        },
        {
            "id": "q2",
            "type": "mcq",
            "marks": 1,
            "question": "If $x + 2$ is a factor of $x^3 - 2ax^2 + 16$, then value of $a$ is",
            "options": [
                "-1",
                "1",
                "2",
                "4"
            ],
            "finalAnswer": "(b) 1",
            "solutionSteps": [
                "If $(x+2)$ is a factor, then $p(-2) = 0$.",
                "$(-2)^3 - 2a(-2)^2 + 16 = 0$",
                "$-8 - 8a + 16 = 0 \\implies 8a = 8 \\implies a = 1$."
            ]
        },
        {
            "id": "q3",
            "type": "mcq",
            "marks": 1,
            "question": "The value of $249^2 - 248^2$ is",
            "options": [
                "1",
                "497",
                "487",
                "501"
            ],
            "finalAnswer": "(b) 497",
            "solutionSteps": [
                "Use $a^2 - b^2 = (a-b)(a+b)$.",
                "$(249-248)(249+248) = 1 \\times 497 = 497$."
            ]
        },
        {
            "id": "q4",
            "type": "mcq",
            "marks": 1,
            "question": "Which of the following is a zero of the polynomial $x^2 - 2x - 3$?",
            "options": [
                "1",
                "-1",
                "2",
                "-2"
            ],
            "finalAnswer": "(b) -1",
            "solutionSteps": [
                "Check for $x = -1$: $(-1)^2 - 2(-1) - 3 = 1 + 2 - 3 = 0$.",
                "So, -1 is a zero."
            ]
        },
        {
