            "id": "herons-basics",
            "title": "Heron's Formula Basics",
            "icon": "📐",
            "precheck": {
                "question": "What is 's' in Heron's Formula?",
                "options": [
                    "Side length",
                    "Semi-perimeter",
                    "Surface Area"
                ],
                "correctIndex": 1,
                "passMessage": "Correct! s = (a+b+c)/2.",
                "failMessage": "'s' stands for semi-perimeter."
            },
            "learn": {
                "paragraphs": [
                    "**Heron's Formula** is used to find the area of a triangle when all three sides are known, even without the height.",
                    "1. Calculate semi-perimeter: $s = \\frac{a + b + c}{2}$",
                    "2. Calculate Area: $A = \\sqrt{s(s-a)(s-b)(s-c)}$"
                ],
                "formulas": [
                    {
                        "rule": "Heron's Formula",
                        "formula": "$\\text{Area} = \\sqrt{s(s-a)(s-b)(s-c)}$",
                        "example": "Sides 3, 4, 5 => s=6, Area=6"
                    }
                ],
                "boxes": [
                    {
                        "type": "info",
                        "html": "This formula was developed by Heron of Alexandria in 60 AD."
                    }
                ]
            },
            "practice": [
                {
                    "question": "Sides 13, 14, 15. Find s.",
                    "options": [
                        "21",
                        "42",
                        "20"
                    ],
                    "correctIndex": 0,
                    "solution": "(13+14+15)/2 = 21."
                },
                {
                    "question": "Sides 3, 4, 5. Find Area.",
                    "options": [
                        "6",
                        "12",
                        "None"
                    ],
                    "correctIndex": 0,
                    "solution": "s=6. √(6*3*2*1) = 6."
                },
                {
                    "question": "Sides 5, 12, 13. Area?",
                    "options": [
                        "30",
                        "60",
                        "None"
                    ],
                    "correctIndex": 0,
                    "solution": "1/2 * 5 * 12 = 30."
                },
                {
