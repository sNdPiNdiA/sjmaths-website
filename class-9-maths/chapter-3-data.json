        {
            "id": "ap-concepts",
            "title": "Arithmetic Progressions and nth Term",
            "icon": "AP",
            "precheck": {
                "question": "Which of these is an AP?",
                "options": [
                    "3, 7, 11, 15",
                    "2, 4, 8, 16",
                    "1, 4, 9, 16"
                ],
                "correctIndex": 0,
                "passMessage": "Correct. The common difference is 4.",
                "failMessage": "In an AP, the difference between consecutive terms stays constant."
            },
            "learn": {
                "paragraphs": [
                    "**1. AP Meaning:** An Arithmetic Progression has a fixed common difference $d$.",
                    "**2. Standard Form:** $a, a+d, a+2d, a+3d, ldots$",
                    "**3. nth Term:** The nth term of an AP is $a_n = a + (n-1)d$.",
                    "**4. Visualising AP:** If you graph term number against term value, the points rise in a straight-line pattern.",
                    "**5. Practical Contexts:** Weekly pocket money, staircase steps, fixed increase in marks, and row patterns often form APs."
                ],
                "formulas": [
                    {
                        "rule": "nth Term of AP",
                        "formula": "a_n = a + (n-1)d",
                        "example": "For 5, 8, 11, 14, ... the 6th term is 5 + 5(3) = 20."
                    },
                    {
                        "rule": "Natural Number Sum",
                        "formula": "1 + 2 + cdots + n = \frac{n(n+1)}{2}",
                        "example": "For n = 8, the sum is 36."
                    }
                ],
                "boxes": [
                    {
                        "type": "info",
                        "html": "The natural numbers $1, 2, 3, 4, ldots$ form an AP with first term 1 and common difference 1."
                    }
                ]
            },
            "practice": [
                {
                    "question": "Find d for 6, 10, 14, 18.",
                    "options": [
                        "4",
                        "6",
                        "2"
                    ],
                    "correctIndex": 0,
                    "solution": "Subtract consecutive terms."
                },
                {
                    "question": "Find the 5th term of 3, 7, 11, 15, ...",
                    "options": [
                        "19",
                        "20",
                        "23"
                    ],
                    "correctIndex": 0,
                    "solution": "a = 3, d = 4."
                },
                {
                    "question": "Do 2, 5, 8, 11 form an AP?",
                    "options": [
                        "Yes",
                        "No"
                    ],
                    "correctIndex": 0,
                    "solution": "Difference is 3 each time."
                },
                {
                    "question": "Sum of first 5 natural numbers?",
                    "options": [
                        "15",
                        "10",
                        "20"
                    ],
                    "correctIndex": 0,
                    "solution": "5(6)/2 = 15."
                },
                {
                    "question": "For an AP, a = 9 and d = -2. What is a_4?",
                    "options": [
                        "3",
                        "5",
                        "7"
                    ],
                    "correctIndex": 0,
                    "solution": "9 + 3(-2) = 3."
                }
            ],
            "test": [
                {
                    "question": "An AP always has constant difference.",
                    "options": [
                        "True",
                        "False"
                    ],
                    "correctIndex": 0,
                    "solution": "Definition."
                },
                {
                    "question": "Sequence 2, 4, 8, 16 is an AP.",
                    "options": [
                        "False",
                        "True"
                    ],
                    "correctIndex": 0,
                    "solution": "It is a GP."
                },
                {
                    "question": "The formula for sum of first n natural numbers is n(n+1)/2.",
                    "options": [
                        "True",
                        "False"
                    ],
                    "correctIndex": 0,
                    "solution": "Standard result."
                }
            ]
        },
        {
            "id": "gp-fractals",
            "title": "Geometric Progressions and Fractals",
            "icon": "GP",
            "precheck": {
                "question": "Which of these is a GP?",
                "options": [
                    "2, 6, 18, 54",
                    "4, 8, 12, 16",
                    "1, 3, 6, 10"
                ],
                "correctIndex": 0,
                "passMessage": "Correct. Each term is multiplied by 3.",
                "failMessage": "In a GP, the ratio between consecutive terms stays constant."
            },
            "learn": {
                "paragraphs": [
                    "**1. GP Meaning:** A Geometric Progression has a fixed common ratio $r$.",
                    "**2. Standard Form:** $a, ar, ar^2, ar^3, ldots$",
                    "**3. nth Term:** The nth term of a GP is $a_n = ar^{n-1}$.",
                    "**4. Visualising GP:** A graph of term number against term value grows much faster than an AP when $r > 1$.",
                    "**5. Fractals:** In fractals, the number of parts or the size of parts often follows a GP."
                ],
                "formulas": [
                    {
                        "rule": "nth Term of GP",
                        "formula": "a_n = ar^{n-1}",
                        "example": "For 3, 6, 12, 24, ... the 5th term is 48."
                    },
                    {
                        "rule": "Fractal Scaling Example",
                        "formula": "1, \frac13, \frac19, \frac1{27}, ldots",
                        "example": "Each stage multiplies length by 1/3."
                    }
                ],
                "boxes": [
                    {
                        "type": "tip",
                        "html": "If the count doubles at each stage, the count follows a GP with ratio 2. If each piece becomes one-third as long, the lengths follow a GP with ratio 1/3."
                    }
                ]
            },
            "practice": [
                {
                    "question": "Find r for 5, 10, 20, 40.",
                    "options": [
                        "2",
                        "5",
                        "10"
                    ],
                    "correctIndex": 0,
                    "solution": "Divide consecutive terms."
                },
                {
                    "question": "Find the 4th term of 3, 6, 12, 24, ...",
                    "options": [
                        "24",
                        "18",
                        "48"
                    ],
                    "correctIndex": 0,
                    "solution": "Multiply by 2."
                },
                {
                    "question": "Does 2, 4, 8, 16 form a GP?",
                    "options": [
                        "Yes",
                        "No"
                    ],
                    "correctIndex": 0,
                    "solution": "Common ratio 2."
                },
                {
                    "question": "A fractal piece length sequence 1, 1/3, 1/9, ... has ratio?",
                    "options": [
                        "1/3",
                        "3",
                        "1/9"
                    ],
                    "correctIndex": 0,
                    "solution": "Multiply by 1/3 each time."
                },
                {
                    "question": "For a GP, a = 2 and r = 3. What is a_3?",
                    "options": [
                        "18",
                        "12",
                        "9"
                    ],
                    "correctIndex": 0,
                    "solution": "2 x 3^2 = 18."
                }
            ],
            "test": [
                {
                    "question": "A GP always has constant ratio.",
                    "options": [
                        "True",
                        "False"
                    ],
                    "correctIndex": 0,
                    "solution": "Definition."
                },
                {
                    "question": "3, 6, 9, 12 is a GP.",
                    "options": [
                        "False",
                        "True"
                    ],
                    "correctIndex": 0,
                    "solution": "It is an AP."
                },
                {
                    "question": "Fractal scaling can be modelled using GP.",
                    "options": [
                        "True",
