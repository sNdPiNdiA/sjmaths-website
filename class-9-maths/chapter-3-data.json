                "correctIndex": 0,
                "passMessage": "Correct! It's denoted by O(0,0).",
                "failMessage": "The intersection point is called the Origin."
            },
            "learn": {
                "paragraphs": [
                    "**1. The Axes:** Two perpendicular number lines. Horizontal is **$x$-axis**, Vertical is **$y$-axis**.",
                    "**2. The Plane:** The flat surface containing them is the **Cartesian Plane** or $xy$-plane.",
                    "**3. The Origin:** The intersection point $(0,0)$, denoted by $O$.",
                    "**4. Quadrants:** The axes divide the plane into 4 parts called **Quadrants**, numbered I, II, III, IV in anti-clockwise direction."
                ],
                "formulas": [
                    {
                        "rule": "Coordinate Axes",
                        "formula": "X'OX \\perp Y'OY",
                        "example": "Horizontal and Vertical lines"
                    }
                ],
                "boxes": [
                    {
                        "type": "tip",
                        "html": "The distance of a point from the $y$-axis is its $x$-coordinate, and from the $x$-axis is its $y$-coordinate."
