    "concepts": [
        {
            "id": "sequence-basics",
            "title": "Sequences, Explicit Rules, and Recursive Rules",
            "icon": "SEQ",
            "precheck": {
                "question": "In the sequence 4, 7, 10, 13, what is the next term?",
                "options": [
                    "16",
                    "15",
                    "17"
                ],
                "correctIndex": 0,
                "passMessage": "Correct. The pattern adds 3 each time.",
                "failMessage": "Check the difference between consecutive terms."
            },
            "learn": {
                "paragraphs": [
                    "**1. Sequence:** A sequence is an ordered list of numbers arranged according to a rule.",
                    "**2. Explicit Rule:** An explicit or general rule gives the nth term directly. Example: $a_n = 3n + 1$.",
                    "**3. Recursive Rule:** A recursive rule tells how to get a term from the previous term. Example: $a_1 = 4,\\; a_n = a_{n-1} + 3$.",
                    "**4. Pattern Prediction:** To predict the next terms, first identify whether the pattern changes by adding or multiplying."
                ],
                "formulas": [
                    {
                        "rule": "Explicit Rule Example",
                        "formula": "a_n = 3n + 1",
                        "example": "For n = 5, the term is 16."
                    },
                    {
                        "rule": "Recursive Rule Example",
                        "formula": "a_1 = 4,\\; a_n = a_{n-1} + 3",
                        "example": "4, 7, 10, 13, ..."
                    }
                ],
                "boxes": [
                    {
                        "type": "tip",
                        "html": "Explicit rules are useful when you want the nth term directly. Recursive rules are useful when you want to generate terms step by step."
                    }
                ]
            },
            "practice": [
                {
                    "question": "Which rule is explicit?",
                    "options": [
                        "a_n = 5n - 2",
                        "a_n = a_{n-1} + 5"
                    ],
                    "correctIndex": 0,
                    "solution": "It depends directly on n."
                },
                {
                    "question": "Which rule is recursive?",
                    "options": [
                        "a_n = a_{n-1} + 2",
                        "a_n = 2n + 3"
                    ],
                    "correctIndex": 0,
                    "solution": "It uses the previous term."
                },
                {
                    "question": "Next term of 2, 5, 8, 11 is?",
                    "options": [
                        "14",
                        "13",
                        "16"
                    ],
                    "correctIndex": 0,
                    "solution": "Add 3."
                },
                {
                    "question": "For a_n = 4n + 1, find a_3.",
                    "options": [
                        "13",
                        "9",
                        "12"
                    ],
                    "correctIndex": 0,
                    "solution": "4(3)+1 = 13."
                },
                {
                    "question": "If a_1 = 6 and a_n = a_{n-1} + 4, then a_2 is?",
                    "options": [
                        "10",
                        "8",
                        "12"
                    ],
                    "correctIndex": 0,
                    "solution": "6 + 4 = 10."
                }
            ],
            "test": [
