                "correctIndex": 0,
                "passMessage": "Correct. The rule is 2^n - 1.",
                "failMessage": "Use the formula 2^n - 1."
            },
            "learn": {
                "paragraphs": [
                    "**1. Puzzle Rule:** Move one disk at a time, and never place a larger disk on a smaller one.",
                    "**2. Recursive Thinking:** To move $n$ disks, first move $n-1$ disks, then move the largest disk, then move the $n-1$ disks again.",
                    "**3. Move Formula:** Minimum number of moves is $2^n - 1$.",
                    "**4. Computational Thinking:** Break a large task into smaller repeated tasks and write a step-by-step procedure."
                ],
                "formulas": [
                    {
                        "rule": "Tower of Hanoi Moves",
                        "formula": "T_n = 2^n - 1",
                        "example": "For 4 disks, minimum moves = 15."
                    },
                    {
                        "rule": "Recursive Relation",
                        "formula": "T_n = 2T_{n-1} + 1",
                        "example": "Move n-1 disks, largest disk, then n-1 disks again."
                    }
                ],
                "boxes": [
                    {
                        "type": "info",
                        "html": "This puzzle is a good example of recursion and decomposition, two important computational thinking ideas."
                    }
                ]
            },
