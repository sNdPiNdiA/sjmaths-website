        {
            "id": "tower-hanoi-thinking",
            "title": "Tower of Hanoi and Computational Thinking",
            "icon": "CT",
            "precheck": {
                "question": "Minimum moves needed for 3 disks in Tower of Hanoi?",
                "options": [
                    "7",
                    "6",
