        {
            "id": "q1",
            "type": "mcq",
            "marks": 1,
            "question": "The area of an isosceles triangle each of whose equal sides is 13 cm and whose base is 24 cm is",
            "options": [
                "156 cm²",
                "78 cm²",
                "60 cm²",
                "120 cm²"
            ],
            "finalAnswer": "(c) 60 cm²",
            "solutionSteps": [
                "Height $h = \\sqrt{13^2 - (24/2)^2} = \\sqrt{169 - 144} = \\sqrt{25} = 5$ cm.",
                "Area = $1/2 \\times \\text{base} \\times \\text{height} = 1/2 \\times 24 \\times 5 = 60$ cm²."
            ]
        },
        {
            "id": "q2",
            "type": "mcq",
            "marks": 1,
            "question": "If the length of side of an equilateral triangle is $2\\sqrt{3}$ cm, then its area is",
            "options": [
                "$3\\sqrt{3}$ cm²",
                "3 cm²",
                "$2\\sqrt{3}$ cm²",
                "6 cm²"
            ],
            "finalAnswer": "(a) $3\\sqrt{3}$ cm²",
            "solutionSteps": [
                "Area of equilateral triangle = $(\\sqrt{3}/4) s^2$.",
                "Area = $(\\sqrt{3}/4) (2\\sqrt{3})^2 = (\\sqrt{3}/4) \\times 12 = 3\\sqrt{3}$ cm²."
            ]
        },
        {
            "id": "q3",
            "type": "mcq",
            "marks": 1,
            "question": "The total surface area of a cube is 96 cm². The volume of the cube is",
            "options": [
                "8 cm³",
                "512 cm³",
                "64 cm³",
                "27 cm³"
            ],
            "finalAnswer": "(c) 64 cm³",
            "solutionSteps": [
                "TSA = $6a^2 = 96 \\implies a^2 = 16 \\implies a = 4$.",
                "Volume = $a^3 = 4^3 = 64$ cm³."
            ]
        },
        {
            "id": "q4",
            "type": "mcq",
            "marks": 1,
            "question": "The radius of a sphere is 2r, then its volume will be",
            "options": [
                "$(4/3)\\pi r^3$",
                "$4\\pi r^3$",
                "$(8/3)\\pi r^3$",
                "$(32/3)\\pi r^3$"
            ],
            "finalAnswer": "(d) $(32/3)\\pi r^3$",
            "solutionSteps": [
                "Volume of sphere = $(4/3)\\pi R^3$.",
                "Here $R = 2r$, so Vol = $(4/3)\\pi (2r)^3 = (4/3)\\pi (8r^3) = (32/3)\\pi r^3$."
            ]
        },
        {
            "id": "q5",
            "type": "mcq",
            "marks": 1,
            "question": "The lateral surface area of a cylinder is $94.2$ cm² and its height is 5 cm. Then its radius is (take $\\pi = 3.14$)",
            "options": [
                "2 cm",
                "3 cm",
                "4 cm",
                "5 cm"
            ],
            "finalAnswer": "(b) 3 cm",
            "solutionSteps": [
                "LSA = $2\\pi rh = 94.2$.",
                "$2 \\times 3.14 \\times r \\times 5 = 94.2$",
                "$31.4 \\times r = 94.2 \\implies r = 3$."
            ]
        },
        {
            "id": "q6",
            "type": "subjective",
            "marks": 3,
            "question": "A park, in the shape of a quadrilateral ABCD, has $\\angle C = 90^circ$, AB = 9 m, BC = 12 m, CD = 5 m and AD = 8 m. How much area does it occupy?",
            "finalAnswer": "65.5 m²",
            "solutionSteps": [
                "Diagonal $BD = \\sqrt{BC^2 + CD^2} = \\sqrt{12^2 + 5^2} = 13$ m.",
                "Area $\\triangle BCD = 1/2 \\times 12 \\times 5 = 30$ m².",
                "For $\\triangle ABD$, semi-perimeter $s = (9+8+13)/2 = 15$.",
                "Area $\\triangle ABD = \\sqrt{15(15-9)(15-8)(15-13)} = \\sqrt{15 \\times 6 \\times 7 \\times 2} = \\sqrt{1260} \\approx 35.5$ m².",
                "Total area = $30 + 35.5 = 65.5$ m²."
            ]
        },
        {
            "id": "q7",
            "type": "subjective",
            "marks": 3,
            "question": "The sides of a triangular plot are in the ratio of 3 : 5 : 7 and its perimeter is 300 m. Find its area.",
            "finalAnswer": "$1500\\sqrt{3}$ m²",
            "solutionSteps": [
                "Let sides be $3x, 5x, 7x$. $15x = 300 \\implies x = 20$.",
                "Sides are 60 m, 100 m, 140 m. $s = 150$.",
                "Area = $\\sqrt{150(150-60)(150-100)(150-140)} = \\sqrt{150 \\times 90 \\times 50 \\times 10}$",
                "$= \\sqrt{6,750,000} = 1500\\sqrt{3}$ m²."
            ]
        },
        {
            "id": "q8",
            "type": "subjective",
            "marks": 4,
            "question": "A conical tent is 10 m high and the radius of its base is 24 m. Find (i) slant height of the tent. (ii) cost of the canvas required to make the tent, if the cost of 1 m² canvas is Rs 70.",
            "finalAnswer": "26 m, Rs 137280",
            "solutionSteps": [
                "(i) Slant height $l = \\sqrt{10^2 + 24^2} = \\sqrt{100 + 576} = 26$ m.",
                "(ii) CSA = $\\pi rl = (22/7) \\times 24 \\times 26 = 13728/7$ m².",
                "Cost = $(13728/7) \\times 70 = 137280$ Rs."
            ]
        },
        {
            "id": "q9",
            "type": "subjective",
            "marks": 5,
            "question": "A lead pencil consists of a cylinder of wood with a solid cylinder of graphite filled in the interior. The diameter of the pencil is 7 mm and the diameter of the graphite is 1 mm. If the length of the pencil is 14 cm, find the volume of the wood and that of the graphite.",
            "finalAnswer": "Graphite: 0.11 cm³, Wood: 5.28 cm³",
            "solutionSteps": [
                "Length $h = 14$ cm. $R_{pencil} = 0.35$ cm. $r_{graphite} = 0.05$ cm.",
                "Vol(Graphite) = $\\pi r^2 h = (22/7) \\times (0.05)^2 \\times 14 = 44 \\times 0.0025 = 0.11$ cm³.",
                "Vol(Wood) = $\\pi (R^2 - r^2) h = (22/7) \\times (0.35^2 - 0.05^2) \\times 14$",
                "$= 44 \\times (0.1225 - 0.0025) = 44 \\times 0.12 = 5.28$ cm³."
            ]
        },
        {
            "id": "q10",
            "type": "subjective",
            "marks": 5,
            "question": "The capacity of a closed cylindrical vessel of height 1 m is 15.4 litres. How many square metres of metal sheet would be needed to make it?",
            "options": [],
            "finalAnswer": "0.4708 m²",
            "solutionSteps": [
                "Volume = 15.4 L = 0.0154 m³. Height $h = 1$ m.",
                "$\\pi r^2 h = 0.0154 \\implies (22/7) \\times r^2 \\times 1 = 0.0154$.",
                "$r^2 = 0.0154 \\times 7 / 22 = 0.0007 \\times 7 = 0.0049$. So $r = 0.07$ m.",
                "TSA = $2\\pi r(r+h) = 2 \\times (22/7) \\times 0.07 \\times (0.07 + 1)$",
                "$= 0.44 \\times 1.07 = 0.4708$ m²."
            ]
        }
    ]
