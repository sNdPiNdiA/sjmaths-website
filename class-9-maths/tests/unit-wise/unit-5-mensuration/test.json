        {
            "id": "q5",
            "type": "subjective",
            "marks": 2,
            "question": "Find the area of a triangle whose sides are 3 cm, 4 cm and 5 cm.",
            "finalAnswer": "6 cm²",
            "solutionSteps": [
                "$s = (3+4+5)/2 = 6$.",
                "Area = $\\sqrt{6(6-3)(6-4)(6-5)} = \\sqrt{6 \\cdot 3 \\cdot 2 \\cdot 1} = \\sqrt{36} = 6$."
            ]
        },
        {
            "id": "q6",
            "type": "subjective",
            "marks": 3,
            "question": "The curved surface area of a right circular cylinder of height 14 cm is 88 cm². Find the diameter of the base of the cylinder.",
            "finalAnswer": "2 cm",
            "solutionSteps": [
                "CSA = $2\\pi r h = 88$.",
                "$2 \\times \\frac{22}{7} \\times r \\times 14 = 88$.",
                "$88r = 88 \\implies r = 1$.",
                "Diameter = $2r = 2$ cm."
            ]
        },
        {
            "id": "q7",
            "type": "subjective",
            "marks": 3,
            "question": "A hemispherical bowl has a radius of 3.5 cm. What would be the volume of water it would contain?",
            "finalAnswer": "89.83 cm³",
            "solutionSteps": [
                "Volume = $\\frac{2}{3}\\pi r^3$.",
                "$= \\frac{2}{3} \\times \\frac{22}{7} \\times (3.5)^3$.",
                "$= \\frac{44}{21} \\times 42.875 \\approx 89.83$ cm³."
            ]
        },
        {
            "id": "q8",
            "type": "subjective",
            "marks": 5,
            "question": "The slant height and base diameter of a conical tomb are 25 m and 14 m respectively. Find the cost of white-washing its curved surface at the rate of ₹210 per 100 m².",
            "finalAnswer": "₹1155",
            "solutionSteps": [
                "$r = 14/2 = 7$ m, $l = 25$ m.",
                "CSA = $\\pi r l = \\frac{22}{7} \\times 7 \\times 25 = 550$ m².",
                "Cost = $\\frac{550 \\times 210}{100} = 55 \\times 21 = 1155$."
            ]
        }
    ]
