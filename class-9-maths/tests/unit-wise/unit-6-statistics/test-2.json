            "question": "Find the mean, median and mode of the following data: 41, 39, 48, 52, 46, 62, 54, 40, 96, 52, 98, 40, 42, 52, 60.",
            "finalAnswer": "Mean: 54.5, Median: 48, Mode: 52",
            "solutionSteps": [
                "Ascending order: 39, 40, 40, 41, 42, 46, 48, 52, 52, 52, 54, 60, 62, 96, 98 ($n=15$).",
                "Mean = Sum/15 = 818/15 $\\approx$ 54.53.",
                "Median = 8th term = 52. (Re-counting... 39(1), 40(2), 40(3), 41(4), 42(5), 46(6), 48(7), 52(8)). Yes, 52.",
                "Mode = 52 (appears 3 times)."
            ]
        }
