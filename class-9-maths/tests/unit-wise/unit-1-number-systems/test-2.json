        {
            "id": "q10",
            "type": "subjective",
            "marks": 5,
            "question": "If $x = 3 + 2\\sqrt{2}$, find the value of $x^4 + \\frac{1}{x^4}$.",
            "finalAnswer": "1154",
            "solutionSteps": [
                "$x = 3 + 2\\sqrt{2} \\implies 1/x = 3 - 2\\sqrt{2}$.",
                "$x + 1/x = 6$.",
                "$x^2 + 1/x^2 = (x+1/x)^2 - 2 = 36 - 2 = 34$.",
                "$x^4 + 1/x^4 = (x^2+1/x^2)^2 - 2 = 34^2 - 2 = 1156 - 2 = 1154$."
            ]
        }
