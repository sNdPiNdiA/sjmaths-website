            "type": "subjective",
            "marks": 3,
            "question": "Divide $3x^4 - 4x^3 - 3x - 1$ by $x - 1$ and find the remainder.",
            "finalAnswer": "-5",
            "solutionSteps": [
                "Use Remainder Theorem: Put x = 1.",
                "$3(1)^4 - 4(1)^3 - 3(1) - 1 = 3 - 4 - 3 - 1 = -5$."
            ]
