        {
            "id": "pt1_q15",
            "section": "Section C",
            "type": "subjective",
            "marks": 3,
            "question": "In an isosceles triangle ABC with AB = AC, D and E are points on BC such that BE = CD. Show that AD = AE.",
            "finalAnswer": "Proof",
            "solutionSteps": [
                "In $\\triangle ABD$ and $\\triangle ACE$:",
                "AB = AC (Given).",
                "$\\\\angle B = \\\\angle C$ (Angles opposite to equal sides).",
                "$BD = BE - DE$ and $CE = CD - DE$. Since BE = CD, then BD = CE.",
                "$\\\\triangle ABD \\\\cong \\\\triangle ACE$ (SAS).",
                "AD = AE (CPCT)."
            ]
        },
        {
            "id": "pt1_q16",
            "section": "Section C",
            "type": "subjective",
            "marks": 3,
            "question": "The diameter of a roller is 84 cm and its length is 120 cm. It takes 500 complete revolutions to move once over to level a playground. Find the area of the playground in m².",
            "finalAnswer": "1584 m²",
            "solutionSteps": [
                "CSA = $2\\pi rh = 2 \\times (22/7) \\times 42 \\times 120 = 31680$ cm².",
                "Area per rev = 3.168 m².",
                "Total area = $500 \\times 3.168 = 1584$ m²."
            ]
        },
        {
            "id": "pt1_q17",
            "section": "Section D",
            "type": "subjective",
            "marks": 5,
            "question": "A hemispherical tank is made of an iron sheet 1 cm thick. If the inner radius is 1 m, then find the volume of the iron used to make the tank.",
            "finalAnswer": "0.06348 m³ (approx)",
            "solutionSteps": [
                "Inner radius $r = 1$ m.",
                "Outer radius $R = 1.01$ m.",
                "Volume of iron = $(2/3)\\pi(R^3 - r^3)$.",
                "$= (2/3) \\times (22/7) \\times (1.01^3 - 1^3) = (44/21) \\times (1.030301 - 1) \\approx 0.06348$ m³."
            ]
        },
