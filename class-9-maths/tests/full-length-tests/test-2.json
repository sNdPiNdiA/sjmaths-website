            "type": "mcq",
            "marks": 1,
            "question": "If $x-1$ is a factor of $x^2+x+k$, then k is",
            "options": [
                "1",
                "-1",
                "2",
                "-2"
            ],
            "finalAnswer": "(d) -2",
            "solutionSteps": [
                "$1^2 + 1 + k = 0 \\\\implies 2 + k = 0 \\\\implies k = -2$."
            ]
