    {
      "id": 10,
      "type": "subjective",
      "section": "Section C",
      "marks": 3,
      "question": "Find the coefficient of $x^5$ in the expansion of $(x+3)^8$.",
      "finalAnswer": "1512",
      "solutionSteps": [
        "$T_{r+1} = ^8C_r x^{8-r} 3^r$.",
        "For $x^5$, $8-r=5 \\implies r=3$.",
        "Coeff = $^8C_3 \\cdot 3^3 = 56 \\cdot 27 = 1512$."
      ]
    },
    {
      "id": 11,
      "type": "subjective",
      "section": "Section D",
      "marks": 5,
      "question": "Find the term independent of $x$ in the expansion of $(x - \\frac{1}{x})^{10}$.",
      "finalAnswer": "-252",
      "solutionSteps": [
        "$T_{r+1} = ^{10}C_r (x)^{10-r} (-\\frac{1}{x})^r$.",
        "$= ^{10}C_r (-1)^r x^{10-r-r} = ^{10}C_r (-1)^r x^{10-2r}$.",
        "For independent term, $10-2r=0 \\implies r=5$.",
        "Term = $^{10}C_5 (-1)^5 = 252(-1) = -252$."
      ]
    },
