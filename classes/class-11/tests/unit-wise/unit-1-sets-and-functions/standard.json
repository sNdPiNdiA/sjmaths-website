            "type": "mcq",
            "marks": 1,
            "question": "If $n(A) = 17$, $n(B) = 23$ and $n(A \\cup B) = 38$, then $n(A \\cap B)$ is",
            "options": [
                "2",
                "4",
                "6",
                "8"
            ],
            "finalAnswer": "(a) 2",
            "solutionSteps": [
                "$n(A \\cup B) = n(A) + n(B) - n(A \\cap B)$.",
                "$38 = 17 + 23 - n(A \\cap B)$.",
                "$38 = 40 - n(A \\cap B) \\implies n(A \\cap B) = 2$."
            ]
        },
