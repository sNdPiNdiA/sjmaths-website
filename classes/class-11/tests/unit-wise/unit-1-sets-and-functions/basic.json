        {
            "id": 9,
            "type": "subjective",
            "marks": 3,
            "question": "If $X$ and $Y$ are two sets such that $X \\cup Y$ has 50 elements, $X$ has 28 elements and $Y$ has 32 elements, how many elements does $X \\cap Y$ have?",
            "finalAnswer": "10",
            "solutionSteps": [
                "$n(X \\cup Y) = n(X) + n(Y) - n(X \\cap Y)$.",
                "$50 = 28 + 32 - n(X \\cap Y)$.",
                "$50 = 60 - n(X \\cap Y)$.",
                "$n(X \\cap Y) = 10$."
            ]
        },
