    {
      "id": 11,
      "type": "subjective",
      "section": "Section D",
      "marks": 5,
      "question": "Find the sum to $n$ terms of the sequence $8, 88, 888, 8888, \\dots$",
      "finalAnswer": "$\\frac{80}{81}(10^n - 1) - \\frac{8n}{9}$",
      "solutionSteps": [
        "$S_n = 8(1 + 11 + 111 + \\dots)$.",
        "$= \\frac{8}{9}(9 + 99 + 999 + \\dots)$.",
        "$= \\frac{8}{9}((10-1) + (100-1) + \\dots)$.",
        "$= \\frac{8}{9}[(10+100+\\dots) - (1+1+\\dots)]$.",
        "$= \\frac{8}{9}[\\frac{10(10^n-1)}{10-1} - n]$.",
        "$= \\frac{8}{9}[\\frac{10}{9}(10^n-1) - n]$."
      ]
    },
