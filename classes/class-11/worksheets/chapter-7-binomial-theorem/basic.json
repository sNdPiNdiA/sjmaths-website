[
    {
        "question": "Expand $(x + 2)^3$.",
        "solution": "$x^3 + 3x^2(2) + 3x(2^2) + 2^3 = x^3 + 6x^2 + 12x + 8$."
    },
    {
        "question": "Find the number of terms in the expansion of $(2x + 3y)^8$.",
        "solution": "Number of terms = $n + 1 = 8 + 1 = 9$."
    },
    {
        "question": "What is the general term of $(a+b)^n$?",
        "solution": "$T_{r+1} = ^nC_r a^{n-r} b^r$."
    },
    {
        "question": "Find the coefficient of $x^3$ in $(1+x)^5$.",
        "solution": "$^5C_3 = \\frac{5 \\times 4}{2} = 10$."
    },
    {
        "question": "Evaluate $(98)^2$ using binomial theorem.",
        "solution": "$(100-2)^2 = 10000 - 400 + 4 = 9604$."
    },
    {
        "question": "Expand $(1 - x)^4$.",
        "solution": "$1 - 4x + 6x^2 - 4x^3 + x^4$."
    },
    {
