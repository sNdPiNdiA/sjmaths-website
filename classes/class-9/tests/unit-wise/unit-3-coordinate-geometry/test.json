    "questions": [
        {
            "id": "q1",
            "type": "mcq",
            "marks": 1,
            "question": "The point of intersection of the coordinate axes is called",
            "options": [
                "Abscissa",
                "Ordinate",
                "Origin",
                "Quadrant"
            ],
            "finalAnswer": "(c) Origin",
            "solutionSteps": [
                "The origin is the point (0,0) where x and y axes meet."
            ]
        },
        {
            "id": "q2",
            "type": "mcq",
            "marks": 1,
            "question": "The point (-3, 5) lies in which quadrant?",
            "options": [
                "I",
                "II",
                "III",
                "IV"
            ],
            "finalAnswer": "(b) II",
            "solutionSteps": [
                "x is negative, y is positive.",
                "(-, +) corresponds to Quadrant II."
            ]
        },
        {
            "id": "q3",
            "type": "mcq",
            "marks": 1,
            "question": "The distance of the point (4, 0) from the origin is",
            "options": [
                "4",
                "0",
                "-4",
                "16"
            ],
            "finalAnswer": "(a) 4",
            "solutionSteps": [
                "Distance = $\\sqrt{(4-0)^2 + (0-0)^2} = \\sqrt{16} = 4$."
            ]
        },
        {
            "id": "q4",
            "type": "mcq",
            "marks": 1,
            "question": "The ordinate of the point (-2, -5) is",
            "options": [
                "-2",
                "-5",
                "2",
                "5"
            ],
            "finalAnswer": "(b) -5",
            "solutionSteps": [
                "Abscissa is x-coordinate (-2).",
                "Ordinate is y-coordinate (-5)."
            ]
        },
        {
            "id": "q5",
            "type": "mcq",
            "marks": 1,
            "question": "Which of the following points lies on the x-axis?",
            "options": [
                "(0, 4)",
                "(2, 2)",
                "(5, 0)",
                "(-1, 3)"
            ],
            "finalAnswer": "(c) (5, 0)",
            "solutionSteps": [
                "Points on x-axis have y-coordinate 0."
            ]
        },
        {
            "id": "q6",
            "type": "subjective",
            "marks": 2,
            "question": "Plot the points A(2, 3), B(-2, 3), C(-2, -3) and D(2, -3) on a graph sheet. What figure do they form?",
            "finalAnswer": "Rectangle",
            "solutionSteps": [
                "Plotting the points forms a rectangle.",
                "Length = distance between A and B = 4 units.",
                "Breadth = distance between A and D = 6 units."
            ]
        },
        {
            "id": "q7",
            "type": "subjective",
            "marks": 3,
            "question": "Find the coordinates of the point which lies on y-axis at a distance of 4 units in negative direction of y-axis.",
            "finalAnswer": "(0, -4)",
            "solutionSteps": [
                "Point on y-axis has x-coordinate 0.",
                "Distance 4 in negative direction means y = -4.",
                "Coordinates: (0, -4)."
            ]
        },
        {
            "id": "q8",
            "type": "subjective",
            "marks": 3,
            "question": "If the coordinates of a point are (-2, 5), find its mirror image with respect to x-axis.",
            "finalAnswer": "(-2, -5)",
            "solutionSteps": [
                "Mirror image about x-axis keeps x same and negates y.",
                "x = -2, y becomes -5.",
                "Image: (-2, -5)."
            ]
        }
    ]
}