# .firebaserc

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage

# nyc test coverage
.nyc_output

# Grunt intermediate storage (http://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (http://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# dataconnect generated files
.dataconnect

# Current Affairs temp files
current-affairs/data/raw/*.tmp

# Sarkari Jobs runtime artefacts (downloaded PDFs, extracted text, per-day raw)
sarkari-jobs/pdfs/*
!sarkari-jobs/pdfs/.gitkeep
sarkari-jobs/extracted-text/*
!sarkari-jobs/extracted-text/.gitkeep
sarkari-jobs/scripts/raw/*.json
!sarkari-jobs/scripts/raw/.gitkeep
sarkari-jobs/scripts/parsed/*.json
!sarkari-jobs/scripts/parsed/.gitkeep
sarkari-jobs/scripts/quarantine/*.json
!sarkari-jobs/scripts/quarantine/.gitkeep
sarkari-jobs/scripts/download-report.json
sarkari-jobs/scripts/extract-report.json

