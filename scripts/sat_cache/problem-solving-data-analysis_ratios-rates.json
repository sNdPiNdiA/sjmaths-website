  "concepts": [
    {
      "concept_title": "Concept 1: Unit Rates and Conversions",
      "summary": "A unit rate expresses a quantity as a ratio of one unit of another quantity, essential for scaling and unit conversion.",
      "key_rules": [
        "Rate formula: $R = \\frac{Quantity_1}{Quantity_2}$",
        "Conversion factor: $Value \\times \\frac{TargetUnit}{OriginalUnit} = TargetValue$",
        "Proportionality: If $y = kx$, then $k = \\frac{y}{x}$ is the constant rate."
      ],
      "traditional_method": "Identify the given ratio, set up an equivalent fraction, and solve for the unknown variable using cross-multiplication.",
      "sat_speed_trick": "Use the Desmos calculator to define the conversion factor as a variable 'k' and multiply by the given value.",
      "worked_example": {
        "problem": "A machine produces $120$ widgets in $15$ minutes. How many widgets does it produce in $2$ hours?",
        "traditional_solution": [
          "Step 1: Calculate unit rate per minute: $120 / 15 = 8$ widgets/min",
          "Step 2: Convert hours to minutes: $2 \\times 60 = 120$ minutes",
          "Step 3: Multiply rate by total time: $8 \\times 120 = 960$"
        ],
        "speed_trick": [
          "Step 1: Define $r = 120 / 15$",
          "Step 2: Calculate $r * 120$",
          "Step 3: Result is 960"
        ],
        "answer": "960"
      }
    },
    {
      "concept_title": "Concept 2: Part-to-Part and Part-to-Whole Ratios",
      "summary": "Ratios compare quantities; part-to-part relates two subsets, while part-to-whole relates a subset to the total population.",
      "key_rules": [
        "Part-to-Part: $a:b$",
        "Part-to-Whole: $\\frac{a}{a+b}$",
        "Total sum: $Total = Part_1 + Part_2 + ... + Part_n$"
      ],
      "traditional_method": "Assign a variable 'x' to the common multiplier, express parts as $ax$ and $bx$, and set their sum equal to the total.",
      "sat_speed_trick": "Use the 'Total Parts' method: Add the ratio components, divide the total value by the sum of parts to find the value of one 'part'.",
      "worked_example": {
        "problem": "The ratio of cats to dogs in a shelter is $3:4$. If there are $42$ animals total, how many cats are there?",
        "traditional_solution": [
          "Step 1: Let cats = $3x$ and dogs = $4x$",
          "Step 2: Set up sum equation: $3x + 4x = 42$",
          "Step 3: Solve for x: $7x = 42$",
          "Step 4: $x = 6$",
          "Step 5: Calculate cats: $3 \\times 6 = 18$"
        ],
        "speed_trick": [
          "Step 1: Sum the ratio: $3 + 4 = 7$",
          "Step 2: Divide total by sum: $42 / 7 = 6$",
          "Step 3: Multiply by cat ratio: $6 \\times 3 = 18$"
        ],
        "answer": "18"
      }
    },
    {
      "concept_title": "Concept 3: Speed, Distance, and Time",
      "summary": "The relationship between distance, speed, and time is governed by the formula $d = rt$.",
      "key_rules": [
        "Distance: $d = r \\times t$",
        "Speed: $r = d / t$",
        "Time: $t = d / r$"
      ],
      "traditional_method": "Isolate the unknown variable in the $d = rt$ equation and substitute known values.",
      "sat_speed_trick": "Graph $y = r * x$ in Desmos where $x$ is time and $y$ is distance, then look for the intersection at the given value.",
      "worked_example": {
        "problem": "A car travels $150$ miles at a constant speed of $60$ mph. How long does the trip take in hours?",
        "traditional_solution": [
          "Step 1: Use formula $t = d / r$",
          "Step 2: Substitute values: $t = 150 / 60$",
          "Step 3: Simplify: $t = 2.5$"
        ],
        "speed_trick": [
          "Step 1: Type $y = 60x$ in Desmos",
          "Step 2: Type $y = 150$ in Desmos",
          "Step 3: Click intersection point to find $x = 2.5$"
        ],
        "answer": "2.5"
      }
    },
    {
      "concept_title": "Concept 4: Scaling and Proportional Growth",
      "summary": "When two quantities are proportional, the ratio between them remains constant regardless of the scale.",
      "key_rules": [
        "Proportionality: $\\frac{y_1}{x_1} = \\frac{y_2}{x_2}$",
        "Cross-multiplication: $y_1 x_2 = y_2 x_1$",
        "Inverse proportionality: $y_1 x_1 = y_2 x_2$"
      ],
      "traditional_method": "Set up a proportion equation and solve for the missing term using cross-multiplication.",
      "sat_speed_trick": "Use Desmos to solve the equation $a/b = c/x$ by typing the equation directly and finding the x-intercept of $f(x) = (a/b) - (c/x)$.",
      "worked_example": {
        "problem": "If $5$ apples cost $\\$2.50$, how much do $12$ apples cost?",
        "traditional_solution": [
          "Step 1: Set up proportion: $5 / 2.50 = 12 / x$",
          "Step 2: Cross multiply: $5x = 2.50 \\times 12$",
          "Step 3: Calculate: $5x = 30$",
          "Step 4: $x = 6$"
        ],
        "speed_trick": [
          "Step 1: Type $5/2.5 = 12/x$ in Desmos",
          "Step 2: Observe the vertical line at $x = 6$"
        ],
        "answer": "6"
      }
    }
  ],
