  "concepts": [
    {
      "concept_title": "Concept 1: Percentage Increase and Decrease",
      "summary": "Percentage change represents the relative difference between an initial value and a final value, expressed as a fraction of the initial value.",
      "key_rules": [
        "Percentage Increase: $Final = Initial \\times (1 + r)$",
        "Percentage Decrease: $Final = Initial \\times (1 - r)$",
        "Percentage Change: $\\frac{Final - Initial}{Initial} \\times 100$"
      ],
      "traditional_method": "Identify the initial value and the rate of change. Multiply the initial value by the multiplier (1 +/- r) to find the final value.",
      "sat_speed_trick": "Define the initial value as 100 in Desmos to quickly calculate the final value without complex algebra.",
      "worked_example": {
        "problem": "A price of $80 is increased by 15%. What is the new price?",
        "traditional_solution": [
          "Identify initial value: $80$",
          "Identify rate: $0.15$",
          "Calculate increase: $80 \\times 0.15 = 12$",
          "Calculate final price: $80 + 12 = 92$"
        ],
        "speed_trick": [
          "Type into Desmos: 80 * 1.15",
          "Result: 92"
        ],
        "answer": "92"
      }
    },
    {
      "concept_title": "Concept 2: Successive Percentages",
      "summary": "When percentages are applied sequentially, the second percentage applies to the result of the first, not the original base.",
      "key_rules": [
        "Successive Multiplier: $(1 \\pm r_1) \\times (1 \\pm r_2)$",
        "Total Change: $(Multiplier_{total} - 1) \\times 100$",
        "Order Independence: $(1 + r_1)(1 + r_2) = (1 + r_2)(1 + r_1)$"
      ],
      "traditional_method": "Apply the first percentage to the base, then apply the second percentage to the new intermediate value.",
      "sat_speed_trick": "Use the '100' method: Start with 100, apply the first multiplier, then apply the second multiplier to the result.",
      "worked_example": {
        "problem": "A value increases by 20% then decreases by 10%. What is the net percentage change?",
        "traditional_solution": [
          "Assume initial value: $100$",
          "Apply 20% increase: $100 \\times 1.20 = 120$",
          "Apply 10% decrease to 120: $120 \\times 0.90 = 108$",
          "Calculate net change: $108 - 100 = 8\\%$"
        ],
        "speed_trick": [
          "Type into Desmos: 1.2 * 0.9",
          "Result: 1.08",
          "Interpret: 1.08 - 1 = 0.08 or 8%"
        ],
        "answer": "8% increase"
      }
    },
    {
      "concept_title": "Concept 3: Reverse Percentages",
      "summary": "Finding the original value when the final value and the percentage change are known.",
      "key_rules": [
        "Original Value: $Original = \\frac{Final}{1 \\pm r}$",
        "Common Error: Do not multiply the final value by $(1 \\mp r)$",
        "Verification: $Original \\times (1 \\pm r) = Final$"
      ],
      "traditional_method": "Set up an algebraic equation where x is the original value and solve for x by dividing the final value by the multiplier.",
      "sat_speed_trick": "Define a function $f(x) = x * (1 \\pm r)$ in Desmos and use the slider or intersection to find x when $f(x) = Final$.",
      "worked_example": {
        "problem": "After a 20% discount, a shirt costs $40. What was the original price?",
        "traditional_solution": [
          "Let x be the original price",
          "Equation: $x \\times (1 - 0.20) = 40$",
          "Simplify: $0.8x = 40$",
          "Solve: $x = \\frac{40}{0.8} = 50$"
        ],
        "speed_trick": [
          "Type into Desmos: 40 / 0.8",
          "Result: 50"
        ],
        "answer": "50"
      }
    }
  ],
  "pyq_trends": {
    "frequency": "1-3 questions per test module",
    "historical_pattern": "College Board frequently tests reverse percentages and multi-step percentage changes in word problems involving population growth or price adjustments.",
    "module1_weight": "Medium Frequency (Foundational tests)",
    "module2_weight": "High Frequency (Hard module score differentiator)"
  },
  "formula_sheet": {
    "core_formulas": [
      {
        "name": "Percentage Change",
        "formula": "$\\frac{New - Old}{Old} \\times 100$",
        "description": "Used to find the percent increase or decrease between two values."
      },
      {
        "name": "Multiplier Method",
        "formula": "$Value \\times (1 \\pm r)^t$",
        "description": "Used for repeated percentage changes over time (compound interest/growth)."
      }
    ],
    "sat_traps": [
      {
        "title": "The 'Add/Subtract' Trap",
        "description": "Adding or subtracting percentages directly (e.g., 20% increase then 10% decrease is NOT a 10% increase). Always use multipliers."
      },
      {
        "title": "The 'Reverse' Trap",
        "description": "Applying the percentage change to the final value instead of dividing by the multiplier to find the original."
      }
    ],
    "desmos_shortcuts": [
      {
        "tactic": "The 100-Base Method",
        "syntax": "100 * (1 + r1) * (1 + r2)",
        "tip": "Always use 100 as your starting value to visualize percentage changes as simple numbers."
      }
    ]
  },
